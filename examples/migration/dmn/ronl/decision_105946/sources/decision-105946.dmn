                <uitv:geoVerwijzing>
                    <uitv:locatie identificatie="nl.imow-gm0995.gebiedengroep.180a63f795be43bf8683a480e75deb84"/>
                    <uitv:vraagTekst><![CDATA[Gaat het om een boom of houtopstand binnen de bebouwingscontour houtkap?]]></uitv:vraagTekst>
                </uitv:geoVerwijzing>
                <content:uitvoeringsregelToelichting>
                    <content:belangrijk>false</content:belangrijk>
                </content:uitvoeringsregelToelichting>
