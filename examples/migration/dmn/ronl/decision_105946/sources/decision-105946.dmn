                <sttrbuilder:outcomeInformation>
                    <sttrbuilder:outcomeInformationContent outcomeId="Vergunningplicht">
                        <sttrbuilder:content><![CDATA[Op basis van uw antwoorden valt uw activiteit onder de vergunningsplicht. Dit betekent dat u een omgevingsvergunning dient aan te vragen volgens de geldende regels van de Omgevingswet. Zorg ervoor dat u de aanvraag compleet indient met alle benodigde documenten en tekeningen.]]></sttrbuilder:content>
                    </sttrbuilder:outcomeInformationContent>
                    <sttrbuilder:outcomeInformationContent outcomeId="Toestemmingsvrij">
                        <sttrbuilder:content><![CDATA[Op basis van uw antwoorden is de conclusie dat uw activiteit toestemmingsvrij is. Dit houdt in dat u geen omgevingsvergunning nodig heeft, mits u de voorschriften uit het omgevingsplan naleeft. Bewaar alle relevante documenten, zodat u deze later kunt raadplegen indien nodig, en neem bij vragen gerust contact op met de gemeente Lelystad.]]></sttrbuilder:content>
                    </sttrbuilder:outcomeInformationContent>
                </sttrbuilder:outcomeInformation>
