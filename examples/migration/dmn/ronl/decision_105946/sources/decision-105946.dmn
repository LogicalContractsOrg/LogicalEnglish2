    <dmn:extensionElements>
        <inter:regelgroepen>
            <inter:regelgroep id="_8920b425-97ec-41db-b226-8b9943362c34">
                <inter:naam>Boom kappen of houtopstand vellen_Gemeente Lelystad</inter:naam>
                <inter:prioriteit>1</inter:prioriteit>
            </inter:regelgroep>
        </inter:regelgroepen>
        <uitv:uitvoeringsregels>
            <uitv:uitvoeringsregel id="uitv__4483fe58-57b7-4e71-bf19-15783f0f9d92">
                <uitv:regelgroepRef href="#_8920b425-97ec-41db-b226-8b9943362c34"/>
                <inter:prioriteit>10</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Wilt u een boom of beplanting weghalen?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Met boom of beplanting wordt iedere soort houtopstand bedoeld.]]></content:toelichting>
                    <content:langeToelichting><![CDATA[**Wat is een houtopstand?**  
Een houtopstand is een zelfstandige boom of een groep van bomen, boomvormers, struiken, hakhout of griend.

Een boomvormer is een houtig, opgaand gewas met ontwikkeling van één of meer hoofdtakken. Een boomvormer kan uitgroeien tot een boom, een meerstammige boom of een boomachtige struik.

Een griend is een vochtige akker waarop wilgenhout wordt verbouwd.]]></content:langeToelichting>
                    <content:belangrijk>true</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__864933e7-4ea9-45a2-ae17-d8b1a4df34d7">
                <uitv:regelgroepRef href="#_8920b425-97ec-41db-b226-8b9943362c34"/>
                <inter:prioriteit>20</inter:prioriteit>
                <uitv:vraag>
                    <uitv:gegevensType>boolean</uitv:gegevensType>
                    <uitv:vraagTekst><![CDATA[Gaat het om een aangewezen bijzondere boom of plant?]]></uitv:vraagTekst>
                </uitv:vraag>
                <content:uitvoeringsregelToelichting>
                    <content:toelichting><![CDATA[Op deze kaart staan bomen en planten die door de gemeente aangewezen zijn als bijzonder:

[Bijzondere bomen in Lelystad | Gemeente Lelystad](https://www.lelystad.nl/bijzonderebomen)]]></content:toelichting>
                    <content:belangrijk>true</content:belangrijk>
                </content:uitvoeringsregelToelichting>
            </uitv:uitvoeringsregel>
            <uitv:uitvoeringsregel id="uitv__7b6ed60e-184f-4d93-a186-828dc9182890">
