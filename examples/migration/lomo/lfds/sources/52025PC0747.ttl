<http://example.org/analysis/action/1> a lomo:Action ;
    rdfs:label "Personal data of responsible officers in charge of licenses, self-registration or prior notification"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:deadline ;
            lomo:temporalLabel "24/7"@en ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "Once the IT system is operational"@en ] ;
    lomo:hasAgentRole <http://example.org/analysis/action/1/role/addressee-competent-authorities-commission>,
        <http://example.org/analysis/action/1/role/addresser-competent-authorities-economic-operators> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Personal data of responsible officers in charge of licenses, self-registration or prior notification"@en ;
            lomo:isManifestedIn <http://example.org/dataset/personal-data-of-responsible-officers-in-charge-of-licenses-self-registration-or-prior-notification> ] .

<http://example.org/analysis/action/2> a lomo:Action ;
    rdfs:label "Data relevant for licenses, registrations and prior notifications of operators"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:deadline ;
            lomo:temporalLabel "24/7"@en ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "Request of operator"@en ] ;
    lomo:hasAgentRole <http://example.org/analysis/action/2/role/addressee-competent-authorities-economic-operators>,
        <http://example.org/analysis/action/2/role/addresser-economic-operators> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Data relevant for licenses, registrations and prior notifications of operators"@en ;
            lomo:isManifestedIn <http://example.org/dataset/data-relevant-for-licenses-registrations-and-prior-notifications-of-operators> ] .

<http://example.org/analysis/action/3> a lomo:Action ;
    rdfs:label "Data on suspicious transactions"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:deadline ;
            lomo:temporalLabel "24/7"@en ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "Request of operator"@en ] ;
    lomo:hasAgentRole <http://example.org/analysis/action/3/role/addressee-competent-authorities>,
        <http://example.org/analysis/action/3/role/addresser-economic-operators> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Data on suspicious transactions"@en ;
            lomo:isManifestedIn <http://example.org/dataset/data-on-suspicious-transactions> ] .

<http://example.org/analysis/action/4> a lomo:Action ;
    rdfs:label "Data on seizures"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "Request of operator"@en ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:deadline ;
            lomo:temporalLabel "24/7"@en ] ;
    lomo:hasAgentRole <http://example.org/analysis/action/4/role/addressee-commission-competent-authorities>,
        <http://example.org/analysis/action/4/role/addresser-comptetent-authorities> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Data on seizures"@en ;
            lomo:isManifestedIn <http://example.org/dataset/data-on-seizures> ] .

<http://example.org/analysis/action/5> a lomo:Action ;
    rdfs:label "Data on precursor substances"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:deadline ;
            lomo:temporalLabel "24/7"@en ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "Once uploaded"@en ] ;
    lomo:hasAgentRole <http://example.org/analysis/action/5/role/addressee-competent-authorities-eonomic-operators-general-public-commission>,
        <http://example.org/analysis/action/5/role/addresser-euda> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Data on precursor substances"@en ;
            lomo:isManifestedIn <http://example.org/dataset/data-on-precursor-substances> ] .

<http://example.org/analysis/action/6> a lomo:Action ;
    rdfs:label "Data on drug precursor, quantity and time."@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "Request of competent authorities, Commission"@en ] ;
    lomo:hasAgentRole <http://example.org/analysis/action/6/role/addressee-competent-authorities-customs-commission> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Data on drug precursor, quantity and time."@en ;
            lomo:isManifestedIn <http://example.org/dataset/data-on-drug-precursor-quantity-and-time> ] .

