<http://example.org/analysis/solution/1> a dctype:Software ;
    rdfs:label "Licensing, registration and prior notification platform"@en ;
    lomo:hasCapability "Submission of licence application, registration or prior notification by economic operators, Verification of operators, validity checks of licences, registrations and prior notifications, possibility to grant/revoke/suspend licenses, order operators to suspend or cease an activity covered by prior notifications and registrations, sending ad hoc information requests" ;
    dcterms:publisher <http://example.org/agent/grow> ;
    dcterms:title "Licensing, registration and prior notification platform"@en .

<http://example.org/analysis/solution/2> a dctype:Software ;
    rdfs:label "Interconnection with customs"@en ;
    lomo:hasCapability "Information provision, validity checks for import and export," ;
    dcterms:publisher <http://example.org/agent/taxud> ;
    dcterms:title "Interconnection with customs"@en .

<http://example.org/analysis/solution/3> a dctype:Software ;
    rdfs:label "Drug Precursors Information Repository"@en ;
    lomo:hasCapability "(List of precursor substances to be filled in by EUDA, translation tool for extended scheduling" ;
    dcterms:publisher <http://example.org/agent/euda> ;
    dcterms:title "Drug Precursors Information Repository"@en .

<http://example.org/analysis/solution/4> a dctype:Software ;
    rdfs:label "Interface with INCB"@en ;
    lomo:hasCapability "Drafting and completion of Annual reporting and statistics based on the information in Licensing platform, seizures reported and QM calculator",
        "Opening, reviewing, processing and responding (if necessary) to the pre-export notifications sent by third countries’ authorities to customs authorities",
        "Sending and receiving of pre-export notifications with third countries to/from UN/INCB solution via machine-to-machine interface to be built" ;
    dcterms:publisher <http://example.org/agent/the-concrete-materialisation-of-the-solution-will-be-assessed-during-the-upcoming-business-analysis-taxud-responsibility> ;
    dcterms:title "Interface with INCB"@en .

<http://example.org/analysis/solution/5> a dctype:Software ;
    rdfs:label "Administrative cooperation"@en ;
    lomo:hasCapability "Provide a platform for competent authorities and economic operators to report seizures and suspicious transactions. Request ad hoc information to operators" ;
    dcterms:publisher <http://example.org/agent/grow> ;
    dcterms:title "Administrative cooperation"@en .

