<http://example.org/analysis/action/1> a lomo:Action ;
    rdfs:label "Countries, organisations, budget, participants and priorities per project"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "Regulation (EU, Euratom) [202X-XXXX Performance Regulation]: Article XXX (monitoring) and Article XXX (implementation report and retrospective evaluations).Regular programme reporting"@en ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:deadline ;
            lomo:temporalLabel "Regulation (EU, Euratom) [202X-XXXX Performance Regulation] Article XXX (monitoring) and Article XXX (implementation report and retrospective evaluations)."@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/550/cod/doc/com/COM_2025_550/FINAL/eng/art_202>,
        <https://data.europa.eu/eli/dl/proc/2025/550/cod/doc/com/COM_2025_550/FINAL/eng/chp_2/art_4>,
        <https://data.europa.eu/eli/dl/proc/2025/550/cod/doc/com/COM_2025_550/FINAL/eng/chp_3/art_5>,
        <https://data.europa.eu/eli/dl/proc/2025/550/cod/doc/com/COM_2025_550/FINAL/eng/chp_5/art_10>,
        <https://data.europa.eu/eli/dl/proc/2025/550/cod/doc/com/COM_2025_550/FINAL/eng/chp_6/art_11> ;
    lomo:hasAgentRole <http://example.org/analysis/action/1/role/addressee-general-publiccommissioneuropean-parliamentcouncil-of-the-european-union>,
        <http://example.org/analysis/action/1/role/addresser-beneficiaries-programme-desks> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Countries, organisations, budget, participants and priorities per project"@en ;
            lomo:isManifestedIn <http://example.org/dataset/countries-organisations-budget-participants-and-priorities-per-project> ] .

<http://example.org/dataset/countries-organisations-budget-participants-and-priorities-per-project> a dcat:Dataset ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/550/cod/doc/com/COM_2025_550/FINAL/eng/art_202>,
        <https://data.europa.eu/eli/dl/proc/2025/550/cod/doc/com/COM_2025_550/FINAL/eng/chp_2/art_4>,
        <https://data.europa.eu/eli/dl/proc/2025/550/cod/doc/com/COM_2025_550/FINAL/eng/chp_3/art_5>,
        <https://data.europa.eu/eli/dl/proc/2025/550/cod/doc/com/COM_2025_550/FINAL/eng/chp_5/art_10>,
        <https://data.europa.eu/eli/dl/proc/2025/550/cod/doc/com/COM_2025_550/FINAL/eng/chp_6/art_11> ;
    lomo:manifests [ a lomo:ActionResult ;
            rdfs:label "Countries, organisations, budget, participants and priorities per project"@en ] ;
    dcterms:conformsTo <http://example.org/standard/egrants-and-databases-of-any-implementing-body-in-the-frame-of-the-programme> ;
    dcterms:title "Countries, organisations, budget, participants and priorities per project"@en .

