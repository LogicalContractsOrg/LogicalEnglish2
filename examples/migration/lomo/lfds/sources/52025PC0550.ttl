<http://example.org/analysis/description/5> a lomo:LegalRule ;
    rdfs:label "Chapter III – Article 6(f)"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/550/cod/doc/com/COM_2025_550/FINAL/eng/chp_3/art_6> ;
    lomo:hasCategory dd:Data,
        dd:DigitalSolutions ;
    lomo:involvesProcess <http://example.org/process/evidence-based-policy-making-programme-implementation-and-monitoring-evaluation> ;
