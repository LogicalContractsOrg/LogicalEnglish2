<http://example.org/analysis/description/1> a lomo:LegalRule ;
    rdfs:label "Chapter VI – Article 11"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ;
            lomo:temporalLabel "Regulation (EU, Euratom) [202X-XXXX Performance Regulation] Article XXX (monitoring) and Article XXX (implementation report and retrospective evaluations)."@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/550/cod/doc/com/COM_2025_550/FINAL/eng/chp_6/art_11> ;
    lomo:hasCategory dd:DigitalSolutions ;
    lomo:involvesProcess <http://example.org/process/programme-implementation-through-direct-grant-management> ;
    lomo:produces <http://example.org/analysis/action/1>,
        <http://example.org/analysis/description/1/action> ;
    lomo:references <http://example.org/dataset/countries-organisations-budget-participants-and-priorities-per-project> ;
    dcterms:description "[…] Technical and administrative assistance for the implementation of the Programme"@en .

<http://example.org/analysis/description/2> a lomo:LegalRule ;
    rdfs:label "Chapter V – Article 10"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ;
            lomo:temporalLabel "Regulation (EU, Euratom) [202X-XXXX Performance Regulation] Article XXX (monitoring) and Article XXX (implementation report and retrospective evaluations)."@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/550/cod/doc/com/COM_2025_550/FINAL/eng/chp_5/art_10> ;
    lomo:hasCategory dd:DigitalSolutions ;
    lomo:involvesProcess <http://example.org/process/dissemination> ;
    lomo:produces <http://example.org/analysis/action/1>,
        <http://example.org/analysis/description/2/action> ;
    lomo:references <http://example.org/dataset/countries-organisations-budget-participants-and-priorities-per-project> ;
    dcterms:description "[…] including through Programme Desks, thereby enhancing outreach, visibility and dissemination of the Programme’s results."@en .

<http://example.org/analysis/description/3> a lomo:LegalRule ;
    rdfs:label "Chapter II – Article 4(e)"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ;
            lomo:temporalLabel "Regulation (EU, Euratom) [202X-XXXX Performance Regulation] Article XXX (monitoring) and Article XXX (implementation report and retrospective evaluations)."@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/550/cod/doc/com/COM_2025_550/FINAL/eng/chp_2/art_4> ;
    lomo:hasCategory dd:Data,
        dd:DigitalSolutions ;
    lomo:involvesProcess <http://example.org/process/evidence-based-policy-making-programme-implementation-and-monitoring-evaluation> ;
    lomo:produces <http://example.org/analysis/action/1>,
        <http://example.org/analysis/description/3/action> ;
    lomo:references <http://example.org/dataset/countries-organisations-budget-participants-and-priorities-per-project> ;
    dcterms:description "[…] improving evidence base through enhanced data collection, analysis[…]"@en .

<http://example.org/analysis/description/4> a lomo:LegalRule ;
    rdfs:label "Chapter III – Article 5(f)"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ;
            lomo:temporalLabel "Regulation (EU, Euratom) [202X-XXXX Performance Regulation] Article XXX (monitoring) and Article XXX (implementation report and retrospective evaluations)."@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/550/cod/doc/com/COM_2025_550/FINAL/eng/chp_3/art_5> ;
