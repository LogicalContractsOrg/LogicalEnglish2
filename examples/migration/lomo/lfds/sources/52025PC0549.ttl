<http://example.org/analysis/action/1> a lomo:Action ;
    rdfs:label "Countries, organisations, budget, participants and priorities per project, project results (where applicable per key Action)"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:deadline ;
            lomo:temporalLabel "Performance Regulation Article XX (monitoring) and article XX (implementation report and retrospective evaluations).Annual reporting"@en ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "Performance Regulation Article XX and article XX.(monitoring ) and article XX (implementation report and retrospective evaluations).Expenditure tracking, programme performance reporting and monitoring of implementation and results"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/549/cod/doc/com/COM_2025_549/FINAL/eng/art_13> ;
    lomo:hasAgentRole <http://example.org/analysis/action/1/role/addressee-general-publiccommissioneuropean-parliamentcouncil-of-the-european-union>,
        <http://example.org/analysis/action/1/role/addresser-beneficiaries-programme-desk> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Countries, organisations, budget, participants and priorities per project, project results (where applicable per key Action)"@en ;
            lomo:isManifestedIn <http://example.org/dataset/countries-organisations-budget-participants-and-priorities-per-project-project-results-where-applicable-per-key-action> ] .

