<http://example.org/analysis/description/3> a iopa:BindingRequirement,
        lomo:LegalRule ;
    rdfs:label "Article 7, footnote 45"@en ;
    iopa:affects <http://example.org/analysis/interop/1>,
        <http://example.org/analysis/interop/2>,
        <http://example.org/analysis/interop/3>,
        <http://example.org/analysis/interop/4> ;
    cav:valueDescription "The Programme shall support […] Programme implementation including synergies with, and support to other Union policies and programmes, online platforms, tools for virtual cooperation and tools to facilitate learning mobility (including support to the common framework and tools for the provision of better services for skills and qualifications (Europass))"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ;
            lomo:temporalLabel "Upon users’ needs"@en ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ;
            lomo:temporalLabel "ad-hoc basis (requested at least once a year)"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/549/cod/doc/com/COM_2025_549/FINAL/eng/art_45>,
        <https://data.europa.eu/eli/dl/proc/2025/549/cod/doc/com/COM_2025_549/FINAL/eng/art_7> ;
    lomo:hasCategory dd:Data,
        dd:DigitalSolutions ;
    lomo:involvesProcess <http://example.org/process/programme-support> ;
    lomo:produces <http://example.org/analysis/action/2>,
        <http://example.org/analysis/action/3>,
        <http://example.org/analysis/description/3/action> ;
    lomo:references <http://example.org/dataset/europass-registered-user-profiles-related-to-careers-and-skills-incl-skills-self-assessments-libraries-wallets-digital-credentials-for-learning-learning-opportunities-accreditations-of-educational-institutions> ;
    dcterms:description "The Programme shall support […] Programme implementation including synergies with, and support to other Union policies and programmes, online platforms, tools for virtual cooperation and tools to facilitate learning mobility (including support to the common framework and tools for the provision of better services for skills and qualifications (Europass))"@en ;
    dcterms:relation <http://example.org/ie-solution/eu-digital-identity-walletw3c-verifiable-credential-standard>,
        <http://example.org/ie-solution/euraxess-eures-hr-transformation-program-tools>,
        <http://example.org/ie-solution/eures> .

<http://example.org/analysis/description/3/action> a lomo:Action ;
    lomo:hasAgentRole <http://example.org/analysis/description/3/action/role/addressee-european-commission-national-authorities-national-europass-centres-european-qualifications-framework-national-coordination-points-euroguidance-participants-individuals> .

<http://example.org/analysis/description/3/action/role/addressee-european-commission-national-authorities-national-europass-centres-european-qualifications-framework-national-coordination-points-euroguidance-participants-individuals> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/european-commission-national-authorities-national-europass-centres-european-qualifications-framework-national-coordination-points-euroguidance-participants-individuals> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/analysis/interop/1> a cpsv:PublicService ;
    rdfs:label "Europass registered user profiles, related to careers and skills (incl. skills self-assessments, libraries, wallets, digital credentials for learning…)"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/549/cod/doc/com/COM_2025_549/FINAL/eng/art_35>,
        <https://data.europa.eu/eli/dl/proc/2025/549/cod/doc/com/COM_2025_549/FINAL/eng/art_7> ;
    dcterms:description "Supports users to create a profile based on the European Europass profile format.Helps users identify, document, and present their skills and competences using structured tools, based on the European Classification for Skills and Occupations (ESCO)Offers self-assessment tools for languages and other soft skills."@en ;
    dcterms:identifier "interop/1" ;
    dcterms:references <http://example.org/ie-solution/euraxess-eures-hr-transformation-program-tools> ;
    dcterms:title "Europass registered user profiles, related to careers and skills (incl. skills self-assessments, libraries, wallets, digital credentials for learning…)"@en .

<http://example.org/analysis/interop/2> a cpsv:PublicService ;
    rdfs:label "Job & learning opportunity recommender"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/549/cod/doc/com/COM_2025_549/FINAL/eng/art_35>,
        <https://data.europa.eu/eli/dl/proc/2025/549/cod/doc/com/COM_2025_549/FINAL/eng/art_7> ;
    dcterms:description "Provides access to job and course listings across Europe. Interoperability with EURES platform: Jobs are provided through the EURES platform.Europass profiles can be exported to the EURES platform to be found by EURES advisors and employers."@en ;
    dcterms:identifier "interop/2" ;
    dcterms:references <http://example.org/ie-solution/eures> ;
    dcterms:title "Job & learning opportunity recommender"@en .

<http://example.org/analysis/interop/3> a cpsv:PublicService ;
    rdfs:label "Creation and storage of Digital Credentials for Learning (e.g. Europass mobility certificates)"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/549/cod/doc/com/COM_2025_549/FINAL/eng/art_35>,
        <https://data.europa.eu/eli/dl/proc/2025/549/cod/doc/com/COM_2025_549/FINAL/eng/art_7> ;
    dcterms:description "Enables education and training institutions to issue credentials related to learning in a standardised, trusted format, implementing the European Learning Model (ELM).Receiving and sharing digital credentials in the field of learning that are verifiable and interoperable across countries."@en ;
    dcterms:identifier "interop/3" ;
    dcterms:references <http://example.org/ie-solution/eu-digital-identity-walletw3c-verifiable-credential-standard> ;
    dcterms:title "Creation and storage of Digital Credentials for Learning (e.g. Europass mobility certificates)"@en .

<http://example.org/analysis/interop/4> a cpsv:PublicService ;
    rdfs:label "Transparency of qualifications"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/549/cod/doc/com/COM_2025_549/FINAL/eng/art_35>,
        <https://data.europa.eu/eli/dl/proc/2025/549/cod/doc/com/COM_2025_549/FINAL/eng/art_7> ;
    dcterms:description "Supports transparency of qualifications and skills across EU Member States, EEA countries, candidates countries, potential candidates countriesEases mobility of learners, jobseekers, and volunteers by providing transparent, comparable information."@en ;
    dcterms:identifier "interop/4" ;
    dcterms:title "Transparency of qualifications"@en .

