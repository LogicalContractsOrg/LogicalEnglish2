    lomo:produces <http://example.org/analysis/action/11>,
        <http://example.org/analysis/description/12/action> ;
    lomo:references <http://example.org/dataset/reasoned-decisions> ;
    dcterms:description "Adopt a reasoned decision on selecting the applicants for the right of use of the 2 GHz MSS band for secure MSS systems."@en .

<http://example.org/analysis/description/13> a lomo:LegalRule ;
    rdfs:label "Article 12(1)"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/311/cod/doc/com/COM_2026_311/FINAL/eng/art_12/par_1> ;
    lomo:hasCategory dd:Data ;
