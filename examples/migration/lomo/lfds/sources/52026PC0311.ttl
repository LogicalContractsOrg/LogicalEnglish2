@prefix tf: <http://data.europa.eu/leg/temporal-function/> .

<http://example.org/analysis/action/1> a lomo:Action ;
    rdfs:label "Call for applications, decisions made throughout the phases of the comparative selection procedure and the final selection of applicants in the OJ of the EU"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:deadline ;
            lomo:temporalLabel "Once"@en ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "EU-level comparative selection procedure"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/311/cod/doc/com/COM_2026_311/FINAL/eng/art_4/par_6> ;
    lomo:hasAgentRole <http://example.org/analysis/action/1/role/addressee-applicants>,
        <http://example.org/analysis/action/1/role/addresser-commission> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Call for applications, decisions made throughout the phases of the comparative selection procedure and the final selection of applicants in the OJ of the EU"@en ;
            lomo:isManifestedIn <http://example.org/dataset/call-for-applications-decisions-made-throughout-the-phases-of-the-comparative-selection-procedure-and-the-final-selection-of-applicants-in-the-oj-of-the-eu> ] .

<http://example.org/analysis/action/10> a lomo:Action ;
