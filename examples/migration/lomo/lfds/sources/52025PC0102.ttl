@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix lomo: <http://data.europa.eu/leg/lomo#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix tf: <http://data.europa.eu/leg/temporal-function/> .

<http://example.org/analysis/action/1> a lomo:Action ;
    rdfs:label "List of MS Authorities designated for assessing and confirming Strategic Projects"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "Not defined"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/102/cod/doc/com/COM_2025_102/FINAL/eng/art_6> ;
    lomo:hasAgentRole <http://example.org/analysis/action/1/role/addressee-commission>,
        <http://example.org/analysis/action/1/role/addresser-member-states> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "List of MS Authorities designated for assessing and confirming Strategic Projects"@en ;
            lomo:isManifestedIn <http://example.org/dataset/list-of-ms-authorities-designated-for-assessing-and-confirming-strategic-projects> ] .

<http://example.org/analysis/action/10> a lomo:Action ;
    rdfs:label "Assessment of addressing vulnerability by Strategic Projects"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "If Strategic project addresses an existing vulnerability in the supply chain.No deadline set"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/102/cod/doc/com/COM_2025_102/FINAL/eng/art_16> ;
    lomo:hasAgentRole <http://example.org/analysis/action/10/role/addressee-the-commission>,
        <http://example.org/analysis/action/10/role/addresser-designated-authority> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Assessment of addressing vulnerability by Strategic Projects"@en ;
            lomo:isManifestedIn <http://example.org/dataset/assessment-of-addressing-vulnerability-by-strategic-projects> ] .

<http://example.org/analysis/action/11> a lomo:Action ;
    rdfs:label "National programmes"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "By 6 months after entry into force of this Regulation"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/102/cod/doc/com/COM_2025_102/FINAL/eng/art_19> ;
    lomo:hasAgentRole <http://example.org/analysis/action/11/role/addressee-commission>,
        <http://example.org/analysis/action/11/role/addresser-member-states> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "National programmes"@en ;
            lomo:isManifestedIn <http://example.org/dataset/national-programmes> ] .

<http://example.org/analysis/action/2> a lomo:Action ;
    rdfs:label "Project"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "at the initiative of the project promoter"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/102/cod/doc/com/COM_2025_102/FINAL/eng/art_6> ;
    lomo:hasAgentRole <http://example.org/analysis/action/2/role/addressee-designated-authority>,
        <http://example.org/analysis/action/2/role/addresser-project-promoter> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Project"@en ;
            lomo:isManifestedIn <http://example.org/dataset/project> ] .

<http://example.org/analysis/action/3> a lomo:Action ;
    rdfs:label "Strategic Project"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:deadline ;
            lomo:temporalLabel "No deadline set"@en ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "At Project promoter request"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/102/cod/doc/com/COM_2025_102/FINAL/eng/art_6> ;
    lomo:hasAgentRole <http://example.org/analysis/action/3/role/addressee-project-promoter>,
        <http://example.org/analysis/action/3/role/addresser-designated-authority> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Strategic Project"@en ;
            lomo:isManifestedIn <http://example.org/dataset/strategic-project> ] .

<http://example.org/analysis/action/4> a lomo:Action ;
    rdfs:label "Status of the highest national significance for Strategic Projects"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "No deadline set"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/102/cod/doc/com/COM_2025_102/FINAL/eng/art_9> ;
    lomo:hasAgentRole <http://example.org/analysis/action/4/role/addressee-strategic-project-promoter>,
        <http://example.org/analysis/action/4/role/addresser-national-authorities> ;
