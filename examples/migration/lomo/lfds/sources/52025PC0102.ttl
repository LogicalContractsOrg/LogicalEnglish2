<http://example.org/analysis/action/5> a lomo:Action ;
    rdfs:label "Combined environmental assessment"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "Within 45 days after receiving all necessary information and subject to exceptions"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/102/cod/doc/com/COM_2025_102/FINAL/eng/art_12> ;
    lomo:hasAgentRole <http://example.org/analysis/action/5/role/addressee-strategic-project-promoter>,
        <http://example.org/analysis/action/5/role/addresser-competent-authority> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Combined environmental assessment"@en ;
            lomo:isManifestedIn <http://example.org/dataset/combined-environmental-assessment> ] .

<http://example.org/analysis/action/6> a lomo:Action ;
