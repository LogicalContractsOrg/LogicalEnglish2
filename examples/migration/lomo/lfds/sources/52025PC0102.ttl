    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "At the initiative of the project promoter"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/102/cod/doc/com/COM_2025_102/FINAL/eng/art_16> ;
