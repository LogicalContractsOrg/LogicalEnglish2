<http://example.org/dataset/assessment-whether-strategic-projects-address-a-supply-chain-vulnerability> a dcat:Dataset ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/102/cod/doc/com/COM_2025_102/FINAL/eng/art_16> ;
    dcterms:conformsTo <http://example.org/standard/not-defined> ;
