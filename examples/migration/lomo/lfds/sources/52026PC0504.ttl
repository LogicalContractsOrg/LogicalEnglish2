<http://example.org/analysis/description/1> a lomo:LegalRule ;
    rdfs:label "Article 15"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/504/cod/doc/com/COM_2026_504/FINAL/eng/art_15> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/application> ;
    lomo:produces <http://example.org/analysis/action/1>,
        <http://example.org/analysis/description/1/action> ;
    lomo:references <http://example.org/dataset/data-in-the-context-of-the-application-for-status-of-a-european-semiconductor-technology-initiative> ;
    dcterms:description "Application for the status as European semiconductor technology initiative"@en .

<http://example.org/analysis/description/2> a lomo:LegalRule ;
    rdfs:label "Article 22"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/504/cod/doc/com/COM_2026_504/FINAL/eng/art_22> ;
    lomo:hasCategory dd:Data,
        dd:ProcessAutomation ;
    lomo:involvesProcess <http://example.org/process/permit-granting> ;
    lomo:produces <http://example.org/analysis/action/2>,
        <http://example.org/analysis/description/2/action> ;
    lomo:references <http://example.org/dataset/permit-granting-applications> ;
    dcterms:description "Member States shall establish a single permit-granting procedure based on a single application covering all permits required for European semiconductor technology initiatives and strategic projects"@en .

<http://example.org/analysis/description/3> a lomo:LegalRule ;
    rdfs:label "Article 24"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/504/cod/doc/com/COM_2026_504/FINAL/eng/art_24> ;
    lomo:hasCategory dd:ProcessAutomation ;
    lomo:involvesProcess <http://example.org/process/permit-granting> ;
    lomo:produces <http://example.org/analysis/description/3/action> ;
    dcterms:description "Member States shall set up a single access poirtal at national level, , for the submission of the single permit application for European semiconductor technology facilities and strategic projects"@en .

<http://example.org/analysis/description/4> a lomo:LegalRule ;
