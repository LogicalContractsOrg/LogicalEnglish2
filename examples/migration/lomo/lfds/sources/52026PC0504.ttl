<http://example.org/analysis/solution/1> a dctype:Software ;
    rdfs:label "Digital Permitting System"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/504/cod/doc/com/COM_2026_504/FINAL/eng/art_22> ;
    lomo:hasCapability "Permit-granting procedures are carried out through fully digital means.The system shall provide a single user interface enabling interaction with the relevant public services.The digital permitting system shall enable the paperless submission, tracking, and decision-making of permit applications." ;
    dcterms:publisher <http://example.org/agent/member-statesnational-competent-authorities> ;
    dcterms:title "Digital Permitting System"@en .

<http://example.org/analysis/solution/2> a dctype:Software ;
    rdfs:label "Business-to-Business Semiconductor Supply Chain Platform"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/504/cod/doc/com/COM_2026_504/FINAL/eng/art_34> ;
    lomo:hasCapability "The Platform should gather data from participating undertakings to increase transparency and resilience of the semi–conductor supply chain" ;
    dcterms:publisher <http://example.org/agent/private-operators> ;
    dcterms:title "Business-to-Business Semiconductor Supply Chain Platform"@en .

