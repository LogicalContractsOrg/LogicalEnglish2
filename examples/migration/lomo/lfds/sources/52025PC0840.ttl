@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dctype: <http://purl.org/dc/dcmitype/> .
@prefix dd: <http://data.europa.eu/leg/digital-dimensions/> .
@prefix iopa: <http://data.europa.eu/2qy/iopa#> .
@prefix lomo: <http://data.europa.eu/leg/lomo#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tf: <http://data.europa.eu/leg/temporal-function/> .

<http://example.org/analysis/description/1> a iopa:BindingRequirement,
        lomo:LegalRule ;
    rdfs:label "Article 6"@en ;
    iopa:affects <http://example.org/analysis/interop/1> ;
    cav:valueDescription "Registration information to be made available- in the existing register. PEPP providers have to demonstrate their ability to provide value for money as part of the registration process"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/840/cod/doc/com/COM_2025_840/FINAL/eng/art_6> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/manage-registry>,
        <http://example.org/process/transmission-of-information> ;
    lomo:produces <http://example.org/analysis/action/1>,
        <http://example.org/analysis/action/2>,
        <http://example.org/analysis/description/1/action> ;
    lomo:references <http://example.org/dataset/registration-information-on-capacity-to-provide-value-for-money> ;
    dcterms:description "Registration information to be made available- in the existing register. PEPP providers have to demonstrate their ability to provide value for money as part of the registration process"@en .

<http://example.org/analysis/description/2> a iopa:BindingRequirement,
        lomo:LegalRule ;
    rdfs:label "Article 13"@en ;
    iopa:affects <http://example.org/analysis/interop/1> ;
    cav:valueDescription "The scope of the existing central public register maintained by EIOPA is extended to include historical data on costs, performance, and the summary risk indicator."@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/840/cod/doc/com/COM_2025_840/FINAL/eng/art_13> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/manage-registry>,
        <http://example.org/process/monitor>,
        <http://example.org/process/publish>,
        <http://example.org/process/transmission-of-information> ;
    lomo:produces <http://example.org/analysis/action/3>,
        <http://example.org/analysis/action/4>,
        <http://example.org/analysis/description/2/action> ;
    lomo:references <http://example.org/dataset/registration-of-data-on-cost-performance-risk-indicators> ;
    dcterms:description "The scope of the existing central public register maintained by EIOPA is extended to include historical data on costs, performance, and the summary risk indicator."@en .

<http://example.org/analysis/description/3> a iopa:BindingRequirement,
        lomo:LegalRule ;
    rdfs:label "Article 51a"@en ;
    iopa:affects <http://example.org/analysis/interop/2> ;
    cav:valueDescription "PEPP providers and distributors could transmit to pension tracking systems, in a standardised and interoperable format, all information necessary to provide customers with a comprehensive, reliable and up-to-date overview of their entitlements."@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/840/cod/doc/com/COM_2025_840/FINAL/eng/art_51> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/transmission-of-information> ;
    lomo:produces <http://example.org/analysis/action/5>,
        <http://example.org/analysis/description/3/action> ;
    lomo:references <http://example.org/dataset/up-to-date-information-on-savers-entitlements-to-be-made-available-in-the-pension-tracking-system-where-this-exists> ;
    dcterms:description "PEPP providers and distributors could transmit to pension tracking systems, in a standardised and interoperable format, all information necessary to provide customers with a comprehensive, reliable and up-to-date overview of their entitlements."@en .

<http://example.org/analysis/description/4> a iopa:BindingRequirement,
        lomo:LegalRule ;
    rdfs:label "Article 65"@en ;
    iopa:affects <http://example.org/analysis/interop/3> ;
    cav:valueDescription "EIOPA can, under certain conditions, set up collaborative platforms to strengthen the exchange of information and to enhance collaboration between the relevant competent authorities – similar to the collaborative platform set-up in the Directive (EU) 2016/2341"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/840/cod/doc/com/COM_2025_840/FINAL/eng/art_65> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/establish-a-digital-public-service>,
        <http://example.org/process/monitor> ;
    lomo:produces <http://example.org/analysis/action/6>,
        <http://example.org/analysis/description/4/action> ;
    lomo:references <http://example.org/dataset/exchange-of-relevant-supervisory-information-between-authorities> ;
    dcterms:description "EIOPA can, under certain conditions, set up collaborative platforms to strengthen the exchange of information and to enhance collaboration between the relevant competent authorities – similar to the collaborative platform set-up in the Directive (EU) 2016/2341"@en .

<http://example.org/analysis/solution/1> a dctype:Software ;
    rdfs:label "Central public registry"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/840/cod/doc/com/COM_2025_840/FINAL/eng/art_13>,
        <https://data.europa.eu/eli/dl/proc/2025/840/cod/doc/com/COM_2025_840/FINAL/eng/art_6> ;
    lomo:hasCapability "Registration data, cost, performance, risk indicators to be incorporated in the Central public register maintained by EIOPA – already existing" ;
    dcterms:publisher <http://example.org/agent/eiopa> ;
    dcterms:title "Central public registry"@en .

<http://example.org/analysis/solution/2> a dctype:Software ;
    rdfs:label "Updating of existing pension tracking system"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/840/cod/doc/com/COM_2025_840/FINAL/eng/art_51> ;
    lomo:hasCapability "PEPP providers and distributors could transmit to pension tracking systems, in a standardised and interoperable format, all information necessary to provide customers with a comprehensive, reliable and up-to-date overview of their entitlements." ;
    dcterms:publisher <http://example.org/agent/ncas> ;
    dcterms:title "Updating of existing pension tracking system"@en .

<http://example.org/analysis/solution/3> a dctype:Software ;
    rdfs:label "Collaborative platforms"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/840/cod/doc/com/COM_2025_840/FINAL/eng/art_65> ;
    lomo:hasCapability "EIOPA can, under certain conditions, set up collaborative platforms to strengthen the exchange of information and to enhance collaboration between the relevant competent authorities – similar to the collaborative platform set-up in the Directive (EU) 2016/2341" ;
    dcterms:publisher <http://example.org/agent/eiopa> ;
    dcterms:title "Collaborative platforms"@en .

