<http://example.org/analysis/action/1> a lomo:Action ;
    rdfs:label "Registration information"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "Request for registration"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/840/cod/doc/com/COM_2025_840/FINAL/eng/art_6> ;
    lomo:hasAgentRole <http://example.org/analysis/action/1/role/addressee-nca>,
        <http://example.org/analysis/action/1/role/addresser-pepp-provider> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Registration information"@en ;
            lomo:isManifestedIn <http://example.org/dataset/registration-information> ] .

<http://example.org/analysis/action/1/role/addressee-nca> a lomo:AgentRole ;
