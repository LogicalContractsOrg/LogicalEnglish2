<http://example.org/analysis/interop/2> a cpsv:PublicService ;
    rdfs:label "EuroCloud Federation"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/502/cod/doc/com/COM_2026_502/FINAL/eng/art_34>,
        <https://data.europa.eu/eli/dl/proc/2026/502/cod/doc/com/COM_2026_502/FINAL/eng/tit_4> ;
    dcterms:description "Article 34 establishes the European public sector cloud federation (EuroCloud Federation). The EuroCloud Federation should bring together national cloud initiatives providing highly trusted and secure public sector cloud capabilities and facilitate the sharing of such capabilities between Union entities and public sector bodies. This should be done via a platform accessible to all Federation Members – the EuroCloud Platform."@en ;
    dcterms:identifier "interop/2" ;
    dcterms:title "EuroCloud Federation"@en .

<http://example.org/analysis/interop/1> a cpsv:PublicService ;
    rdfs:label "Union repository of recognised sovereign services"@en ;
