<http://example.org/analysis/description/1> a lomo:LegalRule ;
    rdfs:label "TITLE II RESEARCH, DEVELOPMENT AND DEPLOYMENT ACTIVITIES FOR THE CLOUD AND AI ECOSYSTEM"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ;
            lomo:temporalLabel "Per adoption/ revision"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/502/cod/doc/com/COM_2026_502/FINAL/eng/tit_2> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/notification> ;
    lomo:produces <http://example.org/analysis/action/1>,
        <http://example.org/analysis/description/1/action> ;
    lomo:references <http://example.org/dataset/member-state-national-strategies> ;
    dcterms:description "Member States shallnotify the Commission of their national strategies."@en .

<http://example.org/analysis/description/10> a lomo:LegalRule ;
    rdfs:label "TITLE IVAUTONOMY"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/502/cod/doc/com/COM_2026_502/FINAL/eng/tit_4> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/notification> ;
    lomo:produces <http://example.org/analysis/description/10/action> ;
    dcterms:description "Member States shall notify, as soon as possible, notify to the Commission the rules on penalties and compensation and any subsequent amendment affecting them."@en .

<http://example.org/analysis/description/11> a lomo:LegalRule ;
    rdfs:label "TITLE IVAUTONOMY"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/502/cod/doc/com/COM_2026_502/FINAL/eng/tit_4> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/designation-of-competent-authorities> ;
    lomo:produces <http://example.org/analysis/description/11/action> ;
    dcterms:description "Each Member States shalldesignate one or more national competent authorities. Members States shallnotify the list of authoritiesto the Commission. The Commission shallmaintain a publicregisterof the authorities."@en .

<http://example.org/analysis/description/12> a lomo:LegalRule ;
    rdfs:label "TITLE IVAUTONOMY"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/502/cod/doc/com/COM_2026_502/FINAL/eng/tit_4> ;
