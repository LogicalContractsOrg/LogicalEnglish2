    lomo:involvesProcess <http://example.org/process/management-of-eprel-for-compliance> ;
    lomo:produces <http://example.org/analysis/description/2/action> ;
    dcterms:description "Authorised representatives to upload voluntarily into the compliance part of EPREL a copy of the mandate of the manufacturer."@en .

<http://example.org/analysis/description/3> a lomo:LegalRule ;
    rdfs:label "Art 3 [Art 5 (1) of Regulation 2017/1369]"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/565/cod/doc/com/COM_2026_565/FINAL/eng/art_3/par_1> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/DigitalPublicService>,
        <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> ;
    lomo:involvesProcess <http://example.org/process/download-and-print-label-if-specified-in-product-specific-act> ;
    lomo:produces <http://example.org/analysis/description/3/action> ;
    dcterms:description "Download and print from EPREL database the energy label for the correct model and with right colour scheme and size."@en .

<http://example.org/analysis/description/4> a lomo:LegalRule ;
    rdfs:label "Art 3 [Art 5 (2) of Regulation 2017/1369]"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/565/cod/doc/com/COM_2026_565/FINAL/eng/art_3/par_2> ;
    lomo:involvesProcess <http://example.org/process/display-label> ;
    lomo:produces <http://example.org/analysis/description/4/action> ;
    dcterms:description "Retailers can use electronic displays for label display"@en .

<http://example.org/analysis/description/5> a lomo:LegalRule ;
    rdfs:label "Art 3 [Annex I of Regulation (EU) 2017/1369]"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/565/cod/doc/com/COM_2026_565/FINAL/eng/anx_1/art_3> ;
    lomo:involvesProcess <http://example.org/process/management-of-eprel-for-compliance> ;
    lomo:produces <http://example.org/analysis/description/5/action> ;
    dcterms:description "Suppliers to upload into the compliance part of the EPREL database the testing reports (or summary if reports contain sensitive info) on a voluntary basis"@en .

<http://example.org/analysis/description/6> a lomo:LegalRule ;
    rdfs:label "Art 3 [Art5 (3) of Regulation 2017/1369]"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/565/cod/doc/com/COM_2026_565/FINAL/eng/art_3/par_3> ;
    lomo:involvesProcess <http://example.org/process/management-of-registry-for-compliance> ;
    lomo:produces <http://example.org/analysis/description/6/action> ;
    dcterms:description "Providers of online marketplaces to verify registration of a product/supplier in EPREL before offering product for sale"@en .

<http://example.org/analysis/description/7> a lomo:LegalRule ;
    rdfs:label "Art 3 [Art 7 (2) of Regulation 2017/1369]"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/565/cod/doc/com/COM_2026_565/FINAL/eng/art_3/par_2> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data>,
        <http://data.europa.eu/leg/digital-dimensions/DigitalPublicService> ;
    lomo:involvesProcess <http://example.org/process/digitalisation-of-procurement> ;
    lomo:produces <http://example.org/analysis/description/7/action> ;
    dcterms:description "Obligation on MS to accept the information contained in EPREL for the purposes of financial schemes"@en .

<http://example.org/analysis/description/8> a lomo:LegalRule ;
    rdfs:label "Art 4 [Annex III of Regulation 2020/740]"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/565/cod/doc/com/COM_2026_565/FINAL/eng/anx_3/art_4> ;
    lomo:involvesProcess <http://example.org/process/management-of-registry> ;
    lomo:produces <http://example.org/analysis/description/8/action> ;
    dcterms:description "information on tyre characteristics to be entered into EPREL database (public part)"@en .

<http://example.org/analysis/description/9> a lomo:LegalRule ;
    rdfs:label "Art 4 [Annex IV of Regulation 2020/740]"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/565/cod/doc/com/COM_2026_565/FINAL/eng/anx_4/art_4> ;
    lomo:involvesProcess <http://example.org/process/display> ;
    lomo:produces <http://example.org/analysis/description/9/action> ;
    dcterms:description "information to be provided in visual advertisement including access/link to EPREL"@en .

