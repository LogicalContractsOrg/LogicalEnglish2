@prefix tf: <http://data.europa.eu/leg/temporal-function/> .

<http://example.org/analysis/action/1> a lomo:Action ;
    rdfs:label "Testing reports for all suppliers and copy of the mandate for and for authorised representatives the mandate"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "upon entry into force of revised rules for existing entries and when putting a product model on the EU market"@en ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:deadline ;
            lomo:temporalLabel "once"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/565/cod/doc/com/COM_2026_565/FINAL/eng/anx_1/art_2/par_8> ;
    lomo:hasAgentRole <http://example.org/analysis/action/1/role/addressee-national-market-surveillance-authorities-via-ec-run-eprel-database-compliance-part>,
        <http://example.org/analysis/action/1/role/addresser-supplier-of-energy-related-product-with-label-and-authorised-representatives-of-3rd-country-manufacturers-of-energy-related-products> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Testing reports for all suppliers and copy of the mandate for and for authorised representatives the mandate"@en ;
            lomo:isManifestedIn <http://example.org/dataset/testing-reports-for-all-suppliers-and-copy-of-the-mandate-for-and-for-authorised-representatives-the-mandate> ] .

<http://example.org/analysis/action/2> a lomo:Action ;
    rdfs:label "Testing reports for tyre suppliers"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:deadline ;
            lomo:temporalLabel "once"@en ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "upon entry into force of revised rules for existing entries and when putting a product model on the EU market"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/565/cod/doc/com/COM_2026_565/FINAL/eng/anx_7/art_3> ;
    lomo:hasAgentRole <http://example.org/analysis/action/2/role/addressee-national-market-surveillance-authorities-via-ec-run-eprel-database-compliance-part>,
        <http://example.org/analysis/action/2/role/addresser-tyre-suppliers> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Testing reports for tyre suppliers"@en ;
            lomo:isManifestedIn <http://example.org/dataset/testing-reports-for-tyre-suppliers> ] .

<http://example.org/analysis/action/3> a lomo:Action ;
    rdfs:label "Additional product specifications for tyres"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:deadline ;
            lomo:temporalLabel "once"@en ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "upon entry into force of revised rules for existing entries and when putting a product model on the EU market"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/565/cod/doc/com/COM_2026_565/FINAL/eng/art_2020>,
        <https://data.europa.eu/eli/dl/proc/2026/565/cod/doc/com/COM_2026_565/FINAL/eng/art_3> ;
    lomo:hasAgentRole <http://example.org/analysis/action/3/role/addressee-european-commission>,
        <http://example.org/analysis/action/3/role/addresser-tyre-supplier> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Additional product specifications for tyres"@en ;
            lomo:isManifestedIn <http://example.org/dataset/additional-product-specifications-for-tyres> ] .

<http://example.org/analysis/description/1> a lomo:LegalRule ;
    rdfs:label "Art 2 [Art 3(1) Article 4 and Art 11(13) of Regulation 2017/1369]"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/565/cod/doc/com/COM_2026_565/FINAL/eng/art_2/par_1> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data>,
        <http://data.europa.eu/leg/digital-dimensions/DigitalPublicService> ;
    lomo:involvesProcess <http://example.org/process/management-of-eprel-for-compliance> ;
    lomo:produces <http://example.org/analysis/description/1/action> ;
    dcterms:description "Provide EPREL registration number and/or link to EPREL"@en .

<http://example.org/analysis/description/10> a lomo:LegalRule ;
    rdfs:label "Art 4 [Annex VII of Regulation 2020/740]"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/565/cod/doc/com/COM_2026_565/FINAL/eng/anx_7/art_4> ;
    lomo:involvesProcess <http://example.org/process/data> ;
    lomo:produces <http://example.org/analysis/description/10/action> ;
    dcterms:description "information, including test reports, to be provided in the compliance part of EPREL"@en .

<http://example.org/analysis/description/2> a lomo:LegalRule ;
    rdfs:label "Art 3 [Art 4 (8) of Regulation 2017/1369]"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/565/cod/doc/com/COM_2026_565/FINAL/eng/art_3/par_8> ;
