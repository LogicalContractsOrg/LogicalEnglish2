<http://example.org/analysis/action/1> a lomo:Action ;
    rdfs:label "Commercial catches"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "Calendar year"@en ],
        [ a lomo:TemporalSpecification ;
            lomo:frequency "P1Y"^^xsd:duration ;
            lomo:hasFunction tf:deadline ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/435/cod/doc/com/COM_2025_435/FINAL/eng/art_1> ;
    lomo:hasAgentRole <http://example.org/analysis/action/1/role/addressee-commission-eurostat>,
        <http://example.org/analysis/action/1/role/addresser-member-states> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Commercial catches"@en ;
            lomo:isManifestedIn <http://example.org/dataset/commercial-catches> ] .

