    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data>,
        <http://data.europa.eu/leg/digital-dimensions/DigitalPublicService> ;
    lomo:involvesProcess <http://example.org/process/data-collection-data-transmission> ;
    lomo:produces <http://example.org/analysis/description/1/action> ;
    lomo:references <http://example.org/dataset/aquaculture-statistics-aquaculture-production-excluding-hatcheries-and-nurseries-flows-in-aquaculture-and-aquaculture-establishments>,
        <http://example.org/dataset/fisheries-statistics-catches-landings-and-catching-fleet>,
        <http://example.org/dataset/metadata> ;
    dcterms:description "Data requirements"@en ;
    dcterms:relation <http://example.org/ie-solution/eurostat-public-dissemination-database-eurobasedatabase---eurostat> .

