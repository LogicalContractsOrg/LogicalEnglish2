    dcterms:title "Operational data for resources/modules/capacities (including rescEU and ECPP)Composition details, availability, stockpiles, deployment history"@en .

<http://example.org/dataset/personal-data-of-expertscontact-details-expertisetrainings-languages-vaccinations-eucpt-categoryskillsroles> a dcat:Dataset ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/548/cod/doc/com/COM_2025_548/FINAL/eng/art_20>,
        <https://data.europa.eu/eli/dl/proc/2025/548/cod/doc/com/COM_2025_548/FINAL/eng/art_38> ;
