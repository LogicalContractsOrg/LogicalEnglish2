    dcterms:title "Personal data of Experts:Contact details, expertise/trainings, languages, vaccinations, EUCPT category/skills/roles"@en .

<http://example.org/dataset/user-managementuser-roles-and-privileges-data-about-roles-and-associated-privileges-which-define-access-and-operational-control-in-the-system> a dcat:Dataset ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/548/cod/doc/com/COM_2025_548/FINAL/eng/art_36> ;
    dcterms:title "User management:User roles and privileges, data about roles and associated privileges which define access and operational control in the system."@en .

