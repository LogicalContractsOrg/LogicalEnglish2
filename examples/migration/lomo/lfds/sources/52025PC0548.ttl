        <https://data.europa.eu/eli/dl/proc/2025/548/cod/doc/com/COM_2025_548/FINAL/eng/sec_4/anx_1/art_20> ;
    dcterms:conformsTo <http://example.org/standard/stesta-connection-accessible-as-read-only-on-regular-internet-for-authorised-users> ;
    dcterms:title "Emergency details:Affected regions, types of hazard, synopsis, activation level, requested assistance details, offered assistance details, logbook messages and notifications, operational maps, documents…"@en .

