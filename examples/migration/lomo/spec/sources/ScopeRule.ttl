ex:Rule_eIDAS_Art2_1_Scope a lomo:ScopeRule ;
    rdfs:label "Regulation (EU) No 910/2014 (eIDAS) Article 2(1): Scope"@en ;
    lomo:legalText "This Regulation applies to electronic identification schemes that have been notified by a Member State, and to trust service providers that are established in the Union."@en ;
    lomo:establishedIn <http://data.europa.eu/eli/reg/2014/910/art_2/par_1> .