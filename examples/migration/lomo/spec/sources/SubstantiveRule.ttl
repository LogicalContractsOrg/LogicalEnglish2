ex:Rule_Dir2013_34_Art30_Publication a lomo:SubstantiveRule ;
    rdfs:label "Directive 2013/34/EU Article 30: Publication of financial statements"@en ;
    lomo:hasDeonticModality <http://data.europa.eu/leg/deontic-modality/Obligation> ;
    lomo:hasRequirementType <http://publications.europa.eu/resource/dataset/administrative-obligation/c_80214a02> ;
    lomo:legalText "Member States shall ensure that undertakings publish, within a period not exceeding 12 months after the balance sheet date, the duly approved annual financial statements and the management report."@en ;
    lomo:produces ex:Action_PublishFinancialStatements ;
    lomo:establishedIn <http://data.europa.eu/eli/dir/2013/34/oj/art_30/par_1> .