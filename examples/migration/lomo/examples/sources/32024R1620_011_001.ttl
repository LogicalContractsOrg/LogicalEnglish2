    lomo:hasResult example:REG20241620ART11PAR1_ActionResult4 ;
    lomo:legalText "shall analyse the collected information"@en .

example:REG20241620ART11PAR1_Action5
    a lomo:Action ;
    lomo:hasAgentRole example:REG20241620ART11PAR1_AgentRole9,
                  example:REG20241620ART11PAR1_AgentRole10,
