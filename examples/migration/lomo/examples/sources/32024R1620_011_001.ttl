# Legal Rule
example:REG20241620ART11PAR1
    a lomo:PrescriptiveRule ;
    rdfs:label "Establishment of a central database of information"@en ;
    lomo:hasDeonticModality <http://data.europa.eu/leg/deontic-modality/Obligation> ;
    lomo:hasRequirementType <http://publications.europa.eu/resource/dataset/administrative-obligation/c_80214a02> ;
    lomo:establishedIn <http://data.europa.eu/eli/reg/2024/1620/art_11/par_1/2025-11-10> ;
    lomo:produces
        example:REG20241620ART11PAR1_Action1,
        example:REG20241620ART11PAR1_Action2,
        example:REG20241620ART11PAR1_Action3,
        example:REG20241620ART11PAR1_Action4,
        example:REG20241620ART11PAR1_Action5 ;
    lomo:legalText
        "The Authority shall establish and keep up to date a central database of information pursuant to this Article. The Authority shall make the information available to supervisory authorities, non-AML/CFT authorities, other national authorities and competent bodies, and to the European Supervisory Authorities, on a need-to-know and confidential basis. The Authority shall also analyse the collected information and may share the results of its analysis."@en .

