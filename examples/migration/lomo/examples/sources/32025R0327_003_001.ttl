# Article 3 - Right of natural persons to access their personal electronic health data
# 1. Natural persons shall have the right to access at least personal electronic health data relating to them that belong to the priority categories referred to in Article 14 and are processed for the provision of healthcare through the electronic health data access services referred to in Article 4. Access shall be provided immediately after the personal electronic health data have been registered in an EHR system, while respecting the need for technological practicability, and shall be provided free of charge and in an easily readable, consolidated and accessible format.
#
# Note: In this Turtle file, the addresser of the provision is not explicitly defined. For modelling purposes, an EHR system has been assumed, but further legal and contextual interpretation is required to clarify the correct addresser.

@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix oa: <http://www.w3.org/ns/oa#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix example: <https://system.org/example#> .
@prefix lomo: <http://data.europa.eu/leg/lomo#> .

# Agent Role instances
example:REG2025327OJART3PAR1_AgentRole1
    a lomo:AgentRole ;
    lomo:forAgent example:NaturalPersons ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

example:REG2025327OJART3PAR1_AgentRole2
    a lomo:AgentRole ;
    lomo:forAgent example:EHRSystem ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSER> .

example:REG2025327OJART3PAR1_AgentRole3
    a lomo:AgentRole ;
    lomo:forAgent example:NaturalPersons ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

example:REG2025327OJART3PAR1_AgentRole4
    a lomo:AgentRole ;
    lomo:forAgent example:EHRSystem ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSER> .

# Legal Rule
example:REG2025327OJART3PAR1
    a lomo:PrescriptiveRule ;
    rdfs:label "Regulation 2025/327, Article 3(1)"@en ;
    lomo:hasDeonticModality <http://data.europa.eu/leg/deontic-modality/Right> ;
    lomo:hasRequirementType <http://publications.europa.eu/resource/dataset/administrative-obligation/c_80214a02> ;
    lomo:establishedIn <http://data.europa.eu/eli/reg/2025/327/art_3/par_1/oj> ;
    lomo:produces example:REG2025327OJART3PAR1_Action1,
                  example:REG2025327OJART3PAR1_Action2 ;
    lomo:legalText "Natural persons shall have the right to access at least personal electronic health data relating to them that belong to the priority categories referred to in Article 14 and are processed for the provision of healthcare through the electronic health data access services referred to in Article 4. Access shall be provided immediately after the personal electronic health data have been registered in an EHR system, while respecting the need for technological practicability, and shall be provided free of charge and in an easily readable, consolidated and accessible format."@en .

# Actions
example:REG2025327OJART3PAR1_Action1
    a lomo:Action ;
    lomo:hasAgentRole example:REG2025327OJART3PAR1_AgentRole1,
                  example:REG2025327OJART3PAR1_AgentRole2 ;
    lomo:hasNext example:REG2025327OJART3PAR1_Action2 ;
    lomo:hasResult example:REG2025327OJART3PAR1_ActionResult1 ;
    lomo:legalText "shall have the right to access"@en .

example:REG2025327OJART3PAR1_Action2
    a lomo:Action ;
    lomo:hasAgentRole example:REG2025327OJART3PAR1_AgentRole3,
                  example:REG2025327OJART3PAR1_AgentRole4 ;
    lomo:hasResult example:REG2025327OJART3PAR1_ActionResult2 ;
    lomo:legalText "Access shall be provided free of charge and in an easily readable, consolidated and accessible format"@en .

# Action Results
example:REG2025327OJART3PAR1_ActionResult1
    a lomo:ActionResult ;
    rdfs:label "Access to personal electronic health data relating to the data subject in the"@en ;
    lomo:legalText "Access to personal electronic health data relating to the data subject in the priority categories of Article 14, processed for healthcare provision, via the electronic health data access services of Article 4."@en .

example:REG2025327OJART3PAR1_ActionResult2
    a lomo:ActionResult ;
    rdfs:label "Access"@en ;
    lomo:legalText "Access"@en .
