    dcterms:description "Central online portal providing access to environmental single points of contact, procedure information, and assessment data."@en ;
    lomo:hasCapability "Centralised information access" , "Digital publication of assessment data" , "SPOC locator functionality" ;
    dcterms:publisher :Agent_MemberState ;
    rdfs:comment "Online portal for environmental assessments with centralised information access and digital publication capabilities."@en .

:DigitalSolution_ElectronicSubmission rdf:type owl:NamedIndividual , dcterms:Software ;
    dcterms:title "Electronic Submission Channel"@en ;
    dcterms:description "System for accepting electronic submissions of environmental assessment information from developers."@en ;
    lomo:hasCapability "Electronic document intake" , "Digital form processing" ;
    dcterms:publisher :Agent_MemberState ;
    rdfs:comment "Electronic submission channel for developers to submit any information related to environmental assessments in electronic form."@en .

:DigitalSolution_DigitalProcedures rdf:type owl:NamedIndividual , dcterms:Software ;
    dcterms:title "Digital Environmental Assessment Procedures"@en ;
    dcterms:description "Fully digitalized systems for environmental assessment procedures with cross-border capabilities."@en ;
    lomo:hasCapability "Full procedure digitalization" , "Cross-border interoperability" , "Automated processing with safeguards" ;
    dcterms:publisher :Agent_MemberState ;
    rdfs:comment "Fully digitalized environmental assessment procedures with cross-border data exchange capabilities and automated systems."@en .

