@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix cpsv: <http://purl.org/vocab/cpsv#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix cav: <http://data.europa.eu/2sa/cav#> .
@prefix lfds: <http://data.europa.eu/2qy/lfds#> .

@base <http://data.europa.eu/leg/lomo/test> .

<http://data.europa.eu/leg/lomo/test> rdf:type owl:Ontology ;
    dcterms:title "Proposal for a REGULATION OF THE EUROPEAN PARLIAMENT AND OF THE COUNCIL on speeding-up environmental assessments"@en ;
    dcterms:description "Regulation to streamline and accelerate environmental assessment procedures while maintaining environmental protection standards"@en ;
    dcterms:created "2026-02-17"^^xsd:date ;
    dcterms:modified "2026-02-17"^^xsd:date ;
    owl:imports <http://data.europa.eu/leg/lomo> .

#################################################################
#    AGENTS (from Articles 3, 10, 12)
#################################################################

:Agent_MemberState rdf:type owl:NamedIndividual , lomo:Agent ;
    rdfs:label "Member State"@en .

:Agent_Developers rdf:type owl:NamedIndividual , lomo:Agent ;
    rdfs:label "Developers"@en .

:Agent_CompetentAuthority rdf:type owl:NamedIndividual , lomo:Agent ;
    rdfs:label "Competent Authority"@en .

:Agent_Public rdf:type owl:NamedIndividual , lomo:Agent ;
    rdfs:label "Public"@en .

:Agent_Commission rdf:type owl:NamedIndividual , lomo:Agent ;
    rdfs:label "European Commission"@en .

#################################################################
#    AGENT TYPES
#################################################################

:AgentType_MemberState rdf:type owl:NamedIndividual , lomo:AgentType ;
    rdfs:label "Member State"@en .

:AgentType_Developers rdf:type owl:NamedIndividual , lomo:AgentType ;
    rdfs:label "Developers"@en .

:AgentType_CompetentAuthority rdf:type owl:NamedIndividual , lomo:AgentType ;
    rdfs:label "Competent Authority"@en .

#################################################################
#    AGENT ROLES
#################################################################

:AgentRole_MemberState_Provider rdf:type owl:NamedIndividual , lomo:AgentRole ;
    rdfs:label "Member State as Information Provider"@en ;
    lomo:forAgent :Agent_MemberState ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSER> .

:AgentRole_Developers_Submitter rdf:type owl:NamedIndividual , lomo:AgentRole ;
    rdfs:label "Developers as Electronic Submitter"@en ;
    lomo:forAgent :Agent_Developers ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSER> .

:AgentRole_CompetentAuthority_Processor rdf:type owl:NamedIndividual , lomo:AgentRole ;
    rdfs:label "Competent Authority as Processor"@en ;
    lomo:forAgent :Agent_CompetentAuthority ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

:AgentRole_Public_Recipient rdf:type owl:NamedIndividual , lomo:AgentRole ;
    rdfs:label "Public as Information Recipient"@en ;
    lomo:forAgent :Agent_Public ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

:AgentRole_MemberState_Publisher rdf:type owl:NamedIndividual , lomo:AgentRole ;
    rdfs:label "Member State as Data Publisher"@en ;
    lomo:forAgent :Agent_MemberState ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSER> .

:AgentRole_MemberState_CrossBorderEnabler rdf:type owl:NamedIndividual , lomo:AgentRole ;
    rdfs:label "Member State as Cross-Border Exchange Enabler"@en ;
    lomo:forAgent :Agent_MemberState ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSER> .

:AgentRole_CompetentAuthority_DigitalManager rdf:type owl:NamedIndividual , lomo:AgentRole ;
    rdfs:label "Competent Authority as Digital Procedure Manager"@en ;
    lomo:forAgent :Agent_CompetentAuthority ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

#################################################################
#    TEMPORAL SPECIFICATIONS
#################################################################

:TemporalSpec_SixMonthsAfterEntry rdf:type owl:NamedIndividual , lomo:TemporalSpecification ;
    rdfs:label "Six months after entry into force"@en ;
    lomo:hasStartDate "2026-08-17"^^xsd:date ;
    lomo:hasDescription "Six months after regulation entry into force"@en .

:TemporalSpec_TwelveMonthsAfterEntry rdf:type owl:NamedIndividual , lomo:TemporalSpecification ;
    rdfs:label "Twelve months after entry into force"@en ;
    lomo:hasStartDate "2027-02-17"^^xsd:date ;
    lomo:hasDescription "Twelve months after regulation entry into force"@en .

:TemporalSpec_TwentyFourMonthsAfterEntry rdf:type owl:NamedIndividual , lomo:TemporalSpecification ;
    rdfs:label "Twenty-four months after entry into force"@en ;
    lomo:hasStartDate "2028-02-17"^^xsd:date ;
    lomo:hasDescription "Twenty-four months after regulation entry into force"@en .

:TemporalSpec_Ongoing rdf:type owl:NamedIndividual , lomo:TemporalSpecification ;
    rdfs:label "Ongoing"@en ;
    lomo:hasDescription "Continuous/ongoing timeline"@en .

:TemporalSpec_PerCase rdf:type owl:NamedIndividual , lomo:TemporalSpecification ;
    rdfs:label "Per case basis"@en ;
    lomo:hasDescription "Triggered on a per-case basis"@en .

#################################################################
#    ACTIONS (from DIGITAL_DIMENSIONS.TXT requirements)
#################################################################

:Action_MemberState_ProvideOnlineInfo rdf:type owl:NamedIndividual , lomo:Action ;
    rdfs:label "Member States provide online information access"@en ;
    lomo:hasAgentRole :AgentRole_MemberState_Provider ;
    lomo:atTime :TemporalSpec_SixMonthsAfterEntry ;
    lomo:produces :Result_OnlineInformationAccess ;
    lomo:involvesProcess :Process_InformationProvision ;
    rdfs:comment "Member States shall provide developers and the public with access to environmental single points of contact and procedure information online"@en .

:Action_Developers_SubmitElectronicInfo rdf:type owl:NamedIndividual , lomo:Action ;
    rdfs:label "Developers submit information electronically"@en ;
    lomo:hasAgentRole :AgentRole_Developers_Submitter ;
    lomo:atTime :TemporalSpec_SixMonthsAfterEntry ;
    lomo:produces :Result_ElectronicSubmission ;
    lomo:involvesProcess :Process_ElectronicSubmission ;
    rdfs:comment "Developers shall be allowed to submit any information related to environmental assessments in electronic form"@en .

:Action_MemberState_PublishAssessmentData rdf:type owl:NamedIndividual , lomo:Action ;
    rdfs:label "Member States publish assessment data digitally"@en ;
    lomo:hasAgentRole :AgentRole_MemberState_Publisher ;
    lomo:atTime :TemporalSpec_TwelveMonthsAfterEntry ;
    lomo:produces :Result_DigitalPublication ;
    lomo:involvesProcess :Process_DataPublication ;
    rdfs:comment "Member States shall ensure that reports and data from environmental assessments are made publicly available in digital format through a central online portal"@en .

:Action_MemberState_EnableCrossBorderExchange rdf:type owl:NamedIndividual , lomo:Action ;
    rdfs:label "Member States enable cross-border data exchange"@en ;
    lomo:hasAgentRole :AgentRole_MemberState_CrossBorderEnabler ;
    lomo:atTime :TemporalSpec_TwentyFourMonthsAfterEntry ;
    lomo:produces :Result_CrossBorderExchange ;
    lomo:involvesProcess :Process_CrossBorderExchange ;
    rdfs:comment "Member States shall ensure that environmental assessment procedures are fully digitalized and enable seamless cross-border data sharing"@en .

:Action_CompetentAuthority_ProcessSubmissions rdf:type owl:NamedIndividual , lomo:Action ;
    rdfs:label "Competent authorities process electronic submissions"@en ;
    lomo:hasAgentRole :AgentRole_CompetentAuthority_Processor ;
    lomo:atTime :TemporalSpec_SixMonthsAfterEntry ;
    lomo:produces :Result_SubmissionProcessing ;
    lomo:involvesProcess :Process_SubmissionProcessing ;
    rdfs:comment "Competent authorities shall accept and process electronic submissions from developers"@en .

:Action_CompetentAuthority_ManageDigitalProcedures rdf:type owl:NamedIndividual , lomo:Action ;
    rdfs:label "Competent authorities manage digital procedures"@en ;
    lomo:hasAgentRole :AgentRole_CompetentAuthority_DigitalManager ;
    lomo:atTime :TemporalSpec_TwentyFourMonthsAfterEntry ;
    lomo:produces :Result_DigitalProcedureManagement ;
    lomo:involvesProcess :Process_DigitalProcedureManagement ;
    rdfs:comment "Competent authorities shall manage fully digitalized environmental assessment procedures"@en .

:Action_Public_AccessInformation rdf:type owl:NamedIndividual , lomo:Action ;
    rdfs:label "Public accesses environmental information"@en ;
    lomo:hasAgentRole :AgentRole_Public_Recipient ;
    lomo:atTime :TemporalSpec_SixMonthsAfterEntry ;
    lomo:produces :Result_PublicInformationAccess ;
    lomo:involvesProcess :Process_InformationAccess ;
    rdfs:comment "Public shall have access to environmental assessment information through online portals"@en .

#################################################################
#    ACTION RESULTS
#################################################################

:Result_OnlineInformationAccess rdf:type owl:NamedIndividual , lomo:ActionResult ;
    rdfs:label "Online information access provided"@en ;
    lomo:isManifestedIn :Dataset_SinglePointOfContactInfo , :Dataset_ProcedureInfo ;
    rdfs:comment "Result of Member States providing online access to SPOC and procedure information"@en .

:Result_ElectronicSubmission rdf:type owl:NamedIndividual , lomo:ActionResult ;
    rdfs:label "Electronic submission completed"@en ;
    lomo:isManifestedIn :Dataset_DeveloperSubmissions ;
    rdfs:comment "Result of developers submitting environmental assessment information electronically"@en .

:Result_DigitalPublication rdf:type owl:NamedIndividual , lomo:ActionResult ;
    rdfs:label "Digital publication of assessment data"@en ;
    lomo:isManifestedIn :Dataset_PublishedAssessmentData ;
    rdfs:comment "Result of Member States publishing environmental assessment data digitally"@en .

:Result_CrossBorderExchange rdf:type owl:NamedIndividual , lomo:ActionResult ;
    rdfs:label "Cross-border data exchange enabled"@en ;
    lomo:isManifestedIn :Dataset_CrossBorderData ;
    rdfs:comment "Result of enabling seamless cross-border data sharing for environmental assessments"@en .

:Result_SubmissionProcessing rdf:type owl:NamedIndividual , lomo:ActionResult ;
    rdfs:label "Electronic submission processed"@en ;
    lomo:isManifestedIn :Dataset_ProcessedSubmissions ;
    rdfs:comment "Result of competent authorities processing electronic submissions"@en .

:Result_DigitalProcedureManagement rdf:type owl:NamedIndividual , lomo:ActionResult ;
    rdfs:label "Digital procedure management implemented"@en ;
    lomo:isManifestedIn :Dataset_DigitalProcedureData ;
    rdfs:comment "Result of implementing fully digitalized environmental assessment procedures"@en .

:Result_PublicInformationAccess rdf:type owl:NamedIndividual , lomo:ActionResult ;
    rdfs:label "Public information access provided"@en ;
    lomo:isManifestedIn :Dataset_PublicAccessData ;
    rdfs:comment "Result of public accessing environmental assessment information"@en .

#################################################################
#    DATASETS (from DIGITAL_DIMENSIONS.TXT section 4.2)
#################################################################

:Dataset_SinglePointOfContactInfo rdf:type owl:NamedIndividual , dcat:Dataset ;
    dcterms:title "Environmental Single Point of Contact Information"@en ;
    dcterms:description "Information about environmental single points of contact established by Member States"@en ;
    lomo:hasStandard "Not specified in proposal"@en ;
    skos:prefLabel "SPOC Information Dataset"@en .

:Dataset_ProcedureInfo rdf:type owl:NamedIndividual , dcat:Dataset ;
    dcterms:title "Environmental Assessment Procedure Information"@en ;
    dcterms:description "Information about environmental assessment procedures including timelines and dispute settlement"@en ;
    lomo:hasStandard "Not specified in proposal"@en ;
    skos:prefLabel "Procedure Information Dataset"@en .

:Dataset_DeveloperSubmissions rdf:type owl:NamedIndividual , dcat:Dataset ;
    dcterms:title "Developer Electronic Submissions"@en ;
    dcterms:description "Documents and information submitted by developers in electronic form for environmental assessments"@en ;
    lomo:hasStandard "Not specified in proposal"@en ;
    skos:prefLabel "Developer Submissions Dataset"@en .

:Dataset_PublishedAssessmentData rdf:type owl:NamedIndividual , dcat:Dataset ;
    dcterms:title "Published Environmental Assessment Data"@en ;
    dcterms:description "Reports and data from environmental assessments made publicly available through central online portal"@en ;
    lomo:hasStandard "Protection of business secrets and compliance with EU/national data protection requirements"@en ;
    skos:prefLabel "Published Assessment Data Dataset"@en .

:Dataset_CrossBorderData rdf:type owl:NamedIndividual , dcat:Dataset ;
    dcterms:title "Cross-Border Environmental Assessment Data"@en ;
    dcterms:description "Data shared between Member States for environmental assessment procedures with cross-border relevance"@en ;    
    lomo:hasStandard "Not specified in proposal"@en ;
    skos:prefLabel "Cross-Border Data Dataset"@en .

:Dataset_ProcessedSubmissions rdf:type owl:NamedIndividual , dcat:Dataset ;
    dcterms:title "Processed Electronic Submissions"@en ;
    dcterms:description "Electronic submissions processed by competent authorities for environmental assessments"@en ;    
    lomo:hasStandard "Not specified in proposal"@en ;
    skos:prefLabel "Processed Submissions Dataset"@en .

:Dataset_DigitalProcedureData rdf:type owl:NamedIndividual , dcat:Dataset ;
    dcterms:title "Digital Procedure Management Data"@en ;
    dcterms:description "Data from fully digitalized environmental assessment procedures"@en ;    
    lomo:hasStandard "Not specified in proposal"@en .

:Dataset_PublicAccessData rdf:type owl:NamedIndividual , dcat:Dataset ;
    dcterms:title "Public Access Environmental Data"@en ;
    dcterms:description "Environmental assessment data accessible to the public through online portals"@en ;    
    lomo:hasStandard "Not specified in proposal"@en .

