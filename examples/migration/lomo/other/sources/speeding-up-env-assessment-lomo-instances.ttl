#################################################################

:InteroperabilityAssessment_AlignmentWithPolicies rdf:type owl:NamedIndividual , cav:InteroperabilityAssessment ;
    dcterms:title "Alignment with Existing Digital and Sectorial Policies"@en ;
    cav:assesses :DigitalPublicService_EnvironmentalPortal , :DigitalPublicService_CrossBorderExchange ;
    cav:hasAssessmentType cav:PolicyAlignmentAssessment ;
    rdfs:comment "Assessment of alignment with existing digital and sectorial policies for environmental assessment services."@en ;
    cav:hasAssessmentStatement "The regulation promotes digitalization of environmental assessment procedures and cross-border data sharing, aligning with EU digital policies."@en .

:InteroperabilityAssessment_OrganizationalMeasures rdf:type owl:NamedIndividual , cav:InteroperabilityAssessment ;
    dcterms:title "Organizational Measures for Cross-Border Services"@en ;
    cav:assesses :DigitalPublicService_CrossBorderExchange ;
    cav:hasAssessmentType cav:OrganizationalAssessment ;
    rdfs:comment "Assessment of organizational measures for smooth cross-border delivery of environmental assessment services."@en ;
    cav:hasAssessmentStatement "Member States are responsible for implementing digital procedures and ensuring cross-border interoperability through the established systems."@en .

:InteroperabilityAssessment_DataUnderstanding rdf:type owl:NamedIndividual , cav:InteroperabilityAssessment ;
    dcterms:title "Shared Understanding of Environmental Data"@en ;
    cav:assesses :DigitalPublicService_EnvironmentalPortal ;
    cav:hasAssessmentType cav:SemanticAssessment ;
    rdfs:comment "Assessment of measures taken to ensure shared understanding of environmental assessment data."@en ;
    cav:hasAssessmentStatement "The central online portal provides standardised access to environmental assessment data, promoting shared understanding across Member States."@en .

:InteroperabilityAssessment_TechnicalStandards rdf:type owl:NamedIndividual , cav:InteroperabilityAssessment ;
    dcterms:title "Use of Open Technical Specifications and Standards"@en ;
    cav:assesses :DigitalSolution_DigitalProcedures , :DigitalPublicService_CrossBorderExchange ;
    cav:hasAssessmentType cav:TechnicalAssessment ;
    rdfs:comment "Assessment of the use of commonly agreed open technical specifications and standards."@en ;
    cav:hasAssessmentStatement "Digital procedures should comply with relevant Union policies and technical standards, though specific standards are not named in the proposal."@en .

:CompleteInteroperabilityAssessment_EnvironmentalServices rdf:type owl:NamedIndividual , cav:CompleteInteroperabilityAssessment ;
    dcterms:title "Complete Interoperability Assessment for Environmental Assessment Services"@en ;
    cav:hasSubAssessment :InteroperabilityAssessment_AlignmentWithPolicies , :InteroperabilityAssessment_OrganizationalMeasures , :InteroperabilityAssessment_DataUnderstanding , :InteroperabilityAssessment_TechnicalStandards ;
    rdfs:comment "Complete interoperability assessment covering all aspects of environmental assessment digital services."@en .