#################################################################
#    PRESCRIPTIVE RULES (from key articles)
#################################################################

:Rule_Article3_SinglePointOfContact rdf:type owl:NamedIndividual , lomo:PrescriptiveRule , lomo:ImplementationAndOversightRule ;
    rdfs:label "Establishment of Environmental Single Points of Contact"@en ;
    lomo:hasDeonticModality <http://data.europa.eu/leg/deontic-modality/Obligation> ;
    lomo:produces :Action_MemberState_ProvideOnlineInfo ;
    lomo:establishedIn <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0984/art_3/par_3> ;
    lomo:legalText "Member States shall provide tools to help developers identify the appropriate established or designated contact point on the online portal set up in accordance with Article 10."@en ;
    lomo:references :DigitalSolution_OnlinePortal , :DigitalPublicService_EnvironmentalPortal , :Dataset_SinglePointOfContactInfo , :Dataset_ProcedureInfo ;
    lomo:involvesProcess :Process_InformationProvision ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/DigitalPublicService> , <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> ;
    rdfs:comment "Member States shall provide tools to help developers identify the appropriate established or designated contact point on the online portal."@en .

:Rule_Article10_ElectronicSubmission rdf:type owl:NamedIndividual , lomo:PrescriptiveRule , lomo:SubstantiveRule ;
    rdfs:label "Electronic Submission of Environmental Information"@en ;
    lomo:hasDeonticModality <http://data.europa.eu/leg/deontic-modality/Obligation> ;
    lomo:produces :Action_Developers_SubmitElectronicInfo , :Action_CompetentAuthority_ProcessSubmissions ;
    lomo:establishedIn <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0984/art_10/par_1> ;
    lomo:legalText "Developers shall be allowed to submit any information related to the environmental assessments and screening procedures in electronic form (after six months from entry into force)."@en ;
    lomo:references :DigitalSolution_ElectronicSubmission , :DigitalPublicService_EnvironmentalPortal , :Dataset_DeveloperSubmissions , :Dataset_ProcessedSubmissions ;
    lomo:involvesProcess :Process_ElectronicSubmission , :Process_Intake ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> , <http://data.europa.eu/leg/digital-dimensions/DigitalPublicService> ;
    rdfs:comment "Developers shall be allowed to submit any information related to the environmental assessment in electronic form (after six months from entry into force)."@en .

:Rule_Article10_OnlineInformationAccess rdf:type owl:NamedIndividual , lomo:PrescriptiveRule , lomo:SubstantiveRule ;
    rdfs:label "Online Access to Environmental Assessment Information"@en ;
    lomo:hasDeonticModality <http://data.europa.eu/leg/deontic-modality/Obligation> ;
    lomo:produces :Action_MemberState_ProvideOnlineInfo , :Action_Public_AccessInformation ;
    lomo:establishedIn <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0984/art_10/par_2> ;
    lomo:legalText "Member States shall provide developers and the public access to the following information as regards plans, programmes or projects, online and in a centralised and easily accessible manner: (a) the environmental single points of contact referred to in Article 3; (b) the progress of the environmental assessments and screening procedure, including the upcoming steps of the procedure and the timeline of those steps as well as information on dispute settlement (after six months from entry into force)."@en ;
    lomo:references :DigitalSolution_OnlinePortal , :DigitalPublicService_EnvironmentalPortal , :Dataset_SinglePointOfContactInfo , :Dataset_ProcedureInfo , :Dataset_PublicAccessData ;
    lomo:involvesProcess :Process_OnlineInformationProvision , :Process_Transparency ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data> , <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> , <http://data.europa.eu/leg/digital-dimensions/DigitalPublicService> ;
    rdfs:comment "Member States shall provide developers and the public access to environmental single points of contact and procedure information online and in a centralised and easily accessible manner."@en .

:Rule_Article10_DigitalPublication rdf:type owl:NamedIndividual , lomo:PrescriptiveRule , lomo:SubstantiveRule ;
    rdfs:label "Digital Publication of Assessment Reports"@en ;
    lomo:hasDeonticModality <http://data.europa.eu/leg/deontic-modality/Obligation> ;
    lomo:produces :Action_MemberState_PublishAssessmentData ;
    lomo:establishedIn <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0984/art_10/par_3> ;
    lomo:legalText "Member States shall ensure that reports and data resulting from environmental assessments and screening procedures, related decisions and monitoring of environmental effects and procedures are made and remain publicly available in a digital format through a central online portal, in a manner that is compatible with the preservation of business secrets and Union or national data protection requirements. That portal shall be based on a digital geographic information system and shall include all available data on species observations and other environmental and geological data. (after twelve months from entry into force)."@en ;
    lomo:references :DigitalSolution_OnlinePortal , :DigitalPublicService_EnvironmentalPortal , :Dataset_PublishedAssessmentData ;
    lomo:involvesProcess :Process_DataPublication , :Process_DataProtectionCompliance ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data> , <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> ;
    rdfs:comment "Member States shall ensure that reports and data from environmental assessments are made publicly available in a digital format through a central online portal, in a manner compatible with data protection requirements."@en .

:Rule_Article10_FullDigitalization rdf:type owl:NamedIndividual , lomo:PrescriptiveRule , lomo:SubstantiveRule ;
    rdfs:label "Full Digitalization of Assessment Procedures"@en ;
    lomo:hasDeonticModality <http://data.europa.eu/leg/deontic-modality/Obligation> ;
    lomo:produces :Action_MemberState_EnableCrossBorderExchange , :Action_CompetentAuthority_ManageDigitalProcedures ;
    lomo:establishedIn <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0984/art_10/par_4> ;
    lomo:legalText "Member States shall ensure that environmental assessment and screening procedures are fully digitalized and enable the re-use of data and documents held by public authorities at national level as well as the sharing of such data between Member States, developers and the public, in a seamless manner. Where appropriate, such procedures shall be interoperable with European Digital Identity Wallets and European Business Wallets. (after twenty four months of the entry into force)."@en ;
    lomo:references :DigitalSolution_DigitalProcedures , :DigitalPublicService_EnvironmentalPortal , :DigitalPublicService_CrossBorderExchange , :Dataset_CrossBorderData , :Dataset_DigitalProcedureData ;
    lomo:involvesProcess :Process_DigitalProcedureManagement , :Process_CrossBorderExchange , :Process_AutomationGovernance ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data> , <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> , <http://data.europa.eu/leg/digital-dimensions/DigitalPublicService> ;
    rdfs:comment "Member States shall ensure that environmental assessment procedures are fully digitalized and enable seamless cross-border data sharing, with interoperability with European Digital Identity Wallets and European Business Wallets where appropriate."@en .

:Rule_Article10_DisputeSettlementInfo rdf:type owl:NamedIndividual , lomo:PrescriptiveRule , lomo:SubstantiveRule ;
    rdfs:label "Access to Dispute Settlement Information"@en ;
    lomo:hasDeonticModality <http://data.europa.eu/leg/deontic-modality/Obligation> ;
    lomo:produces :Action_MemberState_ProvideOnlineInfo ;
    lomo:establishedIn <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0984/art_10/par_2/b/5> ;
    lomo:legalText "Member States shall provide developers and the public with access to the information on dispute settlement as regards plans, programmes or projects, online and in a centralised and easily accessible manner."@en ;
    lomo:references :DigitalSolution_OnlinePortal , :DigitalPublicService_EnvironmentalPortal , :Dataset_ProcedureInfo ;
    lomo:involvesProcess :Process_AccessToInformation , :Process_RedressPathways ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/DigitalPublicService> ;
    rdfs:comment "Member States shall provide developers and the public with access to information on dispute settlement procedures online."@en .

:Rule_Article12_ResourcesAndTraining rdf:type owl:NamedIndividual , lomo:PrescriptiveRule , lomo:ImplementationAndOversightRule ;
    rdfs:label "Resources and Training for Digital Implementation"@en ;
    lomo:hasDeonticModality <http://data.europa.eu/leg/deontic-modality/Obligation> ;
    lomo:produces :Action_CompetentAuthority_ManageDigitalProcedures ;
    lomo:establishedIn <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0984/art_12> ;
    lomo:legalText "Member States shall ensure that competent authorities have sufficient resources and training for effective performance of digital environmental assessment tasks."@en ;
    lomo:involvesProcess :Process_CapacityBuilding , :Process_TechnologyReadiness ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/DigitalPublicService> ;
    rdfs:comment "Member States shall provide resources and training for authorities to implement digital procedures."@en .

