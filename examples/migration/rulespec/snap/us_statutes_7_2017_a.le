% 7 U.S.C. 2017(a) — us:statutes/7/2017/a
the text of "7 USC 2017(a)" is at "sources/us/statutes/7/2017/a.yaml".

the text of "7 USC 2017(a), proviso for households of one and two persons" is at "sources/us/statutes/7/2017/a.yaml".

the text of "7 USC 2017(a), allotment authorized for households certified as eligible" is at "sources/us/statutes/7/2017/a.yaml".

rule snap_household_food_contribution_rate with provenance "7 USC 2017(a)",
        confer "30 per centum":
the snap household food contribution rate is 0.3 if
    the calculation date is a date D
    and 2008-10-01 <= D.

rule snap_minimum_allotment_rate with provenance "7 USC 2017(a)",
        confer "8 percent":
the snap minimum allotment rate is 0.08 if
    the calculation date is a date D
    and 2008-10-01 <= D.

rule snap_minimum_allotment_household_size_limit with provenance "7 USC 2017(a)",
        confer "households of one and two persons":
the snap minimum allotment household size limit is 2 if
    the calculation date is a date D
    and 2008-10-01 <= D.

rule snap_net_income_for_allotment with provenance "7 USC 2017(a)",
        confer "income, as determined in accordance with section 2014(d) and (e)":
the snap net income for allotment of a household is an amount N if
    the calculation date is a date D
    and 2008-10-01 <= D
    and the snap net income of the household is an amount M
    and the maximum of 0 and M is N.

rule snap_household_food_contribution with provenance "7 USC 2017(a)",
        confer "an amount equal to 30 per centum of the household's income":
the snap household food contribution of a household is an amount N if
    the calculation date is a date D
    and 2008-10-01 <= D
    and the snap net income for allotment of the household is an amount M
        and the snap household food contribution rate is a rate R
        and N = M * R.

rule snap_allotment_before_minimum with provenance "7 USC 2017(a)",
        confer "cost ... of the thrifty food plan reduced ... rounded to the nearest lower whole dollar":
the snap allotment before minimum of a household is an amount N if
    the calculation date is a date D
    and 2008-10-01 <= D
    and the snap maximum allotment of the household is an amount M
    and the snap household food contribution of the household is an amount K
    and a number P = M - K
    and the maximum of 0 and P is a number Q
    and N = floor(Q).

rule snap_minimum_monthly_allotment with provenance "7 USC 2017(a), proviso for households of one and two persons":
the snap minimum monthly allotment of a household is an amount N if
    the calculation date is a date D
    and 2008-10-01 <= D
    and the household size of the household is a number M
        and the snap minimum allotment household size limit is a number K
        and M <= K
        and the snap one person thrifty food plan cost of the household is an amount P
        and the snap minimum allotment rate is a rate R
        and N = floor(P * R + 0.5)
        otherwise the household is a household
        and N = 0.

rule snap_regular_month_allotment with provenance "7 USC 2017(a), allotment authorized for households certified as eligible":
the snap regular month allotment of a household is an amount N if
    the calculation date is a date D
    and 2008-10-01 <= D
    and the household is snap eligible
        and the snap allotment before minimum of the household is an amount M
        and the snap minimum monthly allotment of the household is an amount K
        and the maximum of M and K is N
        otherwise the household is a household
        and N = 0.

