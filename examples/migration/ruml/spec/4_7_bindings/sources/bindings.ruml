            "type": "currency",
            "unit": "EUR",
            "binding": {
              "type": "input"
            }
          },
          "dp_einkommensteuer": {
            "name": "Festzusetzende Einkommensteuer",
            "type": "currency",
            "unit": "EUR",
            "binding": {
              "type": "computed",
              "expression": "(dp_zve - 11604) * 0.14"
            }
          }
        }
