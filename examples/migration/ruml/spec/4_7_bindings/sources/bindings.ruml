          },
          "dp_gross_annual_income": {
            "name": "Brutto-Jahreseinkommen",
            "type": "currency",
            "unit": "EUR",
            "binding": {
              "type": "input",
              "hint": "Bitte geben Sie Ihr Brutto-Jahreseinkommen an",
              "placeholder": "z.B. 45000",
              "defaultValue": 0
            }
          },
          "dp_credit_score": {
            "name": "Bonitätsscore",
            "type": "number",
            "binding": {
              "type": "external",
              "ref": "schufa_api",
              "description": "SCHUFA-Schnittstelle zur Bonitätsprüfung"
            }
          },
          "dp_zve": {
