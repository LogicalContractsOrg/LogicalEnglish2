  "rulemap": {
    "nodes": {
      "1": {
        "id": "fcf02185-ffee-48a4-bf93-d2fb1b17944d",
        "label": "Einkommensprüfung",
        "capabilities": [
          {
            "id": "ruml:text-reference",
            "payload": {
              "refs": [
                {
                  "id": "text_sgb_ii_11",
                  "type": "refers-to"
                }
              ]
            }
          },
          {
            "id": "ruml:query",
            "payload": {
              "expression": "dp_annual_income > 50000"
            }
          },
          {
            "id": "ruml:actions",
            "payload": {
              "onTrue": {
                "operation": "createDocument",
                "ref": "approval_service"
              },
              "onFalse": {
