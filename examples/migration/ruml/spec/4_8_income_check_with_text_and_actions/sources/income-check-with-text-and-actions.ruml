    {
      "id": "ruml:text-reference",
      "payload": {
        "data": {
          "text_sgb_ii_11": {
            "title": "§ 11 SGB II – Zu berücksichtigendes Einkommen",
            "uri": "/akn/de/act/2003-12-24/sgb-2#sec_11",
            "timestamp": "2024-01-01T00:00:00Z",
            "status": "inForce",
            "type": "embedded",
            "text": "Als Einkommen zu berücksichtigen sind Einnahmen in Geld abzüglich der nach § 11b abzusetzenden Beträge mit Ausnahme der in § 11a genannten Einnahmen."
          }
        }
      }
    },
    {
      "id": "ruml:query"
    },
    {
      "id": "ruml:actions"
    }
