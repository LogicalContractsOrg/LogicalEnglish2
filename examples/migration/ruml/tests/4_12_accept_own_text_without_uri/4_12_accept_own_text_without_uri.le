scenario generated_4 is, as stated in "accept-own-text-without-uri.ruml" at generated_4:
    % every leaf answered no
    the answer to Benutzungsberechtigung for case 1 is false.
    node_1 expects answers [].
    not_node_1 expects answers ["it is not the case that Benutzungsberechtigung holds for case 1"].

query node_1 is:
    Benutzungsberechtigung holds for case 1.

query not_node_1 is:
