% ---------------------------------------------------------------------------
% The rules: a word in the name, in a field, or among the materials
% ---------------------------------------------------------------------------
rule jewellery_kind_by_name with provenance HTSUS Section XIV and Chapter 71,
        confer "the expression \"articles of jewelry\" means":
the kind of a good is a kind
    if the good is called a name
    and the name is a word for the kind the kind.

rule jewellery_kind_by_field with provenance the jewellery listing format,
        confer "Item Type (72 listings): the kind of product in the seller's words":
the kind of a good is a kind
    if the field a field of the good reads a value
    and the field is a field that names the kind
    and the value is a word for the kind the kind.

% a field for the kind of bracelet, earring, ring or wig says that the good
% is one
rule jewellery_kind_by_type_field with provenance the jewellery listing format,
        confer "Bracelets Type, Earring Type, Rings Type, Chain Type, Lace Wig Type: the kind of bracelet, earring, ring, chain or wig":
the kind of a good is a kind
    if the field a field of the good reads a value
    and the field is a field of the kind the kind.

rule metal_by_field with provenance the jewellery listing format,
        confer "Metals Type (69 listings): the metal":
the metal of a thing is a metal
    if the field a field of the thing reads a value
    and the field is a field that names the metal
    and the value is a word for the metal the metal.

rule metal_by_material with provenance the jewellery listing format,
        confer "Material (87 listings): the materials":
the metal of a thing is a metal
    if the thing names the material a name
    and the name is a word for the metal the metal.

rule cladding_by_field with provenance the jewellery listing format,
        confer "Metals Type (69 listings): the metal":
a thing is clad with a metal
    if the field a field of the thing reads a value
    and the field is a field that names the metal
    and the value is a word for cladding with the metal.

rule cladding_by_material with provenance the jewellery listing format,
        confer "Material (87 listings): the materials":
a thing is clad with a metal
    if the thing names the material a name
    and the name is a word for cladding with the metal.

rule gem_by_field with provenance the jewellery listing format,
        confer "Main Stone (18 listings) and Side Stone (10 listings): the stones":
the gem of a thing is a gem
    if the field a field of the thing reads a value
    and the field is a field that names the gem
    and the value is a word for the gem the gem.

rule gem_by_material with provenance the jewellery listing format,
        confer "Material (87 listings): the materials":
the gem of a thing is a gem
    if the thing names the material a name
    and the name is a word for the gem the gem.

rule hair_by_material with provenance the jewellery listing format,
        confer "Material (87 listings): the materials":
the hair of a thing is a hair
    if the thing names the material a name
    and the name is a word for the hair the hair.

% a listing with a field for the type of human hair offers an article of
% human hair
rule hair_by_human_hair_field with provenance the jewellery listing format,
        confer "Human Hair Type (24 listings), Hair Grade (17 listings), Material Grade (8 listings)":
the hair of a thing is human hair
    if the field a field of the thing reads a value
    and the field is a field of human hair.

% ---------------------------------------------------------------------------
% Tests
% ---------------------------------------------------------------------------

scenario jewels is:
    the field "item type" of bracelet 1 reads "bracelets".
    the field "metals type" of bracelet 1 reads "zinc alloy".
