#################################################################
#    STANDARDS AND SPECIFICATIONS
#################################################################

:Standard_EuropeanVulnerabilityDatabase rdf:type owl:NamedIndividual , dcterms:Standard ;
    dcterms:title "European Vulnerability Database"@en ;
    dcterms:description "Database established pursuant to Article 12(2) of Directive (EU) 2022/2555 containing publicly known vulnerabilities in ICT products and services"@en ;
    dcterms:references <https://data.europa.eu/eli/dir/2022/2555/oj/eng/art_12/par_2> ;
    rdfs:comment "Applicable to: Data connected to analysis/reports; Data of relevance to operational cooperation"@en .

:Standard_ConfidentialityHandling rdf:type owl:NamedIndividual , dcterms:Standard ;
    dcterms:title "Standards for Confidentiality and Handling Sensitive Information"@en ;
    dcterms:description "Standards and procedures for ensuring confidentiality and proper handling of sensitive cybersecurity information"@en ;
    rdfs:comment "Applicable to: Data of relevance to operational cooperation and situational awareness; Data with relevance to risk assessments. To be developed by ENISA and Member States"@en .

:Standard_InteroperabilityGuidelines rdf:type owl:NamedIndividual , dcterms:Standard ;
    dcterms:title "Interoperability Guidelines for Network Information Systems"@en ;
    dcterms:description "Guidelines for interoperability of network information systems used for information-sharing, including with regard to Cross-Border Cyber Hubs as referred to in Article 6(3) of Regulation (EU) 2025/38"@en ;
    dcterms:references <https://data.europa.eu/eli/reg/2025/38/oj/eng/art_6/par_3> ;
    rdfs:comment "Applicable to: Data connected to analysis/reports. To be issued by ENISA"@en .

:Standard_DigitalIdentityWallets rdf:type owl:NamedIndividual , dcterms:Standard ;
    dcterms:title "Electronic Attestations Format for European Digital Identity Wallets"@en ;
    dcterms:description "Format specifications for electronic attestations compatible with European Digital Identity Wallets set out in Regulation (EU) No 910/2014"@en ;
    dcterms:references <https://data.europa.eu/eli/reg/2014/910/oj> ;
    rdfs:comment "Applicable to: Data with relevance to European individual cybersecurity skills attestation schemes. Attestations must be issuable in wallet-compatible format"@en .

:Standard_InternationalConformityAssessment rdf:type owl:NamedIndividual , dcterms:Standard ;
    dcterms:title "International Standards for Conformity Assessment Bodies"@en ;
    dcterms:description "International standards specifying requirements for conformity assessment bodies and national cybersecurity certification authorities"@en ;
    rdfs:comment "Applicable to: Data related to governance of European cybersecurity certification framework; Data with relevance to certification schemes. ENISA and conformity assessment bodies must follow relevant international standards"@en .

:Standard_FinancialRegulationGuidelines rdf:type owl:NamedIndividual , dcterms:Standard ;
    dcterms:title "Financial Regulation Templates and Internal Guidelines"@en ;
    dcterms:description "Templates and guidelines based on financial regulation applicable to EU agencies"@en ;
    rdfs:comment "Applicable to: Data with relevance to internal ENISA functions (budget, SPD, internal strategies)"@en .

:Standard_GDPR rdf:type owl:NamedIndividual , dcterms:Standard ;
    dcterms:title "General Data Protection Regulation (GDPR)"@en ;
    dcterms:description "Regulation (EU) 2016/679 on the protection of natural persons with regard to the processing of personal data"@en ;
    dcterms:references <https://data.europa.eu/eli/reg/2016/679/oj> ;
    rdfs:comment "Applicable to: Personal data. All processing of personal data must comply with GDPR requirements"@en .

:Standard_DataProtectionEUInstitutions rdf:type owl:NamedIndividual , dcterms:Standard ;
    dcterms:title "Data Protection Regulation for EU Institutions - Regulation (EU) 2018/1725"@en ;
    dcterms:description "Regulation on the protection of natural persons with regard to the processing of personal data by Union institutions, bodies, offices and agencies"@en ;
    dcterms:references <https://data.europa.eu/eli/reg/2018/1725/oj> ;
    rdfs:comment "Applicable to: Personal data processed by ENISA and other EU institutions"@en .

:Standard_NIS2Directive_Art21 rdf:type owl:NamedIndividual , dcterms:Standard ;
    dcterms:title "NIS2 Directive - Article 21 (Coordinated Risk Assessments)"@en ;
    dcterms:description "Provisions for coordinated security risk assessments of critical supply chains under Directive (EU) 2022/2555"@en ;
    dcterms:references <https://data.europa.eu/eli/dir/2022/2555/oj/eng/art_21> ;
    rdfs:comment "Applicable to: Data gathered in coordinated risk assessments context. Activities must be conducted without prejudice to this provision"@en .

:Standard_DORA_Art13 rdf:type owl:NamedIndividual , dcterms:Standard ;
    dcterms:title "DORA - Article 13 (Threat-led Penetration Testing)"@en ;
    dcterms:description "Provisions for threat-led penetration testing in the financial sector under Regulation (EU) 2024/2847"@en ;
    dcterms:references <https://data.europa.eu/eli/reg/2024/2847/oj/eng/art_13> ;
    rdfs:comment "Applicable to: Data gathered in coordinated risk assessments context. Activities must be conducted without prejudice to this provision"@en .

