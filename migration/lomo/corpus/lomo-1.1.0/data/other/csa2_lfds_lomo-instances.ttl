    dcterms:isReferencedBy <https://data.europa.eu/eli/reg/2025/XXXX/oj/eng/art_11/par_1/point_a> ;
    lomo:hasCapability "Store verified cyber threat intelligence"@en ;
    lomo:hasCapability "Track trends in cybersecurity incidents"@en ;
    lomo:hasCapability "Document tactics, techniques and procedures (TTPs)"@en ;
    rdfs:comment "Referenced by Article 11(1)(a). Developed in cooperation with multiple Union entities."@en .

