#################################################################
#    HIGH-LEVEL PROCESSES (Classification, not Actions)
#################################################################

:HighLevelProcessScheme rdf:type owl:NamedIndividual , skos:ConceptScheme ;
    skos:prefLabel "High-Level Processes"@en ;
    skos:definition "Classification scheme for high-level data and operational processes in the cybersecurity certification and regulation domain."@en .

:Process_DataAnalysis rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Data Analysis"@en ;
    skos:definition "The process of analysing data to support decision-making, prepare reports, identify emerging threats, and conduct risk assessments."@en ;
    skos:inScheme :HighLevelProcessScheme ;
    skos:scopeNote "Includes analysis for reports, threat identification, risk assessments, and technical inquiries."@en .

:Process_InformationSharing rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Information Sharing"@en ;
    skos:definition "The process of exchanging information between Member States, EU institutions, competent authorities, and stakeholders."@en ;
    skos:inScheme :HighLevelProcessScheme ;
    skos:scopeNote "Includes bilateral and multilateral information exchange, notifications, and data flows between authorities."@en .

:Process_ProvidingGuidance rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Providing Guidance and Best Practices"@en ;
    skos:definition "The process of issuing technical guidance, guidelines, best practices, and advice on cybersecurity tools, procedures, standards, and regulatory compliance."@en ;
    skos:inScheme :HighLevelProcessScheme ;
    skos:scopeNote "Includes developing actionable tools, issuing guidelines, and facilitating exchange of best practices."@en .

:Process_TechnicalSupport rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Technical Support and Assistance"@en ;
    skos:definition "The process of providing technical advice, assistance, and support for implementation, incident handling, and vulnerability management."@en ;
    skos:inScheme :HighLevelProcessScheme ;
    skos:scopeNote "Includes assistance with incidents, vulnerability management services, and technical inquiries."@en .

:Process_Consultation rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Consultation with Stakeholders"@en ;
    skos:definition "The process of consulting relevant stakeholders, competent authorities, Member States, and suppliers on regulatory matters and certification schemes."@en ;
    skos:inScheme :HighLevelProcessScheme .

:Process_SchemeManagement rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Certification Scheme Management"@en ;
    skos:definition "The process of developing, maintaining, and updating European cybersecurity certification schemes, including candidate scheme preparation."@en ;
    skos:inScheme :HighLevelProcessScheme ;
    skos:scopeNote "Includes scheme development, maintenance, and updates following consultation processes."@en .

:Process_ApplicationProcessing rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Application Processing"@en ;
    skos:definition "The process of receiving, processing, and issuing decisions on applications for authorisation, certification, or accreditation."@en ;
    skos:inScheme :HighLevelProcessScheme .

:Process_PublicDissemination rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Public Information Dissemination"@en ;
    skos:definition "The process of making information publicly available through websites, electronic forms, and publicly accessible registers."@en ;
    skos:inScheme :HighLevelProcessScheme ;
    skos:scopeNote "Includes maintaining ENISA website, certification website, and Commission registers."@en .

:Process_RepositoryMaintenance rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Repository Maintenance"@en ;
    skos:definition "The process of developing and maintaining databases, repositories, and registers of certification information, authorities, and conformity assessment bodies."@en ;
    skos:inScheme :HighLevelProcessScheme .

:Process_Reporting rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Reporting"@en ;
    skos:definition "The process of preparing, submitting, and publishing reports on activities, performance, budget, and compliance to EU institutions."@en ;
    skos:inScheme :HighLevelProcessScheme ;
    skos:scopeNote "Includes annual reports, performance reports, and specific reports upon request."@en .

:Process_EarlyWarning rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Early Warning and Alerts"@en ;
    skos:definition "The process of issuing early alerts and warnings about cybersecurity threats and incidents."@en ;
    skos:inScheme :HighLevelProcessScheme .

:Process_IncidentHandling rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Incident Handling"@en ;
    skos:definition "The process of facilitating technical handling of cybersecurity incidents, supporting response activities, and providing analysis in response to technical inquiries."@en ;
    skos:inScheme :HighLevelProcessScheme .

:Process_RiskAssessment rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Risk Assessment"@en ;
    skos:definition "The process of conducting coordinated risk assessments on ICT products, services, and processes, including consultation with Member States."@en ;
    skos:inScheme :HighLevelProcessScheme .

:Process_Designation rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Designation and Notification"@en ;
    skos:definition "The process of designating and notifying competent authorities, liaison officers, and conformity assessment bodies."@en ;
    skos:inScheme :HighLevelProcessScheme ;
    skos:scopeNote "Includes notifications to the Commission and information flows related to designations."@en .

:Process_SecretariatServices rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Secretariat Services"@en ;
    skos:definition "The process of performing secretariat duties for networks, including facilitating meetings, gathering information, and coordinating activities."@en ;
    skos:inScheme :HighLevelProcessScheme .

:Process_ExerciseOrganisation rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Exercise Organisation"@en ;
    skos:definition "The process of receiving requests for and organising or supporting cybersecurity exercises."@en ;
    skos:inScheme :HighLevelProcessScheme .

:Process_AppealHandling rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Appeal Handling"@en ;
    skos:definition "The process of receiving, processing appeals, and issuing decisions on appeals, including preparing and publishing rules of procedures."@en ;
    skos:inScheme :HighLevelProcessScheme .

:Process_BudgetManagement rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Budget and Fee Management"@en ;
    skos:definition "The process of processing and sharing information regarding budget, managing fee payments, and reporting on fees."@en ;
    skos:inScheme :HighLevelProcessScheme .

:Process_ProgrammingDocumentation rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Programming Documentation"@en ;
    skos:definition "The process of drafting, adopting, and forwarding single programming documents and strategic planning documents."@en ;
    skos:inScheme :HighLevelProcessScheme .

:Process_GovernanceOversight rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Governance and Oversight"@en ;
    skos:definition "The process of appointing members, assessing activities, following up findings, and informing European Parliament on governance matters."@en ;
    skos:inScheme :HighLevelProcessScheme .

:Process_ConflictOfInterest rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Conflict of Interest Management"@en ;
    skos:definition "The process of processing and sharing data on declarations of interests to ensure transparency and avoid conflicts."@en ;
    skos:inScheme :HighLevelProcessScheme .

:Process_ClassifiedInformationHandling rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Classified Information Handling"@en ;
    skos:definition "The process of handling classified information according to security protocols."@en ;
    skos:inScheme :HighLevelProcessScheme .

:Process_ComplaintManagement rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Complaint Management"@en ;
    skos:definition "The process of managing information flows related to complaints between authorities, general public, and judicial proceedings."@en ;
    skos:inScheme :HighLevelProcessScheme ;
    skos:scopeNote "Includes challenges to competence of conformity assessment bodies."@en .

:Process_SupplierAssessment rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Supplier Assessment"@en ;
    skos:definition "The process of assessing suppliers, requesting information from suppliers, and sharing assessments with competent authorities."@en ;
    skos:inScheme :HighLevelProcessScheme .

:Process_AuthorisationManagement rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Authorisation Management"@en ;
    skos:definition "The process of managing information flows related to authorisations between competent authorities and entities."@en ;
    skos:inScheme :HighLevelProcessScheme .

:Process_MutualAssistance rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Mutual Assistance in Supervision"@en ;
    skos:definition "The process of providing mutual assistance between competent authorities in supervision actions."@en ;
    skos:inScheme :HighLevelProcessScheme .

:Process_CooperationFacilitation rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Cooperation Facilitation"@en ;
    skos:definition "The process of assisting Member States and facilitating cooperation processes through analysis, guidelines, methodology, and reports."@en ;
    skos:inScheme :HighLevelProcessScheme .


#################################################################
#    TEMPORAL SPECIFICATIONS
#################################################################

:TemporalSpec_AsNeeded rdf:type owl:NamedIndividual , lomo:TemporalSpecification ;
    rdfs:label "As Needed Exchange"@en ;
    lomo:temporalLabel "as needed"@en ;
    lomo:hasFunction <http://data.europa.eu/leg/temporal-function/deadline> ;
    rdfs:comment "Action performed on demand or when circumstances require."@en .


#################################################################
#    RESULT TYPES
#################################################################

:ResultType_GuidanceDocumentation rdf:type owl:NamedIndividual , lomo:ActionResultType ;
    rdfs:label "Guidance and Documentation"@en ;
    skos:definition "Technical guidance, best practices, guidelines, methodologies, and advisory documents issued to support implementation of cybersecurity policies, practices, and Union legislation. Includes technical guidance, best practices, guidelines, incident response playbooks, methodologies for vulnerability disclosure, and advisory materials."@en .

:ResultType_ReportsAnalyses rdf:type owl:NamedIndividual , lomo:ActionResultType ;
    rdfs:label "Reports and Analyses"@en ;
    skos:definition "Formal reports, analyses, and assessments including annual reports, threat analyses, risk assessments, market analyses, technical situation reports, evaluation reports, and peer review reports. Covers all types of analytical outputs: annual activity reports, cyber threat analyses, coordinated risk assessments, market trend analyses, evaluation reports on certification schemes, peer review summaries, and technical assessments."@en .

:ResultType_AdviceOpinions rdf:type owl:NamedIndividual , lomo:ActionResultType ;
    rdfs:label "Advice and Opinions"@en ;
    skos:definition "Technical advice, expert opinions, recommendations, and assessments provided to support decision-making on cybersecurity matters, policy implementation, and compliance issues. Includes technical advice on implementation, expert opinions from ECCG or Advisory Group, recommendations on standards alignment or lessons learned implementation, and specific assessments of incidents, threats, or suppliers."@en .

:ResultType_AlertsNotifications rdf:type owl:NamedIndividual , lomo:ActionResultType ;
    rdfs:label "Alerts and Notifications"@en ;
    skos:definition "Early alerts, warnings, and formal notifications regarding cybersecurity threats, incidents, changes, decisions, or compliance matters communicated to authorities, entities, or stakeholders. Encompasses early warnings on cyber threats, incident notifications, notifications of decisions or authorisations, communications on changes to implementation, and public communications on incidents."@en .

:ResultType_DigitalSolutionsDatabases rdf:type owl:NamedIndividual , lomo:ActionResultType ;
    rdfs:label "Digital Solutions, Databases and Repositories"@en ;
    skos:definition "Operational technical platforms, tools, digital solutions, databases, repositories, registries, and lists established, operated, maintained, and updated for cybersecurity purposes at Union level. Includes single reporting platforms for incident reporting, testing tools for conformity assessment, secure communications tools for CSIRTs network and EU-CyCLONe, cybersecurity maturity assessment tools, European Vulnerability Database, threat intelligence repositories, lessons learned repositories from exercises, registries of essential and important entities, lists of high-risk suppliers, public registers of Commission decisions, and repositories of certified products or services."@en .

:ResultType_FrameworksSchemesChemes rdf:type owl:NamedIndividual , lomo:ActionResultType ;
    rdfs:label "Frameworks, Schemes and Certificates"@en ;
    skos:definition "European cybersecurity certification schemes, skills frameworks, attestation schemes, certificates, statements of conformity, and related technical specifications developed or issued under Union cybersecurity legislation. Includes European Cybersecurity Certification Schemes for ICT products/services/processes, European Cybersecurity Skills Framework (ECSF), individual skills attestation schemes, European cybersecurity certificates, EU statements of conformity, individual cybersecurity skills attestations, technical specifications, and model provisions for schemes."@en .

:ResultType_PlanningRegulatoryDocuments rdf:type owl:NamedIndividual , lomo:ActionResultType ;
    rdfs:label "Planning and Regulatory Documents"@en ;
    skos:definition "Programming documents, work programmes, budget plans, implementing acts, delegated acts, decisions, rules of procedure, and other formal regulatory or planning instruments. Encompasses single programming documents, annual work programmes, rolling programmes of exercises, draft budget estimates, financial accounts, implementing acts defining key ICT assets or restrictions, delegated acts, formal decisions on authorisations or designations, rules of procedure for bodies, security rules for information handling, fee structures, and templates for standardised processes."@en .


#################################################################
#    ARTICLE 1 - SUBJECT MATTER AND SCOPE
#################################################################

:Requirement_Art1_Scope rdf:type owl:NamedIndividual , lomo:ConstitutiveRule ;
    rdfs:label "Article 1 - Subject Matter and Scope"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_1> ;
    lomo:legalText """This Regulation lays down: (a) the mission, objectives, tasks and organisational matters relating to the European Union Agency for Cybersecurity (ENISA); (b) a framework for establishing European cybersecurity certification schemes for the purpose of ensuring an adequate level of cybersecurity for ICT products, ICT services, ICT processes, managed security services or the cybersecurity posture of entities in the Union, as well as for the purpose of avoiding the fragmentation of the internal market with regard to cybersecurity certification schemes in the Union; and (c) a trusted ICT supply chain framework. The framework referred to in paragraph 1, point (b) applies without prejudice to specific provisions in other Union legal acts regarding voluntary or mandatory certification. The framework referred to in the first subparagraph point (c) shall apply to public or private entities of a type referred to in Annex I or II to Directive (EU) 2022/2555 which provide their services or carry out their activities within the Union. This Regulation is without prejudice to the Member States' essential State functions, including ensuring the territorial integrity of the State, maintaining law and order and safeguarding national security. In particular, national security remains the sole responsibility of each Member State."""@en ;
    rdfs:comment "Constitutive rule establishing the scope of the Regulation - defines three main frameworks (ENISA governance, cybersecurity certification, and trusted ICT supply chain), their application conditions, and safeguards for national security."@en .



#################################################################
#    ARTICLE 2 - DEFINITIONS
#################################################################

### Definitions from Article 2 (in order of appearance)

## Paragraph (1) - Cybersecurity
:Def_Cybersecurity rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Cybersecurity"@en ;
    lomo:hasDefiniendum "cybersecurity"@en ;
    lomo:hasDefiniens "the activities necessary to protect network and information systems, the users of such systems, and other persons affected by cyber threats"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_1> .

## Paragraph (2) - Union Entities
:Def_UnionEntities rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Union Entities (by reference)"@en ;
    lomo:hasDefiniendum "Union entities"@en ;
    lomo:hasDefiniens "as defined in Article 3, point (1), of Regulation (EU, Euratom) 2023/2841"@en ;
    lomo:isSemanticDefinition "false"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_2> .

## Paragraph (3) - Authorised Attestation Provider
:Def_AuthorisedAttestationProvider rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Authorised Attestation Provider"@en ;
    lomo:hasDefiniendum "authorised attestation provider"@en ;
    lomo:hasDefiniens "an entity, public or private, for which ENISA has adopted a decision authorising that entity to award European individual cybersecurity skills attestations as laid down in a European individual cybersecurity skills attestation scheme"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_3> .

## Paragraph (4) - European Individual Cybersecurity Skills Attestation
:Def_EuropeanIndividualCybersecuritySkillsAttestation rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: European Individual Cybersecurity Skills Attestation"@en ;
    lomo:hasDefiniendum "European individual cybersecurity skills attestation"@en ;
    lomo:hasDefiniens "a record, in digital or physical form, attesting that an individual knows, understands and is able to perform the tasks associated to a role profile or a subset of a role profile of the European Cybersecurity Skills Framework (ECSF), following an assessment as laid down in a European individual cybersecurity skills attestation scheme"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_4> .

## Paragraph (5) - European Individual Cybersecurity Skills Attestation Scheme
:Def_EuropeanIndividualCybersecuritySkillsAttestationScheme rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: European Individual Cybersecurity Skills Attestation Scheme"@en ;
    lomo:hasDefiniendum "European individual cybersecurity skills attestation scheme"@en ;
    lomo:hasDefiniens "a comprehensive set of rules, requirements, standards and procedures established by ENISA and associated to a role profile of the ECSF or a subset thereof, and that apply to and are applied by authorised attestation providers"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_5> .

## Paragraph (6) - Network and Information System
:Def_NetworkAndInformationSystem rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Network and Information System (by reference)"@en ;
    lomo:hasDefiniendum "network and information system"@en ;
    lomo:hasDefiniens "as defined in Article 6, point (1), of Directive (EU) 2022/2555"@en ;
    lomo:isSemanticDefinition "false"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_6> .

## Paragraph (7) - National Cybersecurity Strategy
:Def_NationalCybersecurityStrategy rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: National Cybersecurity Strategy (by reference)"@en ;
    lomo:hasDefiniendum "national cybersecurity strategy"@en ;
    lomo:hasDefiniens "as defined in Article 6, point (4), of Directive (EU) 2022/2555"@en ;
    lomo:isSemanticDefinition "false"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_7> .

## Paragraph (8) - Incident
:Def_Incident rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Incident (by reference)"@en ;
    lomo:hasDefiniendum "incident"@en ;
    lomo:hasDefiniens "as defined in Article 6, point (6), of Directive (EU) 2022/2555"@en ;
    lomo:isSemanticDefinition "false"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_8> .

## Paragraph (9) - Large-Scale Cybersecurity Incident
:Def_LargeScaleCybersecurityIncident rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Large-Scale Cybersecurity Incident (by reference)"@en ;
    lomo:hasDefiniendum "large-scale cybersecurity incident"@en ;
    lomo:hasDefiniens "as defined in Article 6, point (7), of Directive (EU) 2022/2555"@en ;
    lomo:isSemanticDefinition "false"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_9> .

## Paragraph (10) - Incident Handling
:Def_IncidentHandling rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Incident Handling (by reference)"@en ;
    lomo:hasDefiniendum "incident handling"@en ;
    lomo:hasDefiniens "as defined in Article 6, point (8), of Directive (EU) 2022/2555"@en ;
    lomo:isSemanticDefinition "false"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_10> .

## Paragraph (11) - Cyber Threat
:Def_CyberThreat rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Cyber Threat"@en ;
    lomo:hasDefiniendum "cyber threat"@en ;
    lomo:hasDefiniens "any potential circumstance, event or action that could damage, disrupt or otherwise adversely impact network and information systems, the users of such systems and other persons"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_11> .

## Paragraph (12) - European Cybersecurity Certification Scheme
:Def_EuropeanCybersecurityCertificationScheme rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: European Cybersecurity Certification Scheme"@en ;
    lomo:hasDefiniendum "European cybersecurity certification scheme"@en ;
    lomo:hasDefiniens "a comprehensive set of rules, technical requirements, standards and procedures that are established at Union level and that apply to the certification or conformity assessment of specific ICT products, ICT services, ICT processes, managed security services or cyber posture of entities"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_12> .

## Paragraph (13) - National Cybersecurity Certification Scheme
:Def_NationalCybersecurityCertificationScheme rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: National Cybersecurity Certification Scheme"@en ;
    lomo:hasDefiniendum "national cybersecurity certification scheme"@en ;
    lomo:hasDefiniens "a comprehensive set of rules, technical requirements, standards and procedures developed and adopted by a national public authority and that apply to the certification or conformity assessment of ICT products, ICT services, ICT processes, managed security services or cyber posture of entities falling under the scope of the specific scheme"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_13> .

## Paragraph (14) - European Cybersecurity Certificate
:Def_EuropeanCybersecurityCertificate rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: European Cybersecurity Certificate"@en ;
    lomo:hasDefiniendum "European cybersecurity certificate"@en ;
    lomo:hasDefiniens "a document issued by a relevant body, attesting that a given ICT product, ICT service, ICT process or managed security services, or the cyber posture of an entity has been evaluated for compliance with specific security requirements laid down in a European cybersecurity certification scheme"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_14> .

## Paragraph (15) - EU Statement of Conformity
:Def_EUStatementOfConformity rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: EU Statement of Conformity"@en ;
    lomo:hasDefiniendum "EU statement of conformity"@en ;
    lomo:hasDefiniens "a document issued by a manufacturer or provider of ICT products, ICT services, ICT processes, managed security services or the entity the cyber posture of which is subject to certification, stating that the fulfilment of the requirements corresponding to assurance level basic, laid down in the European cybersecurity certification scheme, has been demonstrated through conformity self-assessment"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_15> .

## Paragraph (16) - ICT Product
:Def_ICTProduct rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: ICT Product"@en ;
    lomo:hasDefiniendum "ICT product"@en ;
    lomo:hasDefiniens "an element or a group of elements of a network or information system"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_16> .

## Paragraph (17) - ICT Service
:Def_ICTService rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: ICT Service"@en ;
    lomo:hasDefiniendum "ICT service"@en ;
    lomo:hasDefiniens "a service consisting fully or mainly in the transmission, storing, retrieving or processing of information by means of network and information systems"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_17> .

## Paragraph (18) - ICT Process
:Def_ICTProcess rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: ICT Process"@en ;
    lomo:hasDefiniendum "ICT process"@en ;
    lomo:hasDefiniens "a set of activities performed to design, develop, deliver or maintain an ICT product or ICT service"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_18> .

## Paragraph (19) - Managed Security Service
:Def_ManagedSecurityService rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Managed Security Service"@en ;
    lomo:hasDefiniendum "managed security service"@en ;
    lomo:hasDefiniens "a service provided to a third party consisting of carrying out, or providing assistance for, activities relating to cybersecurity risk management, such as incident handling, penetration testing, security audits and consulting, including expert advice related to technical support"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_19> .

## Paragraph (20) - Accreditation
:Def_Accreditation rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Accreditation (by reference)"@en ;
    lomo:hasDefiniendum "accreditation"@en ;
    lomo:hasDefiniens "as defined in Article 2, point (10), of Regulation (EC) No 765/2008"@en ;
    lomo:isSemanticDefinition "false"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_20> .

## Paragraph (21) - National Accreditation Body
:Def_NationalAccreditationBody rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: National Accreditation Body (by reference)"@en ;
    lomo:hasDefiniendum "national accreditation body"@en ;
    lomo:hasDefiniens "as defined in Article 2, point (11), of Regulation (EC) No 765/2008"@en ;
    lomo:isSemanticDefinition "false"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_21> .

## Paragraph (22) - Conformity Assessment
:Def_ConformityAssessment rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Conformity Assessment (by reference)"@en ;
    lomo:hasDefiniendum "conformity assessment"@en ;
    lomo:hasDefiniens "as defined in Article 2, point (12), of Regulation (EC) No 765/2008"@en ;
    lomo:isSemanticDefinition "false"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_22> .

## Paragraph (23) - Conformity Assessment Body
:Def_ConformityAssessmentBody rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Conformity Assessment Body (by reference)"@en ;
    lomo:hasDefiniendum "conformity assessment body"@en ;
    lomo:hasDefiniens "as defined in Article 2, point (13), of Regulation (EC) No 765/2008"@en ;
    lomo:isSemanticDefinition "false"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_23> .

## Paragraph (24) - Standard
:Def_Standard rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Standard (by reference)"@en ;
    lomo:hasDefiniendum "standard"@en ;
    lomo:hasDefiniens "as defined in Article 2, point (1), of Regulation (EU) No 1025/2012"@en ;
    lomo:isSemanticDefinition "false"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_24> .

## Paragraph (25) - Technical Specification
:Def_TechnicalSpecification rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Technical Specification (by reference)"@en ;
    lomo:hasDefiniendum "technical specification"@en ;
    lomo:hasDefiniens "as defined in Article 2, point (4), of Regulation (EU) No 1025/2012"@en ;
    lomo:isSemanticDefinition "false"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_25> .

## Paragraph (26) - Harmonised Standard
:Def_HarmonisedStandard rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Harmonised Standard (by reference)"@en ;
    lomo:hasDefiniendum "harmonised standard"@en ;
    lomo:hasDefiniens "as defined in Article 2, point (1)(c), of Regulation (EU) No 1025/2012"@en ;
    lomo:isSemanticDefinition "false"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_26> .

## Paragraph (27) - Assurance Level
:Def_AssuranceLevel rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Assurance Level"@en ;
    lomo:hasDefiniendum "assurance level"@en ;
    lomo:hasDefiniens "a basis for confidence that an ICT product, ICT service, ICT process, managed security service or the cyber posture of an entity meets the security requirements of a specific European cybersecurity certification scheme, and indicates the level at which an ICT product, ICT service, ICT process, managed security service or cyber posture of entity has been evaluated but as such does not measure the security of the ICT product, ICT service, ICT process, managed security service or cyber posture of entity concerned"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_27> .

## Paragraph (28) - Conformity Self-Assessment
:Def_ConformitySelfAssessment rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Conformity Self-Assessment"@en ;
    lomo:hasDefiniendum "conformity self-assessment"@en ;
    lomo:hasDefiniens "an action carried out by a manufacturer or provider of ICT products, ICT services, ICT processes, managed security services or the entity the cyber posture of which is subject to certification, which evaluates whether those ICT products, ICT services, ICT processes, managed security services or cyber posture of entities meet the requirements of a specific European cybersecurity certification scheme"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_28> .

## Paragraph (29) - Cyber Posture of Entities
:Def_CyberPostureOfEntities rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Cyber Posture of Entities"@en ;
    lomo:hasDefiniendum "cyber posture of entities"@en ;
    lomo:hasDefiniens "entities' level of cybersecurity with respect to the specific security requirements"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_29> .

## Paragraph (30) - Prior Approval Model
:Def_PriorApprovalModel rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Prior Approval Model"@en ;
    lomo:hasDefiniendum "prior approval model"@en ;
    lomo:hasDefiniens "a model whereby a conformity assessment body may issue a European cybersecurity certificate based on the assessment by a national cybersecurity certification authority in the context of a specific certification process under a relevant scheme"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_30> .

## Paragraph (31) - General Delegation Model
:Def_GeneralDelegationModel rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: General Delegation Model"@en ;
    lomo:hasDefiniendum "general delegation model"@en ;
    lomo:hasDefiniens "a model whereby a conformity assessment body may issue a European cybersecurity certificate based on a delegation of certification activities by a national cybersecurity certification authority"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_31> .

## Paragraph (32) - CSIRT
:Def_CSIRT rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Computer Security Incident Response Team (by reference)"@en ;
    lomo:hasDefiniendum "computer security incident response team"@en ;
    lomo:hasDefiniens "a CSIRT designated or established pursuant to Article 10 of Directive (EU) 2022/2555"@en ;
    lomo:isSemanticDefinition "false"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_32> .

## Paragraph (33) - ICT Components
:Def_ICTComponents rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: ICT Components"@en ;
    lomo:hasDefiniendum "ICT components"@en ;
    lomo:hasDefiniens "ICT products, ICT services or ICT processes that may be used in the operation of ICT assets"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_33> .

## Paragraph (34) - ICT Assets
:Def_ICTAssets rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: ICT Assets"@en ;
    lomo:hasDefiniendum "ICT assets"@en ;
    lomo:hasDefiniens "software or hardware assets in the network and information systems used by an entity of the type referred to in Annexes I and II to Directive (EU) 2022/2555"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_34> .

## Paragraph (35) - Key ICT Assets
:Def_KeyICTAssets rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Key ICT Assets"@en ;
    lomo:hasDefiniendum "key ICT assets"@en ;
    lomo:hasDefiniens "ICT assets identified in accordance with Article 102"@en ;
    lomo:isSemanticDefinition "false"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_35> .

## Paragraph (36) - Electronic Communications Network
:Def_ElectronicCommunicationsNetwork rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Electronic Communications Network (by reference)"@en ;
    lomo:hasDefiniendum "electronic communications network"@en ;
    lomo:hasDefiniens "as defined in Article 2, point (1), of Regulation (EU) XX/XXXX [DNA proposal]"@en ;
    lomo:isSemanticDefinition "false"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_36> .

## Paragraph (37) - Control
:Def_Control rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Control"@en ;
    lomo:hasDefiniendum "control"@en ;
    lomo:hasDefiniens "the ability to exercise a decisive influence on a legal entity directly, or indirectly through one or more intermediate legal entities"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_37> .

## Paragraph (38) - Establishment
:Def_Establishment rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Establishment"@en ;
    lomo:hasDefiniendum "establishment"@en ;
    lomo:hasDefiniens "the effective exercise of activity through stable arrangements in the country where the entity has its central administration or its principal place of business"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_38> .

## Paragraph (39) - High-Risk Supplier
:Def_HighRiskSupplier rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: High-Risk Supplier"@en ;
    lomo:hasDefiniendum "high-risk supplier"@en ;
    lomo:hasDefiniens "either of the following: (a) an entity established in a third country posing cybersecurity concerns designated in accordance with Article 100, or controlled by such third country, by an entity established in such third country, or by a national of such third country; (b) an entity designated in accordance with Article 103(7) and entities controlled by that entity"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_39> .

## Paragraph (40) - ICT Supply Chain
:Def_ICTSupplyChain rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: ICT Supply Chain"@en ;
    lomo:hasDefiniendum "ICT supply chain"@en ;
    lomo:hasDefiniens "a sum of ICT services, ICT products and ICT processes that encompass activities and actors involved at all stages upstream of a product being made available or a service being delivered on the market"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_40> .

## Paragraph (41) - Third Country
:Def_ThirdCountry rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Third Country (by reference)"@en ;
    lomo:hasDefiniendum "third country"@en ;
    lomo:hasDefiniens "as defined in Article 3(4) of Regulation (EU) 2023/2675"@en ;
    lomo:isSemanticDefinition "false"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_41> .

## Paragraph (42) - Non-Technical Risk
:Def_NonTechnicalRisk rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Non-Technical Risk"@en ;
    lomo:hasDefiniendum "non-technical risk"@en ;
    lomo:hasDefiniens "the likelihood of the supplier being subject to influence by a third country with the potential to cause loss or disruption of the service provided or to compromise the product manufactured by an entity or to lead to exfiltration of data, including for the purposes of espionage or revenue generation"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_42> .

## Paragraph (43) - Significant Non-Technical Cybersecurity Risk
:Def_SignificantNonTechnicalCybersecurityRisk rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Significant Non-Technical Cybersecurity Risk"@en ;
    lomo:hasDefiniendum "significant non-technical cybersecurity risk"@en ;
    lomo:hasDefiniens "a non-technical cybersecurity risk which can be assumed to have a high likelihood to cause an incident that could lead to a severe negative impact, including by causing considerable material or non-material loss or disruption"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_43> .

## Paragraph (44) - Core Network Functions of Mobile Electronic Communications Networks
:Def_CoreNetworkFunctionsMobile rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Core Network Functions of Mobile Electronic Communications Networks"@en ;
    lomo:hasDefiniendum "core network functions of mobile electronic communications networks"@en ;
    lomo:hasDefiniens "the central architectural element of the mobile electronic communications networks connecting major network nodes to the Internet and managing essential system functions that includes user equipment authentication, lawful interception (LI) functions, security gateways (SeGW) at the network edge, signalling security functions, roaming and session management, user and control plane data transport, access policy management, registration and authorisation of network services, storage of end-user and network data, critical network services including domain name system (DNS), interconnection with third-party mobile networks, exposure of core network functions to external applications, and the selection and management of network slices"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_44> .

## Paragraph (45) - Network Function Virtualisation and MANO of Mobile Networks
:Def_NFVAndMANOMobile rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Network Function Virtualisation and MANO of Mobile Networks"@en ;
    lomo:hasDefiniendum "network function virtualisation (NFV) and management and network orchestration (MANO) of mobile electronic communications networks"@en ;
    lomo:hasDefiniens "the software and architectural framework ensuring the lifecycle management, orchestration, and automation of virtualised network functions (VNFs), cloud-native network functions (CNFs) and the selection and management of network slices within mobile electronic communications networks"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_45> .

## Paragraph (46) - Radio Access Network (RAN) of Mobile Networks
:Def_RANMobile rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Radio Access Network of Mobile Networks"@en ;
    lomo:hasDefiniendum "radio access network (RAN) of mobile electronic communications networks"@en ;
    lomo:hasDefiniens "the network connecting the mobile user equipment to the core network, including base stations (eNodeB for 4G, gNodeB for 5G), remote radio heads (RRH) and baseband units (BBU), active antenna systems (AAS), and where applicable, disaggregated RAN components such as centralised units (CU) and distributed units (DU), and the RAN intelligent controller (RIC)"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_46> .

## Paragraph (47) - Core Network Functions of Fixed Networks
:Def_CoreNetworkFunctionsFixed rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Core Network Functions of Fixed Networks"@en ;
    lomo:hasDefiniendum "core network functions of fixed electronic communications networks"@en ;
    lomo:hasDefiniens "the backbone intelligence of the network, connecting the major nodes and handling a range of essential functions, including user authentication and authorisation (AAA), lawful interception (LI) functions, domain name system (DNS) and IP addressing services (DHCP), access policy management, storage of end-user and network data, IP switching and routing, and international internet gateways (IIG)"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_47> .

## Paragraph (48) - Network Management System of Fixed Networks
:Def_NetworkManagementSystemFixed rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Network Management System of Fixed Networks"@en ;
    lomo:hasDefiniendum "network management system of fixed electronic communications networks"@en ;
    lomo:hasDefiniens "all centralised platforms and software components necessary for the operation, administration, maintenance and provisioning (OAM&P) of the network and the monitoring of network-related information"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_48> .

## Paragraph (49) - Transport and Transmission Functions of Fixed Networks
:Def_TransportTransmissionFixed rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Transport and Transmission Functions of Fixed Networks"@en ;
    lomo:hasDefiniendum "transport and transmission functions of fixed electronic communications networks"@en ;
    lomo:hasDefiniens "all components necessary for the backhaul and aggregation of traffic across the network, including optical transport equipment, microwave links and submarine cable systems that include the underwater equipment as well as the submarine line terminal equipment (SLTE) and the physical landing station facilities"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_49> .

## Paragraph (50) - Access Network of Fixed Networks
:Def_AccessNetworkFixed rdf:type owl:NamedIndividual , lomo:Definition ;
    rdfs:label "Definition: Access Network of Fixed Networks"@en ;
    lomo:hasDefiniendum "access network of fixed electronic communications networks"@en ;
    lomo:hasDefiniens "the network connecting the end-user premises to the aggregation or core network, including the optical line termination (OLT) and the optical network termination (ONT) for fibre networks; coaxial cable modem termination system (CMTS) and cable modems for coaxial cable networks, and fixed wireless access components where used as a fixed line substitute"@en ;
    lomo:isSemanticDefinition "true"^^xsd:boolean ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_2/par_50> .

#########################################
# ARTICLE 3 - MISSION OF ENISA
#########################################

:ConstitutiveRule_Art3_Par1 rdf:type owl:NamedIndividual , lomo:ConstitutiveRule ;
    rdfs:label "Article 3(1) - ENISA Primary Mission"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_3/par_1> ;
    lomo:legalText "The mission of ENISA is to support Member States and Union entities in achieving a high level of cybersecurity, cyber resilience and trust within the Union."@en ;
    rdfs:comment "Constitutes ENISA's primary institutional mission."@en .

:ConstitutiveRule_Art3_Par2 rdf:type owl:NamedIndividual , lomo:ConstitutiveRule ;
    rdfs:label "Article 3(2) - ENISA as Reference Point"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_3/par_2> ;
    lomo:legalText "ENISA shall act as a reference point for advice and expertise on cybersecurity for Member States, as well as for other stakeholders in the Union."@en ;
    rdfs:comment "Constitutes ENISA's institutional role as reference point for cybersecurity expertise."@en .

:ConstitutiveRule_Art3_Par3 rdf:type owl:NamedIndividual , lomo:ConstitutiveRule ;
    rdfs:label "Article 3(3) - Internal Market Contribution"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_3/par_3> ;
    lomo:legalText "ENISA shall contribute to reducing the fragmentation of the internal market by carrying out the tasks assigned to it under this Regulation."@en ;
    rdfs:comment "Constitutes ENISA's role in internal market integration."@en .

:ConstitutiveRule_Art3_Par4 rdf:type owl:NamedIndividual , lomo:ConstitutiveRule ;
    rdfs:label "Article 3(4) - Legal Acts Mandate"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_3/par_4> ;
    lomo:legalText "ENISA shall carry out the tasks assigned to it by Union legal acts."@en ;
    rdfs:comment "Constitutes ENISA's mandate to execute tasks from Union legal acts."@en .

:ConstitutiveRule_Art3_Par5 rdf:type owl:NamedIndividual , lomo:ConstitutiveRule ;
    rdfs:label "Article 3(5) - Capability Development"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_3/par_5> ;
    lomo:legalText "ENISA shall develop its own capabilities, including technical and human capabilities and skills, necessary to perform the tasks assigned to it under this Regulation."@en ;
    rdfs:comment "Constitutes ENISA's responsibility for capability development."@en .

#################################################################
#    ARTICLE 15 - PROVISION OF TOOLS AND PLATFORMS
#################################################################

:Requirement_Art15_Par1 rdf:type owl:NamedIndividual , lomo:PrescriptiveRule ;
    rdfs:label "Article 15(1) - Establishment and Operation of Technical Tools"@en ;
    lomo:hasDeonticModality <http://data.europa.eu/leg/deontic-modality/Obligation> ;
    lomo:produces :Action_Art15_Par1_ProvideToolsAndPlatforms ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/DigitalPublicService> ;
    lomo:involvesProcess :Process_ToolProvision , :Process_PlatformOperation ;
    lomo:references :Platform_SingleReportingPlatform , :Platform_SingleEntryPoint , :Tool_TestingTools ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_15/par_1> ;
    lomo:legalText """ENISA shall establish, provide, operate, maintain and update as necessary, operational technical tools, including platforms related to cybersecurity at Union level, in particular the single reporting platform established pursuant to Article 16(1) of Regulation (EU) 2024/2847 [and the single-entry point for incident reporting established pursuant to Article 23a of Directive (EU) 2022/2555], and testing tools to support the implementation of conformity assessment procedures in accordance with the relevant Union legislation."""@en ;
    rdfs:comment "Obligation for ENISA to establish and maintain operational technical tools and platforms for cybersecurity."@en .

:Requirement_Art15_Par2 rdf:type owl:NamedIndividual , lomo:PrescriptiveRule ;
    rdfs:label "Article 15(2) - Cooperation with CSIRTs and Market Surveillance Authorities"@en ;
    lomo:hasDeonticModality <http://data.europa.eu/leg/deontic-modality/Obligation> ;
    lomo:produces :Action_Art15_Par2_CooperateAndExchange ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/DataFlow> ;
    lomo:involvesProcess :Process_InformationExchange , :Process_Coordination ;
    lomo:establishedIn <https://data.europa.eu/eli/reg/2019/881/oj/eng/art_15/par_2> ;
    lomo:legalText """Where appropriate for the purposes of paragraph 1, ENISA shall cooperate and exchange information with the CSIRTs network and, where applicable, market surveillance authorities."""@en ;
    rdfs:comment "Conditional obligation for ENISA to cooperate with CSIRTs network and market surveillance authorities."@en .

:Action_Art15_Par1_ProvideToolsAndPlatforms rdf:type owl:NamedIndividual , lomo:Action ;
    rdfs:label "Establish, Provide, Operate, Maintain and Update Technical Tools"@en ;
    lomo:hasAgentRole :AgentRole_Art15_Par1_ENISA_ToolProvider ;
    rdfs:comment "Comprehensive action covering establishment, provision, operation, maintenance and updating of cybersecurity platforms and testing tools."@en .

:Action_Art15_Par2_CooperateAndExchange rdf:type owl:NamedIndividual , lomo:Action ;
    rdfs:label "Cooperate and Exchange Information with CSIRTs and Authorities"@en ;
    lomo:hasAgentRole :AgentRole_Art15_Par2_ENISA_Cooperator , :AgentRole_Art15_Par2_CSIRTs_Partner , :AgentRole_Art15_Par2_MarketAuthorities_Partner ;
    rdfs:comment "Cooperation and information exchange with CSIRTs network and market surveillance authorities."@en .

:AgentRole_Art15_Par1_ENISA_ToolProvider rdf:type owl:NamedIndividual , lomo:AgentRole ;
    lomo:forAgent :Agent_ENISA ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSER> .

:AgentRole_Art15_Par2_ENISA_Cooperator rdf:type owl:NamedIndividual , lomo:AgentRole ;
    lomo:forAgent :Agent_ENISA ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSER> .

:AgentRole_Art15_Par2_CSIRTs_Partner rdf:type owl:NamedIndividual , lomo:AgentRole ;
    lomo:forAgent :Agent_CSIRTsNetwork ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

:AgentRole_Art15_Par2_MarketAuthorities_Partner rdf:type owl:NamedIndividual , lomo:AgentRole ;
    lomo:forAgent :Agent_MarketSurveillanceAuthorities ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

