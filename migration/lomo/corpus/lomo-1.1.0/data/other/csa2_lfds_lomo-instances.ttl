@base <http://data.europa.eu/leg/lomo/lfds-CSA2> .

<http://data.europa.eu/leg/lomo/lfds/CSA2> rdf:type owl:Ontology ;
    dcterms:title "LFDS Proposal Cybersecurity Act 2 - LOMO Instantiation"@en ;
    dcterms:description "Instantiation of the Proposal for the Cybersecurity Act 2 Regulation (COM(2026) 11) using the Legal Obligation Metadata Ontology (LOMO)."@en ;
    dcterms:creator "European Commission" ;
    dcterms:created "2026-01-20"^^xsd:date ;
    owl:imports <http://data.europa.eu/leg/lomo> .


