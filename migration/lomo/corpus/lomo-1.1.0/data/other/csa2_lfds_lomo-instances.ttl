#################################################################
# Assessment 2: European individual cybersecurity skills attestation schemes
#################################################################

:Assessment_SkillsAttestation_AlignmentPolicies a cav:Assessment ;
    dct:type :AssessmentTypeAlignmentPolicies ;
    dct:description "Assessment of alignment with existing digital and sectorial policies for European individual cybersecurity skills attestation schemes."@en ;
    cav:assesses :Requirement_Art20_21_22_SkillsAttestationSchemes ,
                 :Requirement_Art23_SkillsWebsite ;
    cav:resultsIn :Statement_SkillsAttestation_Alignment_CybersecuritySkillsAcademy ,
                  :Statement_SkillsAttestation_Alignment_EUDIWallet ,
                  :Statement_SkillsAttestation_Alignment_Cybersecurity ,
                  :Statement_SkillsAttestation_Alignment_GDPR .

:Statement_SkillsAttestation_Alignment_CybersecuritySkillsAcademy a cav:Statement ;
    cav:type :StatementTypeAlignmentMeasure ;
    cav:interpretation :InterpretationPositive ;
    cav:judgement "The proposal builds on COM(2023)207 final (Cybersecurity Skills Academy) which states that ENISA will develop a pilot project, exploring the set-up of a European attestation scheme for cybersecurity skills."@en .

:Statement_SkillsAttestation_Alignment_EUDIWallet a cav:Statement ;
    cav:type :StatementTypeAlignmentMeasure ;
    cav:interpretation :InterpretationPositive ;
    cav:judgement "The proposal makes use of Regulation (EU) 2024/1183 (EUDI wallet) by establishing that ENISA and authorised attestation providers shall ensure that the electronic attestations of the European individual cybersecurity skills attestation are issued to the European Digital Identity Wallets."@en .

:Statement_SkillsAttestation_Alignment_Cybersecurity a cav:Statement ;
    cav:type :StatementTypeAlignmentMeasure ;
    cav:interpretation :InterpretationPositive ;
    cav:judgement "The European individual cybersecurity skills attestation schemes align with Cybersecurity policies."@en .

:Statement_SkillsAttestation_Alignment_GDPR a cav:Statement ;
    cav:type :StatementTypeAlignmentMeasure ;
    cav:interpretation :InterpretationPositive ;
    cav:judgement "The schemes comply with GDPR requirements regarding retention of records by providers."@en .

:Assessment_SkillsAttestation_OrganisationalMeasures a cav:Assessment ;
    dct:type :AssessmentTypeOrganisationalMeasures ;
    dct:description "Assessment of organisational measures for smooth cross-border delivery of European individual cybersecurity skills attestation schemes."@en ;
    cav:assesses :Requirement_Art20_21_22_SkillsAttestationSchemes ,
                 :Requirement_Art23_SkillsWebsite ;
    cav:resultsIn :Statement_SkillsAttestation_Org_StakeholderConsultation ,
                  :Statement_SkillsAttestation_Org_SeparationActivities ,
                  :Statement_SkillsAttestation_Org_BoardAppeal ,
                  :Statement_SkillsAttestation_Barrier_VoluntaryUse .

:Statement_SkillsAttestation_Org_StakeholderConsultation a cav:Statement ;
    cav:type :StatementTypeOrganisationMeasure ;
    cav:interpretation :InterpretationPositive ;
    cav:judgement "Consultation of stakeholders when preparing a European individual cybersecurity skills attestation scheme."@en .

:Statement_SkillsAttestation_Org_SeparationActivities a cav:Statement ;
    cav:type :StatementTypeOrganisationMeasure ;
    cav:interpretation :InterpretationPositive ;
    cav:judgement "Separation of activities within ENISA to ensure independent performance thereof."@en .

:Statement_SkillsAttestation_Org_BoardAppeal a cav:Statement ;
    cav:type :StatementTypeOrganisationMeasure ;
    cav:interpretation :InterpretationPositive ;
    cav:judgement "Board of Appeal established for governance of attestation schemes."@en .

:Statement_SkillsAttestation_Barrier_VoluntaryUse a cav:Statement ;
    cav:type :StatementTypeOrganisationBarrier ;
    cav:interpretation :InterpretationNeutral ;
    cav:judgement "The use and recognition of European individual cybersecurity skills attestation schemes shall remain voluntary for public and private entities."@en .

:Assessment_SkillsAttestation_SharedDataUnderstanding a cav:Assessment ;
    dct:type :AssessmentTypeSharedDataUnderstanding ;
    dct:description "Assessment of measures taken to ensure a shared understanding of the data for European individual cybersecurity skills attestation schemes."@en ;
    cav:assesses :Requirement_Art20_21_22_SkillsAttestationSchemes ,
                 :Requirement_Art23_SkillsWebsite ;
    cav:resultsIn :Statement_SkillsAttestation_Shared_DetailedSchemes ,
                  :Statement_SkillsAttestation_Shared_EUDIWalletFormat ,
                  :Statement_SkillsAttestation_Shared_GuidanceTraining ,
                  :Statement_SkillsAttestation_Shared_PublicWebsite ,
                  :Statement_SkillsAttestation_Shared_ImplementingActsFees ,
                  :Statement_SkillsAttestation_Barrier_UnforeseenDimensions .

:Statement_SkillsAttestation_Shared_DetailedSchemes a cav:Statement ;
    cav:type :StatementTypeSharedMeasure ;
    cav:interpretation :InterpretationPositive ;
    cav:judgement "Developing schemes that detail inter alia rules concerning the content and format of the attestations."@en .

:Statement_SkillsAttestation_Shared_EUDIWalletFormat a cav:Statement ;
    cav:type :StatementTypeSharedMeasure ;
    cav:interpretation :InterpretationPositive ;
    cav:judgement "Authorised providers shall ensure that, at the request of the individual, electronic attestations of European individual cybersecurity skills attestations are issued as electronic attestations of attributes in a format that can be stored in the European Digital Identity Wallets."@en .

:Statement_SkillsAttestation_Shared_GuidanceTraining a cav:Statement ;
    cav:type :StatementTypeSharedMeasure ;
    cav:interpretation :InterpretationPositive ;
    cav:judgement "ENISA to provide guidance to and conduct obligatory training of assessors regarding the requirements and assessment methods included in the European individual cybersecurity skills attestation scheme."@en .

:Statement_SkillsAttestation_Shared_PublicWebsite a cav:Statement ;
    cav:type :StatementTypeSharedMeasure ;
    cav:interpretation :InterpretationPositive ;
    cav:judgement "Providing public information on a website regarding attestation schemes."@en .

:Statement_SkillsAttestation_Shared_ImplementingActsFees a cav:Statement ;
    cav:type :StatementTypeSharedMeasure ;
    cav:interpretation :InterpretationPositive ;
    cav:judgement "Implementing acts on fees to ensure transparency and common understanding."@en .

:Statement_SkillsAttestation_Barrier_UnforeseenDimensions a cav:Statement ;
    cav:type :StatementTypeSharedBarrier ;
    cav:interpretation :InterpretationNeutral ;
    cav:judgement "Although the schemes should be as detailed as to ensure common understanding and ease implementation, and although ENISA will provide guidance to and conduct obligatory training of assessors to ensure consistent implementation of the schemes, unforeseen dimensions could arise where authorised attestation providers need to interact with ENISA, other providers or assessors."@en .

:Assessment_SkillsAttestation_StandardsSpecifications a cav:Assessment ;
    dct:type :AssessmentTypeStandardsSpecifications ;
    dct:description "Assessment of the use of commonly agreed open technical specifications and standards for European individual cybersecurity skills attestation schemes."@en ;
    cav:assesses :Requirement_Art20_21_22_SkillsAttestationSchemes ,
                 :Requirement_Art23_SkillsWebsite ;
    cav:resultsIn :Statement_SkillsAttestation_Standards_StakeholderDevelopment .

:Statement_SkillsAttestation_Standards_StakeholderDevelopment a cav:Statement ;
    cav:type :StatementTypeStandardsMeasure ;
    cav:interpretation :InterpretationPositive ;
    cav:judgement "European individual cybersecurity skills attestation schemes are developed with the support of relevant stakeholders."@en .

#################################################################
# Assessment 3: Preparing candidate European cybersecurity certification schemes 'candidate schemes'/assigning numbers to CABs
#################################################################

:Assessment_CertificationSchemes_AlignmentPolicies a cav:Assessment ;
    dct:type :AssessmentTypeAlignmentPolicies ;
    dct:description "Assessment of alignment with existing digital and sectorial policies for preparing candidate European cybersecurity certification schemes and assigning numbers to CABs."@en ;
    cav:assesses :Requirement_Art17_CertificationSchemes ,
                 :Requirement_Art94_Investigations ;
    cav:resultsIn :Statement_CertificationSchemes_Alignment_NewLegislativeFramework ,
                  :Statement_CertificationSchemes_Alignment_SectoralLegislation .

:Statement_CertificationSchemes_Alignment_NewLegislativeFramework a cav:Statement ;
    cav:type :StatementTypeAlignmentMeasure ;
    cav:interpretation :InterpretationPositive ;
    cav:judgement "The proposal seeks alignment on governance with the New legislative framework, in particular for what pertains Regulation (EC) 765/2008."@en .

:Statement_CertificationSchemes_Alignment_SectoralLegislation a cav:Statement ;
    cav:type :StatementTypeAlignmentMeasure ;
    cav:interpretation :InterpretationPositive ;
    cav:judgement "The proposal aims to facilitate compliance with relevant cybersecurity sectoral legislation through development of dedicated European cybersecurity certification schemes."@en .

:Assessment_CertificationSchemes_OrganisationalMeasures a cav:Assessment ;
    dct:type :AssessmentTypeOrganisationalMeasures ;
    dct:description "Assessment of organisational measures for smooth cross-border delivery of European cybersecurity certification schemes."@en ;
    cav:assesses :Requirement_Art17_CertificationSchemes ,
                 :Requirement_Art94_Investigations ;
    cav:resultsIn :Statement_CertificationSchemes_Org_CertificationGroup ,
                  :Statement_CertificationSchemes_Org_ENISA ,
                  :Statement_CertificationSchemes_Org_WorkingGroups ,
                  :Statement_CertificationSchemes_Org_Assembly ,
                  :Statement_CertificationSchemes_Org_StakeholderConsultation ,
                  :Statement_CertificationSchemes_Org_Comitology ,
                  :Statement_CertificationSchemes_Barrier_VoluntaryUse .

:Statement_CertificationSchemes_Org_CertificationGroup a cav:Statement ;
    cav:type :StatementTypeOrganisationMeasure ;
    cav:interpretation :InterpretationPositive ;
    cav:judgement "European Cybersecurity Certification Group established as governance measure."@en .

:Statement_CertificationSchemes_Org_ENISA a cav:Statement ;
    cav:type :StatementTypeOrganisationMeasure ;
    cav:interpretation :InterpretationPositive ;
    cav:judgement "ENISA plays a central role in preparing and maintaining certification schemes."@en .

:Statement_CertificationSchemes_Org_WorkingGroups a cav:Statement ;
    cav:type :StatementTypeOrganisationMeasure ;
    cav:interpretation :InterpretationPositive ;
    cav:judgement "Ad hoc working groups established for specific certification scheme development."@en .

:Statement_CertificationSchemes_Org_Assembly a cav:Statement ;
    cav:type :StatementTypeOrganisationMeasure ;
    cav:interpretation :InterpretationPositive ;
    cav:judgement "European Cybersecurity Certification Assembly established for stakeholder involvement."@en .

:Statement_CertificationSchemes_Org_StakeholderConsultation a cav:Statement ;
    cav:type :StatementTypeOrganisationMeasure ;
    cav:interpretation :InterpretationPositive ;
    cav:judgement "Consultation of stakeholders when requesting, developing and adopting European cybersecurity certification schemes."@en .

:Statement_CertificationSchemes_Org_Comitology a cav:Statement ;
    cav:type :StatementTypeOrganisationMeasure ;
    cav:interpretation :InterpretationPositive ;
    cav:judgement "Comitology procedures for envisaged implementing acts related to European cybersecurity certification schemes."@en .

:Statement_CertificationSchemes_Barrier_VoluntaryUse a cav:Statement ;
    cav:type :StatementTypeOrganisationBarrier ;
    cav:interpretation :InterpretationNeutral ;
    cav:judgement "The use of European cybersecurity certification shall be voluntary unless otherwise specified in European legislation."@en .

:Assessment_CertificationSchemes_SharedDataUnderstanding a cav:Assessment ;
    dct:type :AssessmentTypeSharedDataUnderstanding ;
    dct:description "Assessment of measures taken to ensure a shared understanding of the data for European cybersecurity certification schemes."@en ;
    cav:assesses :Requirement_Art17_CertificationSchemes ,
                 :Requirement_Art94_Investigations ;
    cav:resultsIn :Statement_CertificationSchemes_Shared_ImplementingActs ,
                  :Statement_CertificationSchemes_Barrier_VoluntaryUseMeasure .

:Statement_CertificationSchemes_Shared_ImplementingActs a cav:Statement ;
    cav:type :StatementTypeSharedMeasure ;
    cav:interpretation :InterpretationPositive ;
    cav:judgement "Implementing acts listed in section 4.5 ensure shared understanding of certification requirements and procedures."@en .

:Statement_CertificationSchemes_Barrier_VoluntaryUseMeasure a cav:Statement ;
    cav:type :StatementTypeSharedBarrier ;
    cav:interpretation :InterpretationNeutral ;
    cav:judgement "The use of European cybersecurity certification shall be voluntary unless otherwise specified in European legislation."@en .

:Assessment_CertificationSchemes_StandardsSpecifications a cav:Assessment ;
    dct:type :AssessmentTypeStandardsSpecifications ;
    dct:description "Assessment of the use of commonly agreed open technical specifications and standards for European cybersecurity certification schemes."@en ;
    cav:assesses :Requirement_Art17_CertificationSchemes ,
                 :Requirement_Art94_Investigations ;
    cav:resultsIn :Statement_CertificationSchemes_Standards_ImplementingActs ,
                  :Statement_CertificationSchemes_Standards_ConsistencyUnionLegislation ,
                  :Statement_CertificationSchemes_Standards_InternationalStandards .

:Statement_CertificationSchemes_Standards_ImplementingActs a cav:Statement ;
    cav:type :StatementTypeStandardsMeasure ;
    cav:interpretation :InterpretationPositive ;
    cav:judgement "Implementing acts listed in section 4.5 define technical specifications and standards."@en .

:Statement_CertificationSchemes_Standards_ConsistencyUnionLegislation a cav:Statement ;
    cav:type :StatementTypeStandardsMeasure ;
    cav:interpretation :InterpretationPositive ;
    cav:judgement "The specified requirements of the European cybersecurity certification scheme shall be consistent requirements of Union legislation."@en .

:Statement_CertificationSchemes_Standards_InternationalStandards a cav:Statement ;
    cav:type :StatementTypeStandardsMeasure ;
    cav:interpretation :InterpretationPositive ;
    cav:judgement "European cybersecurity certification schemes shall leverage and reference the international, European or national standards applied in the evaluation or, where such standards are not available or appropriate, to technical specifications drawn by ENISA."@en .

