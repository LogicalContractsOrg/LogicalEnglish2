    dcterms:conformsTo :Standard_DORA_Art13 ;
    lomo:hasCapability "Centralize cybersecurity incident reporting"@en ;
    lomo:hasCapability "Provide single-entry point for incident reporting"@en ;
    lomo:hasCapability "Support conformity assessment testing tools"@en ;
    rdfs:comment "Referenced by Article 15. Established, provided, operated, maintained and updated by ENISA. Integrates with NIS2 single-entry point (Article 23a of Directive (EU) 2022/2555)."@en .

