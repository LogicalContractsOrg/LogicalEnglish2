#################################################################
#    DATASETS (DCAT integration)
#################################################################

:Dataset_CentralDatabase rdf:type dcat:Dataset ;
    dcterms:title "Central Database System"@en ;
    dcterms:description "ESMA's central database for system designation and registration processes."@en .

:Dataset_ApplicationRecords rdf:type dcat:Dataset ;
    dcterms:title "System Designation Applications"@en ;
    dcterms:description "Records of applications for system designation submitted via the central database."@en .

:Dataset_NotificationRecords rdf:type dcat:Dataset ;
    dcterms:title "System Designation Notifications"@en ;
    dcterms:description "Records of notifications regarding system designations."@en .

:Dataset_ChangeRecords rdf:type dcat:Dataset ;
    dcterms:title "System Change Notifications"@en ;
    dcterms:description "Records of notifications regarding changes to designated systems."@en .

:Dataset_WithdrawalRecords rdf:type dcat:Dataset ;
    dcterms:title "Designation Withdrawal Notifications"@en ;
    dcterms:description "Records of notifications regarding withdrawal of system designations."@en .

:Dataset_AuthorityRecords rdf:type dcat:Dataset ;
    dcterms:title "Competent Authority Notifications"@en ;
    dcterms:description "Records of notifications regarding competent authorities."@en .

:Dataset_InformationExchange rdf:type dcat:Dataset ;
    dcterms:title "Information Exchange Records"@en ;
    dcterms:description "Records of information exchanges between authorities."@en .

:Dataset_RegistrationApplications rdf:type dcat:Dataset ;
    dcterms:title "Third-Country System Registration Applications"@en ;
    dcterms:description "Records of applications for registration of third-country systems."@en .

:Dataset_RegistrationNotifications rdf:type dcat:Dataset ;
    dcterms:title "System Registration Notifications"@en ;
    dcterms:description "Records of notifications regarding system registrations."@en .

:Dataset_WithdrawalNotifications rdf:type dcat:Dataset ;
    dcterms:title "Registration Withdrawal Notifications"@en ;
    dcterms:description "Records of notifications regarding withdrawal of system registrations."@en .

:Dataset_InsolvencyRecords rdf:type dcat:Dataset ;
    dcterms:title "Insolvency Proceedings Notifications"@en ;
    dcterms:description "Records of notifications regarding insolvency proceedings."@en .

# Data types from DIGITAL_DIMENSIONS.TXT section 4.2.1

:Dataset_DesignationApplicationData rdf:type dcat:Dataset ;
    dcterms:title "Data relevant for application for designation as a EU system"@en ;
    dcterms:description "Data relevant for application for designation as a EU system"@en ;
    dcterms:conformsTo :Standard_Article5_1 .

:Dataset_RegistrationDesignationSSCS rdf:type dcat:Dataset ;
    dcterms:title "Data relevant for application for registration and designation of securities settlement and clearing systems"@en ;
    dcterms:description "Data relevant for application for registration and designation of securities settlement and clearing systems"@en ;
    dcterms:conformsTo :Standard_Article13_13 .

:Dataset_DesignationWithdrawal rdf:type dcat:Dataset ;
    dcterms:title "Data relevant for withdrawal of designation"@en ;
    dcterms:description "Data relevant for withdrawal of designation"@en .

:Dataset_RegistrationDesignationPaymentSystems rdf:type dcat:Dataset ;
    dcterms:title "Data relevant for application for registration and designation of payment systems"@en ;
    dcterms:description "Data relevant for application for registration and designation of payment systems"@en ;
    dcterms:conformsTo :Standard_Article13_15 .

:Dataset_RegistrationWithdrawal rdf:type dcat:Dataset ;
    dcterms:title "Data relevant for withdrawal of registration"@en ;
    dcterms:description "Data relevant for withdrawal of registration"@en .

:Dataset_InsolvencyProceedings rdf:type dcat:Dataset ;
    dcterms:title "Data regarding insolvency proceedings"@en ;
    dcterms:description "Data regarding insolvency proceedings"@en .

# Standards from DIGITAL_DIMENSIONS.TXT

:Standard_Article5_1 rdf:type dcterms:Standard ;
    dcterms:title "Article 5(1) Technical Standards"@en ;
    dcterms:description "ESMA, in close cooperation with the ESCB, may develop draft regulatory technical standards to further specify the conditions referred to in Article 5(1) for security settlement systems and clearing systems. EBA, in close cooperation with the ESCB, may develop draft regulatory technical standards to further specify the conditions referred to in Article 5(1) for payment systems."@en .

:Standard_Article13_13 rdf:type dcterms:Standard ;
    dcterms:title "Article 13(13) Implementing Technical Standards"@en ;
    dcterms:description "ESMA shall, in close cooperation with the ESCB, develop draft implementing technical standards to specify, for securities settlement systems and clearing systems: (a) the uniform electronic formats for the application for registration referred to in paragraph 1, to be submitted to the central database; (b) the uniform electronic formats for the application for designation referred to in Article 4(1), to be submitted to the central database."@en .

:Standard_Article13_15 rdf:type dcterms:Standard ;
    dcterms:title "Article 13(15) Regulatory Technical Standards"@en ;
    dcterms:description "EBA shall, in close cooperation with the ESCB, develop, for payment systems, draft regulatory technical standards to further specify the information to be provided in: (a) an application for registration as referred to in paragraph 1 with a view to demonstrate that the applicant third-country system operator and the third-country system comply with all relevant requirements set out in this Article, including the conditions set out in Article 14, and to specify the information the application shall contain on the members, of the third-country system, established in the Union; (b) an application for designation as referred to in Article 4(1), with a view to demonstrate that the applicant system operator and the system comply with all the relevant requirements of this Regulation."@en .

#################################################################
#    HIGH-LEVEL PROCESSES (following ontology schema)
#################################################################

:HighLevelProcessScheme rdf:type skos:ConceptScheme ;
    skos:prefLabel "High-Level Processes"@en ;
    skos:definition "Classification scheme for high-level processes in the settlement finality regulation."@en .

:Process_DataSharing rdf:type skos:Concept ;
    skos:prefLabel "Data Sharing"@en ;
    skos:definition "Processes related to sharing data between authorities and system operators."@en ;
    skos:inScheme :HighLevelProcessScheme .

:Process_SystemRegistration rdf:type skos:Concept ;
    skos:prefLabel "System Registration"@en ;
    skos:definition "Processes related to registration of systems and third-country systems."@en ;
    skos:inScheme :HighLevelProcessScheme .

:Process_ApplicationSubmission rdf:type skos:Concept ;
    skos:prefLabel "Application Submission"@en ;
    skos:definition "Processes related to submission of applications for system designation."@en ;
    skos:inScheme :HighLevelProcessScheme .

:Process_Notification rdf:type skos:Concept ;
    skos:prefLabel "Notification"@en ;
    skos:definition "Processes related to notification of system status changes."@en ;
    skos:inScheme :HighLevelProcessScheme .

:Process_ChangeManagement rdf:type skos:Concept ;
    skos:prefLabel "Change Management"@en ;
    skos:definition "Processes related to management of changes to designated systems."@en ;
    skos:inScheme :HighLevelProcessScheme .

:Process_Withdrawal rdf:type skos:Concept ;
    skos:prefLabel "Withdrawal"@en ;
    skos:definition "Processes related to withdrawal of system designations or registrations."@en ;
    skos:inScheme :HighLevelProcessScheme .

:Process_AuthorityRegistration rdf:type skos:Concept ;
    skos:prefLabel "Authority Registration"@en ;
    skos:definition "Processes related to registration of competent authorities."@en ;
    skos:inScheme :HighLevelProcessScheme .

:Process_InformationExchange rdf:type skos:Concept ;
    skos:prefLabel "Information Exchange"@en ;
    skos:definition "Processes related to exchange of information between authorities."@en ;
    skos:inScheme :HighLevelProcessScheme .

:Process_Registration rdf:type skos:Concept ;
    skos:prefLabel "Registration"@en ;
    skos:definition "Processes related to registration of third-country systems."@en ;
    skos:inScheme :HighLevelProcessScheme .

:Process_InsolvencyHandling rdf:type skos:Concept ;
    skos:prefLabel "Insolvency Handling"@en ;
    skos:definition "Processes related to handling of insolvency proceedings."@en ;
    skos:inScheme :HighLevelProcessScheme .

#################################################################
#    DIGITAL SOLUTIONS (from DIGITAL_DIMENSIONS.TXT section 4.3)
#################################################################

:DigitalSolution_CentralDatabase rdf:type owl:NamedIndividual , dcterms:Software ;
    skos:prefLabel "Central Database Solution"@en ;
    skos:inScheme :DigitalDimensionScheme ;
    skos:definition "Central database for simultaneous information sharing amongst authorities involved in the designation and registration process"@en ;
    skos:broader <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> ;
    dcterms:title "Central database"@en ;
    rdfs:comment "Central database for simultaneous information sharing amongst authorities involved in the designation and registration process. Uses existing infrastructure for accessibility and reusability."@en ;
    lomo:hasReference "Article 26" ;
    lomo:hasFunctionality "Simultaneous information sharing" ;
    lomo:hasCapability "Simultaneous information sharing amongst authorities involved in the designation and registration process" ;
    dcterms:publisher :Agent_ESMA ;
    lomo:hasResponsibleBody :Agent_ESMA ;
    lomo:hasAccessibilityMeasure "ESMA, EBA (in close cooperation with the ESCB) shall develop draft implementing technical standards to specify the uniform electronic formats to be submitted to the central database." ;
    lomo:hasReusabilityMeasure "Data provided to the central database under this Regulation is made available to relevant competent authorities if relevant or necessary for the performance of their duties under Regulations (EU) No 648/2012 and Regulation (EU) No 909/2014." ;
    lomo:hasPolicyCompliance "Compliance with the EU Cybersecurity framework will be ensured through the implementation of technical standards and specifications, which will be established by ESMA and EBA in close collaboration with ESCB." .


#################################################################
#    DIGITAL PUBLIC SERVICES (from DIGITAL_DIMENSIONS.TXT section 4.4)
#################################################################

:DigitalPublicService_DesignationRegistrationPlatform rdf:type owl:NamedIndividual , cpsv:PublicService ;
    dcterms:title "Platform for applications for designation of a system and third-country systems registration"@en ;
    dcterms:description "Provide central entry point for applications in an electronic format for designation of a system. Provide central entry point for application for registration of third-country systems. Platform for processing and sharing the data amongst authorities involved in the designation and registration process."@en .    

#################################################################
#    IMPLEMENTATION MEASURES (from DIGITAL_DIMENSIONS.TXT section 4.5)
#################################################################

:ImplementationMeasure_CentralDatabase rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Central Database Establishment"@en ;
    skos:inScheme :DigitalDimensionScheme ;
    skos:definition "ESMA shall establish a central database"@en ;
    lomo:hasReference "Article 26" ;
    lomo:hasResponsibleBody :Agent_ESMA ;
    lomo:hasTimeline "Immediate implementation" .

:ImplementationMeasure_TechnicalStandards rdf:type owl:NamedIndividual , skos:Concept ;
    skos:prefLabel "Technical Standards Development"@en ;
    skos:inScheme :DigitalDimensionScheme ;
    skos:definition "ESMA, EBA (in close cooperation with the ESCB) shall develop draft implementing technical standards to specify the uniform electronic formats to be submitted to the central database"@en ;
    lomo:hasReference "Article 13(13), Article 13(15)" ;
    lomo:hasResponsibleBody :Agent_ESMA , :Agent_EBA ;
    lomo:hasTimeline "One year after entry into force" ;
    lomo:hasCommissionRole "Delegated acts adoption" .

#################################################################
#    INTEROPERABILITY ASSESSMENTS (CAV format)
#################################################################

# Assessment Types
:AssessmentTypeAlignmentPolicies rdf:type owl:NamedIndividual , cav:AssessmentType ;
    dct:title "Assessment of alignment with existing digital and sectorial policies"@en .

:AssessmentTypeOrganisationalMeasures rdf:type owl:NamedIndividual , cav:AssessmentType ;
    dct:title "Assessment of organisational measures for smooth cross-border digital public services delivery"@en .

:AssessmentTypeSharedDataUnderstanding rdf:type owl:NamedIndividual , cav:AssessmentType ;
    dct:title "Assessment of measures taken to ensure a shared understanding of the data"@en .

:AssessmentTypeStandardsSpecifications rdf:type owl:NamedIndividual , cav:AssessmentType ;
    dct:title "Assessment of the use of commonly agreed open technical specifications and standards"@en .

# Assessment Statements
:Statement_AlignmentPolicies rdf:type owl:NamedIndividual , cav:Statement ;
    dct:type :AssessmentTypeAlignmentPolicies ;
    cav:judgement "The regulation aligns with existing digital and sectorial policies through the central database approach."@en ;
    cav:type "Alignment Assessment"@en ;
    cav:interpretation "The central database ensures consistency with EU digital policies and sector-specific requirements."@en .

:Statement_OrganisationalMeasures rdf:type owl:NamedIndividual , cav:Statement ;
    dct:type :AssessmentTypeOrganisationalMeasures ;
    cav:judgement "Organisational measures are in place through ESMA's central database and technical standards development."@en ;
    cav:type "Organisational Assessment"@en ;
    cav:interpretation "ESMA, EBA, and ESCB collaboration ensures smooth cross-border service delivery."@en .

:Statement_DataUnderstanding rdf:type owl:NamedIndividual , cav:Statement ;
    dct:type :AssessmentTypeSharedDataUnderstanding ;
    cav:judgement "Measures ensure shared data understanding through uniform electronic formats and standards."@en ;
    cav:type "Data Understanding Assessment"@en ;
    cav:interpretation "Technical standards development promotes consistent data interpretation across authorities."@en .

:Statement_StandardsUsage rdf:type owl:NamedIndividual , cav:Statement ;
    dct:type :AssessmentTypeStandardsSpecifications ;
    cav:judgement "The regulation uses commonly agreed open technical specifications through implementing technical standards."@en ;
    cav:type "Standards Assessment"@en ;
    cav:interpretation "ESMA and EBA develop draft implementing technical standards for uniform electronic formats."@en .

# Assessments
:Assessment_AlignmentPolicies rdf:type owl:NamedIndividual , cav:Assessment ;
    dct:type :AssessmentTypeAlignmentPolicies ;
    dct:description "Assessment of alignment with existing digital and sectorial policies"@en ;
    cav:resultsIn :Statement_AlignmentPolicies .

:Assessment_OrganisationalMeasures rdf:type owl:NamedIndividual , cav:Assessment ;
    dct:type :AssessmentTypeOrganisationalMeasures ;
    dct:description "Assessment of organisational measures for smooth cross-border digital public services delivery"@en ;
    cav:resultsIn :Statement_OrganisationalMeasures .

:Assessment_DataUnderstanding rdf:type owl:NamedIndividual , cav:Assessment ;
    dct:type :AssessmentTypeSharedDataUnderstanding ;
    dct:description "Assessment of measures taken to ensure a shared understanding of the data"@en ;
    cav:resultsIn :Statement_DataUnderstanding .

:Assessment_StandardsUsage rdf:type owl:NamedIndividual , cav:Assessment ;
    dct:type :AssessmentTypeStandardsSpecifications ;
    dct:description "Assessment of the use of commonly agreed open technical specifications and standards"@en ;
    cav:resultsIn :Statement_StandardsUsage .