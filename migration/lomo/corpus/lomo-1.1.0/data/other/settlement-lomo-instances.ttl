@prefix : <http://data.europa.eu/leg/lomo/test#> .
@prefix lomo: <http://data.europa.eu/leg/lomo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eli: <http://data.europa.eu/eli/ontology#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix cpsv: <http://purl.org/vocab/cpsv#> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix cav: <http://data.europa.eu/2sa/cav#> .
@prefix lfds: <http://data.europa.eu/2qy/lfds#> .

@base <http://data.europa.eu/leg/lomo/test> .

<http://data.europa.eu/leg/lomo/test> rdf:type owl:Ontology ;
    dcterms:title "Proposal for a REGULATION OF THE EUROPEAN PARLIAMENT AND OF THE COUNCIL on settlement finality and repealing Directive 98/26/EC and amending Directive 2002/47/EC on financial collateral arrangements"@en ;
    dcterms:description ""@en ;
    dcterms:created "2026-02-17"^^xsd:date ;
    dcterms:modified "2026-02-17"^^xsd:date ;    
    owl:imports <http://data.europa.eu/leg/lomo> .

#################################################################
#    AGENTS (following ontology schema)
#################################################################

:Agent_ESMA rdf:type owl:NamedIndividual , lomo:Agent ;
    rdfs:label "European Securities and Markets Authority"@en .

:Agent_EBA rdf:type owl:NamedIndividual , lomo:Agent ;
    rdfs:label "European Banking Authority"@en .

:Agent_ESCB rdf:type owl:NamedIndividual , lomo:Agent ;
    rdfs:label "European System of Central Banks"@en .

:Agent_CompetentAuthority rdf:type owl:NamedIndividual , lomo:AgentType ;
    rdfs:label "Competent Authority (Member State)"@en .

:Agent_SystemOperator rdf:type owl:NamedIndividual , lomo:AgentType ;
    rdfs:label "System Operator"@en .

:Agent_ThirdCountrySystemOperator rdf:type owl:NamedIndividual , lomo:AgentType ;
    rdfs:label "Third-Country System Operator"@en .

:Agent_RegisteringAuthority rdf:type owl:NamedIndividual , lomo:AgentType ;
    rdfs:label "Registering Authority"@en .

:Agent_NationalCompetentAuthority rdf:type owl:NamedIndividual , lomo:AgentType ;
    rdfs:label "National Competent Authority"@en .

:Agent_DesignatingAuthority rdf:type owl:NamedIndividual , lomo:AgentType ;
    rdfs:label "Designating Authority"@en .

#################################################################
#    LEGAL RULES (Prescriptive Rules with EXACT Digital Dimensions from file)
#    Based on the exact elements in DIGITAL_DIMENSIONS.TXT
#################################################################

:Rule_Article26_CentralDatabase rdf:type owl:NamedIndividual , lomo:PrescriptiveRule , lomo:ImplementationAndOversightRule ;
    rdfs:label "ESMA Central Database Establishment"@en ;
    lomo:hasDeonticModality <http://data.europa.eu/leg/deontic-modality/Obligation> ;
    lomo:hasRequirementType <http://publications.europa.eu/resource/dataset/law-implementation-and-oversight/c_39b9f824> ;
    lomo:legalText "ESMA shall establish and maintain a central database providing access to the authorities involved in or concerned by the designation process of EU systems and the registration process of third-country systems, as well as the system operators."@en ;
    lomo:establishedIn <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0941/art_26> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> ;
    lomo:produces :Action_ESMA_EstablishDatabase ;
    lomo:hasAgentRole :AgentRole_ESMA_DatabaseOperator ;
    lomo:atTime :TemporalSpec_Immediate ;
    lomo:involvesProcess :Process_DataSharing , :Process_SystemRegistration ;
    lomo:references :DigitalSolution_CentralDatabase ;
    rdfs:comment "ESMA shall establish and maintain a central database providing access to the authorities involved in or concerned by the designation process of EU systems and the registration process of third-country systems, as well as the system operators."@en .

:Rule_Article4_ElectronicApplication rdf:type owl:NamedIndividual , lomo:PrescriptiveRule , lomo:SubstantiveRule ;
    rdfs:label "Electronic Application Submission"@en ;
    lomo:hasDeonticModality <http://data.europa.eu/leg/deontic-modality/Obligation> ;
    lomo:hasRequirementType <http://publications.europa.eu/resource/dataset/administrative-obligation/c_80214a02> ;
    lomo:legalText "The system operator that applies for designation of a system it operates shall submit, in an electronic format, an application addressed to the competent authority of the Member State whose law governs the system via the central database where it is processed afterwards and additional information might be asked."@en ;
    lomo:establishedIn <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0941/art_4> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data> , <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> ;
    lomo:produces :Action_SystemOperator_SubmitApplication ;
    lomo:hasAgentRole :AgentRole_SystemOperator_Applicant , :AgentRole_CompetentAuthority_Recipient ;
    lomo:atTime :TemporalSpec_ApplicationPeriod ;
    lomo:involvesProcess :Process_ApplicationSubmission ;
    lomo:references :DigitalSolution_CentralDatabase , :Dataset_DesignationApplications , :Dataset_DesignationApplicationData , :DigitalPublicService_DesignationRegistrationPlatform ;
    rdfs:comment "The system operator that applies for designation of a system it operates shall submit, in an electronic format, an application addressed to the competent authority of the Member State whose law governs the system via the central database where it is processed afterwards and additional information might be asked."@en .

:Rule_Article6_Notification rdf:type owl:NamedIndividual , lomo:PrescriptiveRule , lomo:SubstantiveRule ;
    rdfs:label "Notification of System Designation"@en ;
    lomo:hasDeonticModality <http://data.europa.eu/leg/deontic-modality/Obligation> ;
    lomo:hasRequirementType <http://publications.europa.eu/resource/dataset/administrative-obligation/c_39b9f824> ;
    lomo:legalText "A competent authority shall notify ESMA where it has designated a system through the central database. The competent authority shall notify ESMA and any other concerned authorities through the central database of changes in relation to the designation of the system."@en ;
    lomo:establishedIn <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0941/art_6> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data> , <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> ;
    lomo:produces :Action_CompetentAuthority_NotifyDesignation ;
    lomo:hasAgentRole :AgentRole_CompetentAuthority_Notifier , :AgentRole_ESMA_Recipient ;
    lomo:atTime :TemporalSpec_Immediate ;
    lomo:involvesProcess :Process_Notification ;
    lomo:references :DigitalSolution_CentralDatabase , :Dataset_SystemNotifications ;
    rdfs:comment "A competent authority shall notify ESMA where it has designated a system through the central database. The competent authority shall notify ESMA and any other concerned authorities through the central database of changes in relation to the designation of the system."@en .

:Rule_Article8_ChangesNotification rdf:type owl:NamedIndividual , lomo:PrescriptiveRule , lomo:SubstantiveRule ;
    rdfs:label "Notification of System Changes"@en ;
    lomo:hasDeonticModality <http://data.europa.eu/leg/deontic-modality/Obligation> ;
    lomo:hasRequirementType <http://publications.europa.eu/resource/dataset/administrative-obligation/c_39b9f824> ;
    lomo:legalText "The system operator shall notify the competent authority, via the central database of relevant changes to the information provided in the application."@en ;
    lomo:establishedIn <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0941/art_8> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data> , <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> ;
    lomo:produces :Action_SystemOperator_NotifyChanges ;
    lomo:hasAgentRole :AgentRole_SystemOperator_Notifier , :AgentRole_CompetentAuthority_Recipient ;
    lomo:atTime :TemporalSpec_Ongoing ;
    lomo:involvesProcess :Process_ChangeManagement ;
    lomo:references :DigitalSolution_CentralDatabase , :Dataset_DesignationApplications ;
    rdfs:comment "The system operator shall notify the competent authority, via the central database of relevant changes to the information provided in the application."@en .

:Rule_Article9_WithdrawalNotification rdf:type owl:NamedIndividual , lomo:PrescriptiveRule , lomo:SubstantiveRule ;
    rdfs:label "Notification of Designation Withdrawal"@en ;
    lomo:hasDeonticModality <http://data.europa.eu/leg/deontic-modality/Obligation> ;
    lomo:hasRequirementType <http://publications.europa.eu/resource/dataset/administrative-obligation/c_39b9f824> ;
    lomo:legalText "Where a competent authority takes a decision to withdraw the designation of a system, the decision shall take effect throughout the Union and the competent authority shall inform the system operator, the national competent authority, ESMA, EBA and the ESCB via the central database."@en ;
    lomo:establishedIn <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0941/art_9> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data> , <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> ;
    lomo:produces :Action_CompetentAuthority_NotifyWithdrawal ;
    lomo:hasAgentRole :AgentRole_CompetentAuthority_Notifier ,
                      :AgentRole_SystemOperator_Recipient ,
                      :AgentRole_NationalCompetentAuthority_Recipient ,
                      :AgentRole_ESMA_Recipient ,
                      :AgentRole_EBA_Recipient ,
                      :AgentRole_ESCB_Recipient ;
    lomo:atTime :TemporalSpec_Immediate ;
    lomo:involvesProcess :Process_Withdrawal ;
    lomo:references :DigitalSolution_CentralDatabase , :Dataset_DesignationWithdrawals , :Dataset_DesignationWithdrawal ;
    rdfs:comment "Where a competent authority takes a decision to withdraw the designation of a system, the decision shall take effect throughout the Union and the competent authority shall inform the system operator, the national competent authority, ESMA, EBA and the ESCB via the central database."@en .

:Rule_Article10_CompetentAuthorityNotification rdf:type owl:NamedIndividual , lomo:PrescriptiveRule , lomo:SubstantiveRule ;
    rdfs:label "Notification of Competent Authorities"@en ;
    lomo:hasDeonticModality <http://data.europa.eu/leg/deontic-modality/Obligation> ;
    lomo:hasRequirementType <http://publications.europa.eu/resource/dataset/administrative-obligation/c_39b9f824> ;
    lomo:legalText "Member States shall notify, via the central database, the competent authorities and the registration authorities to ESMA."@en ;
    lomo:establishedIn <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0941/art_10> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data> , <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> ;
    lomo:produces :Action_MemberState_NotifyAuthorities ;
    lomo:hasAgentRole :AgentRole_MemberState_Notifier , :AgentRole_ESMA_Recipient ;
    lomo:atTime :TemporalSpec_Immediate ;
    lomo:involvesProcess :Process_AuthorityRegistration ;
    lomo:references :DigitalSolution_CentralDatabase ;
    rdfs:comment "Member States shall notify, via the central database, the competent authorities and the registration authorities to ESMA."@en .

:Rule_Article11_InformationExchange rdf:type owl:NamedIndividual , lomo:PrescriptiveRule , lomo:SubstantiveRule ;
    rdfs:label "Exchange of Information"@en ;
    lomo:hasDeonticModality <http://data.europa.eu/leg/deontic-modality/Obligation> ;
    lomo:hasRequirementType <http://publications.europa.eu/resource/dataset/administrative-obligation/c_39b9f824> ;
    lomo:legalText "Designating authorities, registering authorities, national competent authorities, competent authorities referred to in Article 22(2), ESMA, EBA and the ESCB, shall share and provide one another with information where that is requested for carrying out their respective duties under this Regulation without undue delay."@en ;
    lomo:establishedIn <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0941/art_11> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data> , <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> , <http://data.europa.eu/leg/digital-dimensions/ProcessAutomation> ;
    lomo:produces :Action_Authorities_ExchangeInformation ;
    lomo:hasAgentRole :AgentRole_DesignatingAuthority_Sharer ,
                      :AgentRole_RegisteringAuthority_Sharer ,
                      :AgentRole_NationalCompetentAuthority_Sharer ,
                      :AgentRole_CompetentAuthority_Sharer ,
                      :AgentRole_ESMA_Sharer ,
                      :AgentRole_EBA_Sharer ,
                      :AgentRole_ESCB_Sharer ,
                      :AgentRole_DesignatingAuthority_Recipient ,
                      :AgentRole_RegisteringAuthority_Recipient ,
                      :AgentRole_NationalCompetentAuthority_Recipient ,
                      :AgentRole_CompetentAuthority_Recipient ,
                      :AgentRole_ESMA_Recipient ,
                      :AgentRole_EBA_Recipient ,
                      :AgentRole_ESCB_Recipient ;
    lomo:atTime :TemporalSpec_Ongoing ;
    lomo:involvesProcess :Process_InformationExchange ;
    lomo:references :DigitalSolution_CentralDatabase ;
    rdfs:comment "Designating authorities, registering authorities, national competent authorities, competent authorities referred to in Article 22(2), ESMA, EBA and the ESCB, shall share and provide one another with information where that is requested for carrying out their respective duties under this Regulation without undue delay."@en .

:Rule_Article13_RegistrationApplication rdf:type owl:NamedIndividual , lomo:PrescriptiveRule , lomo:SubstantiveRule ;
    rdfs:label "Third-Country System Registration Application"@en ;
    lomo:hasDeonticModality <http://data.europa.eu/leg/deontic-modality/Obligation> ;
    lomo:hasRequirementType <http://publications.europa.eu/resource/dataset/administrative-obligation/c_80214a02> ;
    lomo:legalText "Application, information, requests for information as well as decisions for third-country system registration are to be done via the central database."@en ;
    lomo:establishedIn <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0941/art_13> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data> , <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> ;
    lomo:produces :Action_ThirdCountryOperator_SubmitRegistration ;
    lomo:hasAgentRole :AgentRole_ThirdCountryOperator_Applicant , :AgentRole_ESMA_Recipient ;
    lomo:atTime :TemporalSpec_ApplicationPeriod ;
    lomo:involvesProcess :Process_Registration ;
    lomo:references :DigitalSolution_CentralDatabase , :Dataset_RegistrationApplications , :Dataset_RegistrationDesignationSSCS , :Dataset_RegistrationDesignationPaymentSystems , :DigitalPublicService_DesignationRegistrationPlatform ;
    rdfs:comment "Application, information, requests for information as well as decisions for third-country system registration are to be done via the central database."@en .

:Rule_Article15_RegistrationNotification rdf:type owl:NamedIndividual , lomo:PrescriptiveRule , lomo:SubstantiveRule ;
    rdfs:label "Notification of Registered Systems"@en ;
    lomo:hasDeonticModality <http://data.europa.eu/leg/deontic-modality/Obligation> ;
    lomo:hasRequirementType <http://publications.europa.eu/resource/dataset/administrative-obligation/c_39b9f824> ;
    lomo:legalText "After taking a decision on registration of a system, each registering authority shall notify the applicant third-country system operator, ESMA, EBA, the ESCB and the other registering authorities, as applicable of its decision."@en ;
    lomo:establishedIn <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0941/art_15> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data> , <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> ;
    lomo:produces :Action_RegisteringAuthority_NotifyRegistration ;
    lomo:hasAgentRole :AgentRole_RegisteringAuthority_Notifier ,
                      :AgentRole_ThirdCountryOperator_Recipient ,
                      :AgentRole_ESMA_Recipient ,
                      :AgentRole_EBA_Recipient ,
                      :AgentRole_ESCB_Recipient ,
                      :AgentRole_RegisteringAuthority_Recipient ;
    lomo:atTime :TemporalSpec_Immediate ;
    lomo:involvesProcess :Process_Notification ;
    lomo:references :DigitalSolution_CentralDatabase , :Dataset_RegistrationApplications ;
    rdfs:comment "After taking a decision on registration of a system, each registering authority shall notify the applicant third-country system operator, ESMA, EBA, the ESCB and the other registering authorities, as applicable of its decision."@en .

:Rule_Article16_RegistrationWithdrawalNotification rdf:type owl:NamedIndividual , lomo:PrescriptiveRule , lomo:SubstantiveRule ;
    rdfs:label "Notification of Registration Withdrawal"@en ;
    lomo:hasDeonticModality <http://data.europa.eu/leg/deontic-modality/Obligation> ;
    lomo:hasRequirementType <http://publications.europa.eu/resource/dataset/administrative-obligation/c_39b9f824> ;
    lomo:legalText "Where the registering authority withdraws the registration, it shall notify the system operator as well as ESMA, EBA, the ESCB and other registering authorities, as applicable, of the decision."@en ;
    lomo:establishedIn <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0941/art_16> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data> , <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> ;
    lomo:produces :Action_RegisteringAuthority_NotifyWithdrawal ;
    lomo:hasAgentRole :AgentRole_RegisteringAuthority_Notifier ,
                      :AgentRole_ThirdCountryOperator_Recipient ,
                      :AgentRole_ESMA_Recipient ,
                      :AgentRole_EBA_Recipient ,
                      :AgentRole_ESCB_Recipient ,
                      :AgentRole_RegisteringAuthority_Recipient ;
    lomo:atTime :TemporalSpec_Immediate ;
    lomo:involvesProcess :Process_Withdrawal ;
    lomo:references :DigitalSolution_CentralDatabase , :Dataset_RegistrationWithdrawals , :Dataset_RegistrationWithdrawal ;
    rdfs:comment "Where the registering authority withdraws the registration, it shall notify the system operator as well as ESMA, EBA, the ESCB and other registering authorities, as applicable, of the decision."@en .

:Rule_Article22_InsolvencyNotification rdf:type owl:NamedIndividual , lomo:PrescriptiveRule , lomo:SubstantiveRule ;
    rdfs:label "Notification of Insolvency Proceedings"@en ;
    lomo:hasDeonticModality <http://data.europa.eu/leg/deontic-modality/Obligation> ;
    lomo:hasRequirementType <http://publications.europa.eu/resource/dataset/administrative-obligation/c_39b9f824> ;
    lomo:legalText "The competent authority shall immediately notify via the central database about insolvency proceedings ESMA, the ECB/ESCB, EBA, the European Systemic Risk Board and other Member States in writing."@en ;
    lomo:establishedIn <https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:52025PC0941/art_22> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data> , <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> ;
    lomo:produces :Action_CompetentAuthority_NotifyInsolvency ;
    lomo:hasAgentRole :AgentRole_CompetentAuthority_Notifier ,
                      :AgentRole_ESMA_Recipient ,
                      :AgentRole_ESCB_Recipient ,
                      :AgentRole_EBA_Recipient ,
                      :AgentRole_CompetentAuthority_Recipient ;
    lomo:atTime :TemporalSpec_Immediate ;
    lomo:involvesProcess :Process_InsolvencyHandling ;
    lomo:references :DigitalSolution_CentralDatabase , :Dataset_InsolvencyData , :Dataset_InsolvencyProceedings ;
    rdfs:comment "The competent authority shall immediately notify via the central database about insolvency proceedings ESMA, the ECB/ESCB, EBA, the European Systemic Risk Board and other Member States in writing."@en .

#################################################################
#    ACTIONS (following ontology schema)
#################################################################

:Action_ESMA_EstablishDatabase rdf:type owl:NamedIndividual , lomo:Action ;
    rdfs:label "Establish Central Database"@en ;
    lomo:hasAgentRole :AgentRole_ESMA_DatabaseOperator ;
    lomo:hasResult :Result_CentralDatabase ;
    lomo:atTime :TemporalSpec_Immediate .

:Action_SystemOperator_SubmitApplication rdf:type owl:NamedIndividual , lomo:Action ;
    rdfs:label "Submit Designation Application"@en ;
    lomo:hasAgentRole :AgentRole_SystemOperator_Applicant , :AgentRole_CompetentAuthority_Recipient ;
    lomo:hasResult :Result_ApplicationSubmission , :Dataset_DesignationApplicationData ;
    lomo:atTime :TemporalSpec_ApplicationPeriod .

:Result_ApplicationSubmission lomo:isManifestedIn :Dataset_DesignationApplicationData .

:Action_CompetentAuthority_NotifyDesignation rdf:type owl:NamedIndividual , lomo:Action ;
    rdfs:label "Notify System Designation"@en ;
    lomo:hasAgentRole :AgentRole_CompetentAuthority_Notifier , :AgentRole_ESMA_Recipient ;
    lomo:hasResult :Result_DesignationNotification , :Dataset_SystemNotifications ;
    lomo:atTime :TemporalSpec_Immediate .

:Result_DesignationNotification lomo:isManifestedIn :Dataset_SystemNotifications .

:Action_SystemOperator_NotifyChanges rdf:type owl:NamedIndividual , lomo:Action ;
    rdfs:label "Notify System Changes"@en ;
    lomo:hasAgentRole :AgentRole_SystemOperator_Notifier , :AgentRole_CompetentAuthority_Recipient ;
    lomo:hasResult :Result_ChangeNotification , :Dataset_DesignationWithdrawal ;
    lomo:atTime :TemporalSpec_Ongoing .

:Action_CompetentAuthority_NotifyWithdrawal rdf:type owl:NamedIndividual , lomo:Action ;
    rdfs:label "Notify Designation Withdrawal"@en ;
    lomo:hasAgentRole :AgentRole_CompetentAuthority_Notifier ,
                      :AgentRole_SystemOperator_Recipient ,
                      :AgentRole_NationalCompetentAuthority_Recipient ,
                      :AgentRole_ESMA_Recipient ,
                      :AgentRole_EBA_Recipient ,
                      :AgentRole_ESCB_Recipient ;
    lomo:hasResult :Result_WithdrawalNotification , :Dataset_DesignationWithdrawal ;
    lomo:atTime :TemporalSpec_Immediate .

:Action_MemberState_NotifyAuthorities rdf:type owl:NamedIndividual , lomo:Action ;
    rdfs:label "Notify Competent Authorities"@en ;
    lomo:hasAgentRole :AgentRole_MemberState_Notifier , :AgentRole_ESMA_Recipient ;
    lomo:hasResult :Result_AuthorityNotification ;
    lomo:atTime :TemporalSpec_Immediate .

:Action_Authorities_ExchangeInformation rdf:type owl:NamedIndividual , lomo:Action ;
    rdfs:label "Exchange Information"@en ;
    lomo:hasAgentRole :AgentRole_DesignatingAuthority_Sharer ,
                      :AgentRole_RegisteringAuthority_Sharer ,
                      :AgentRole_NationalCompetentAuthority_Sharer ,
                      :AgentRole_CompetentAuthority_Sharer ,
                      :AgentRole_ESMA_Sharer ,
                      :AgentRole_EBA_Sharer ,
                      :AgentRole_ESCB_Sharer ,
                      :AgentRole_DesignatingAuthority_Recipient ,
                      :AgentRole_RegisteringAuthority_Recipient ,
                      :AgentRole_NationalCompetentAuthority_Recipient ,
                      :AgentRole_CompetentAuthority_Recipient ,
                      :AgentRole_ESMA_Recipient ,
                      :AgentRole_EBA_Recipient ,
                      :AgentRole_ESCB_Recipient ;
    lomo:hasResult :Result_InformationExchange ;
    lomo:atTime :TemporalSpec_Ongoing .

:Action_ThirdCountryOperator_SubmitRegistration rdf:type owl:NamedIndividual , lomo:Action ;
    rdfs:label "Submit Registration Application"@en ;
    lomo:hasAgentRole :AgentRole_ThirdCountryOperator_Applicant , :AgentRole_ESMA_Recipient ;
    lomo:hasResult :Result_RegistrationApplication , :Dataset_RegistrationDesignationSSCS , :Dataset_RegistrationDesignationPaymentSystems ;
    lomo:atTime :TemporalSpec_ApplicationPeriod .

:Action_RegisteringAuthority_NotifyRegistration rdf:type owl:NamedIndividual , lomo:Action ;
    rdfs:label "Notify System Registration"@en ;
    lomo:hasAgentRole :AgentRole_RegisteringAuthority_Notifier ,
                      :AgentRole_ThirdCountryOperator_Recipient ,
                      :AgentRole_ESMA_Recipient ,
                      :AgentRole_EBA_Recipient ,
                      :AgentRole_ESCB_Recipient ,
                      :AgentRole_RegisteringAuthority_Recipient ;
    lomo:hasResult :Result_RegistrationNotification , :Dataset_RegistrationApplications ;
    lomo:atTime :TemporalSpec_Immediate .

:Action_RegisteringAuthority_NotifyWithdrawal rdf:type owl:NamedIndividual , lomo:Action ;
    rdfs:label "Notify Registration Withdrawal"@en ;
    lomo:hasAgentRole :AgentRole_RegisteringAuthority_Notifier ,
                      :AgentRole_ThirdCountryOperator_Recipient ,
                      :AgentRole_ESMA_Recipient ,
                      :AgentRole_EBA_Recipient ,
                      :AgentRole_ESCB_Recipient ,
                      :AgentRole_RegisteringAuthority_Recipient ;
    lomo:hasResult :Result_RegistrationWithdrawalNotification , :Dataset_RegistrationWithdrawal ;
    lomo:atTime :TemporalSpec_Immediate .

:Action_CompetentAuthority_NotifyInsolvency rdf:type owl:NamedIndividual , lomo:Action ;
    rdfs:label "Notify Insolvency Proceedings"@en ;
    lomo:hasAgentRole :AgentRole_CompetentAuthority_Notifier ,
                      :AgentRole_ESMA_Recipient ,
                      :AgentRole_ESCB_Recipient ,
                      :AgentRole_EBA_Recipient ,
                      :AgentRole_CompetentAuthority_Recipient ;
    lomo:hasResult :Result_InsolvencyNotification , :Dataset_InsolvencyProceedings ;
    lomo:atTime :TemporalSpec_Immediate .

#################################################################
#    AGENT ROLES (following ontology schema with exact actors from file)
#################################################################

:AgentRole_ESMA_DatabaseOperator rdf:type owl:NamedIndividual , lomo:AgentRole ;
    lomo:forAgent :Agent_ESMA ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSER> .

:AgentRole_SystemOperator_Applicant rdf:type owl:NamedIndividual , lomo:AgentRole ;
    lomo:forAgent :Agent_SystemOperator ;
