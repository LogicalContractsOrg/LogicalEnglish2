    lomo:hasAgentRole <http://example.org/analysis/description/1/action/role/addressee-european-commission-beneficiaries> .

<http://example.org/analysis/description/1/action/role/addressee-european-commission-beneficiaries> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/european-commission-beneficiaries> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/analysis/description/2/action> a lomo:Action ;
    lomo:hasAgentRole <http://example.org/analysis/description/2/action/role/addressee-european-commission-beneficiaries> .

<http://example.org/analysis/description/2/action/role/addressee-european-commission-beneficiaries> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/european-commission-beneficiaries> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/analysis/description/3/action> a lomo:Action ;
    lomo:hasAgentRole <http://example.org/analysis/description/3/action/role/addressee-european-commission-beneficiaries> .

<http://example.org/analysis/description/3/action/role/addressee-european-commission-beneficiaries> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/european-commission-beneficiaries> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/analysis/description/4/action> a lomo:Action ;
    lomo:hasAgentRole <http://example.org/analysis/description/4/action/role/addressee-european-commission-beneficiaries> .

<http://example.org/analysis/description/4/action/role/addressee-european-commission-beneficiaries> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/european-commission-beneficiaries> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/process/programme-implementation-monitoring-and-evaluation> skos:prefLabel "Programme implementation, monitoring and evaluation"@en .

<http://example.org/process/programme-implementation-through-direct-grant-management> skos:prefLabel "Programme implementation through direct grant management"@en .

<http://example.org/standard/commission-monitoring-and-reporting-tools-and-databases-including-egrants> a dcterms:Standard ;
    dcterms:title "Commission monitoring and reporting tools and databases, including eGrants."@en .

<http://example.org/process/dissemination-support-to-the-programme> skos:prefLabel "Dissemination, support to the Programme"@en .

<http://example.org/analysis/action/1> a lomo:Action ;
    rdfs:label "Countries, organisations, budget, participants and priorities per project"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "Regulation (EU) XXX [Performance Regulation]: Article XXX (monitoring) and Article XXX (implementation report and retrospective evaluations).Regular programme reporting"@en ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:deadline ;
            lomo:temporalLabel "Regulation (EU) XXX [Performance Regulation]: Article XXX (monitoring) and Article XXX (implementation report and retrospective evaluations)."@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/463/cod/doc/com/COM_2025_463/FINAL/eng/art_1>,
        <https://data.europa.eu/eli/dl/proc/2025/463/cod/doc/com/COM_2025_463/FINAL/eng/art_3>,
        <https://data.europa.eu/eli/dl/proc/2025/463/cod/doc/com/COM_2025_463/FINAL/eng/art_4> ;
    lomo:hasAgentRole <http://example.org/analysis/action/1/role/addressee-general-public-commission-european-parliament-council-of-the-european-union>,
        <http://example.org/analysis/action/1/role/addresser-beneficiaries> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Countries, organisations, budget, participants and priorities per project"@en ;
            lomo:isManifestedIn <http://example.org/dataset/countries-organisations-budget-participants-and-priorities-per-project> ] .

<http://example.org/agent/european-commission-beneficiaries> rdfs:label "European Commission; Beneficiaries"@en .

<http://example.org/dataset/countries-organisations-budget-participants-and-priorities-per-project> a dcat:Dataset ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/463/cod/doc/com/COM_2025_463/FINAL/eng/art_1>,
        <https://data.europa.eu/eli/dl/proc/2025/463/cod/doc/com/COM_2025_463/FINAL/eng/art_3>,
        <https://data.europa.eu/eli/dl/proc/2025/463/cod/doc/com/COM_2025_463/FINAL/eng/art_4> ;
    lomo:manifests [ a lomo:ActionResult ;
            rdfs:label "Countries, organisations, budget, participants and priorities per project"@en ] ;
    dcterms:conformsTo <http://example.org/standard/commission-monitoring-and-reporting-tools-and-databases-including-egrants> ;
    dcterms:title "Countries, organisations, budget, participants and priorities per project"@en .

