<http://example.org/agent/eppo-olaf-eurofisc> rdfs:label "EPPO, OLAF, Eurofisc"@en .

<http://example.org/analysis/action/1> a lomo:Action ;
    rdfs:label "any information on cross-border VAT fraud"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "Spontaneous or upon request"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/685/cod/doc/com/COM_2025_685/FINAL/eng/art_36> ;
    lomo:hasAgentRole <http://example.org/analysis/action/1/role/addressee-eppo-olaf>,
        <http://example.org/analysis/action/1/role/addresser-eurofisc> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "any information on cross-border VAT fraud"@en ;
            lomo:isManifestedIn <http://example.org/dataset/any-information-on-cross-border-vat-fraud> ] .

