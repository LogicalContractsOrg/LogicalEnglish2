<http://example.org/analysis/action/2> a lomo:Action ;
    rdfs:label "Statistical data on seized firearms"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:frequency "P1M"^^xsd:duration ;
            lomo:hasFunction tf:deadline ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "at least monthly"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/102/cod/doc/com/COM_2026_102/FINAL/eng/art_17> ;
    lomo:hasAgentRole <http://example.org/analysis/action/2/role/addressee-europol>,
        <http://example.org/analysis/action/2/role/addresser-member-states> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Statistical data on seized firearms"@en ;
            lomo:isManifestedIn <http://example.org/dataset/statistical-data-on-seized-firearms> ] .

<http://example.org/analysis/assessment/1> a cav:Assessment ;
    cav:assesses <http://example.org/analysis/description/2>,
        <http://example.org/analysis/description/3> ;
    cav:resultsIn <http://example.org/analysis/assessment/1/1/measure>,
        <http://example.org/analysis/assessment/1/2/barrier>,
        <http://example.org/analysis/assessment/1/2/measure>,
        <http://example.org/analysis/assessment/1/3/measure>,
        <http://example.org/analysis/assessment/1/4/measure> ;
    m8g:isProvidedBy <http://publications.europa.eu/resource/authority/corporate-body/COM> .

<http://example.org/analysis/description/1> a lomo:LegalRule ;
    rdfs:label "Article 15(1)"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ;
            lomo:temporalLabel "constant"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/102/cod/doc/com/COM_2026_102/FINAL/eng/art_15/par_1> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data> ;
    lomo:involvesProcess <http://example.org/process/management-of-registries-and-gathering-of-information> ;
    lomo:produces <http://example.org/analysis/action/1>,
        <http://example.org/analysis/description/1/action> ;
    lomo:references <http://example.org/dataset/information-on-firearms-gathered-by-the-national-firearms-focal-points> ;
    dcterms:description "The National Firearms Focal Point shall gather, analyse, and exchange relevant information and ensure the collection and recording of all information regarding seizures of firearms linked to criminal offences."@en .

<http://example.org/analysis/description/4> a lomo:LegalRule ;
    rdfs:label "Article 21"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/102/cod/doc/com/COM_2026_102/FINAL/eng/art_21> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data> ;
    lomo:involvesProcess <http://example.org/process/gathering-of-data-on-implementation-reporting-about-the-data> ;
    lomo:produces <http://example.org/analysis/action/4>,
        <http://example.org/analysis/description/4/action> ;
    lomo:references <http://example.org/dataset/commission-report-assessing-the-added-value-of-the-directive-with-regard-to-combating-firearms-trafficking-and-other-firearms-related-criminal-offences> ;
    dcterms:description "Reporting obligations for the Commission towards the European parliament and the Council based on data received from the Member States"@en .

<http://example.org/analysis/solution/1> a dctype:Software ;
    rdfs:label "Digital system for the collection, development, productions, and dissemination of anonymised statistical data"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/102/cod/doc/com/COM_2026_102/FINAL/eng/art_18> ;
    lomo:hasCapability "Member States can decide which digital solution is used to gather these statistics and how they are published." ;
    dcterms:publisher <http://example.org/agent/member-states-mainly-judicial-authorities> ;
    dcterms:title "Digital system for the collection, development, productions, and dissemination of anonymised statistical data"@en .

<http://example.org/analysis/solution/2> a dctype:Software ;
    rdfs:label "Digital solution for the registration of seized firearms"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/102/cod/doc/com/COM_2026_102/FINAL/eng/art_17> ;
    lomo:hasCapability "Member States can decide which digital solution is used to register data on seized firearms." ;
    dcterms:publisher <http://example.org/agent/member-states-mainly-law-enforcement> ;
    dcterms:title "Digital solution for the registration of seized firearms"@en .

<http://example.org/agent/different-national-stakeholders-such-as-justice-police-customs-etc> rdfs:label "Different national stakeholders such as justice, police, customs etc."@en .

<http://example.org/agent/european-parliament-and-council> rdfs:label "European Parliament and Council"@en .

<http://example.org/agent/europol> rdfs:label "Europol"@en .

<http://example.org/agent/member-states-and-european-commission> rdfs:label "Member States and European Commission"@en .

<http://example.org/agent/national-firearms-focal-point> rdfs:label "National Firearms Focal Point"@en .

<http://example.org/analysis/action/1> a lomo:Action ;
    rdfs:label "Information on firearms gathered by the National Firearms Focal Point"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "National Firearms Focal Points need to ensure that they have the complete picture of the firearms threat it the Member States"@en ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:deadline ;
            lomo:temporalLabel "constant"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/102/cod/doc/com/COM_2026_102/FINAL/eng/art_15/par_1> ;
    lomo:hasAgentRole <http://example.org/analysis/action/1/role/addressee-national-firearms-focal-point>,
        <http://example.org/analysis/action/1/role/addresser-different-national-stakeholders-such-as-justice-police-customs-etc> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Information on firearms gathered by the National Firearms Focal Point"@en ;
            lomo:isManifestedIn <http://example.org/dataset/information-on-firearms-gathered-by-the-national-firearms-focal-point> ] .

<http://example.org/analysis/action/1/role/addressee-national-firearms-focal-point> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/national-firearms-focal-point> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/analysis/action/1/role/addresser-different-national-stakeholders-such-as-justice-police-customs-etc> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/different-national-stakeholders-such-as-justice-police-customs-etc> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSER> .

<http://example.org/analysis/action/2/role/addressee-europol> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/europol> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/analysis/action/2/role/addresser-member-states> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/member-states> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSER> .

<http://example.org/analysis/action/3> a lomo:Action ;
    rdfs:label "Statistical data (of the five preceding years on the criminal offences referred to in Articles 3 and 4"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "By every 31 July of the 6th year following transposition"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/102/cod/doc/com/COM_2026_102/FINAL/eng/art_18> ;
    lomo:hasAgentRole <http://example.org/analysis/action/3/role/addressee-european-commission>,
        <http://example.org/analysis/action/3/role/addresser-member-states> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Statistical data (of the five preceding years on the criminal offences referred to in Articles 3 and 4"@en ;
            lomo:isManifestedIn <http://example.org/dataset/statistical-data-of-the-five-preceding-years-on-the-criminal-offences-referred-to-in-articles-3-and-4> ] .

<http://example.org/analysis/action/3/role/addressee-european-commission> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/european-commission> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/analysis/action/3/role/addresser-member-states> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/member-states> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSER> .

<http://example.org/analysis/action/4> a lomo:Action ;
    rdfs:label "Commission report"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "By 31 October of every six years following transposition"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/102/cod/doc/com/COM_2026_102/FINAL/eng/art_21> ;
    lomo:hasAgentRole <http://example.org/analysis/action/4/role/addressee-european-parliament-and-council>,
