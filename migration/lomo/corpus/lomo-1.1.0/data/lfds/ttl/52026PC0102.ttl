<http://example.org/analysis/action/4/role/addressee-european-parliament-and-council> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/european-parliament-and-council> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/analysis/action/4/role/addresser-european-commission> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/european-commission> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSER> .

<http://example.org/analysis/assessment/1/1/measure> a cav:Statement ;
    cav:interpretation iac:InterpretationPositive ;
    cav:judgement """-GDPR
-Europol Regulation
-Cybersecurity"""@en ;
    cav:type iac:StatementTypeAlignmentMeasure ;
    dcterms:description "Assess the alignment with existing digital and sectorial policiesPlease list the applicable digital and sectorial policies identified."@en ;
    dcterms:title "Exchange of seizure data"@en .

<http://example.org/analysis/assessment/1/2/barrier> a cav:Statement ;
    cav:interpretation iac:InterpretationNegative ;
    cav:judgement "However, some Member States already have their own national seizure databases. Europol will have to facilitate some kind of interconnection or bulk uploading of data coming from the national databases towards TRAFIC"@en ;
    cav:type iac:StatementTypeOrganisationBarrier ;
    dcterms:description "Assess the organisational measures for a smooth cross-border digital public services deliveryPlease list the governance measures foreseen"@en ;
    dcterms:title "Exchange of seizure data"@en .

<http://example.org/analysis/assessment/1/2/measure> a cav:Statement ;
    cav:interpretation iac:InterpretationPositive ;
    cav:judgement "Europol has already acquired a database called TRAFIC and has offered the direct use of this database to all Member States."@en ;
    cav:type iac:StatementTypeOrganisationMeasure ;
    dcterms:description "Assess the organisational measures for a smooth cross-border digital public services deliveryPlease list the governance measures foreseen"@en ;
    dcterms:title "Exchange of seizure data"@en .

<http://example.org/analysis/assessment/1/3/measure> a cav:Statement ;
    cav:interpretation iac:InterpretationPositive ;
    cav:judgement "Annex I establishes a detailed minimum dataset which includes definitions of the terms."@en ;
    cav:type iac:StatementTypeSharedMeasure ;
    dcterms:description "Assess the measures taken to ensure a shared understanding of dataPlease list such measures"@en ;
    dcterms:title "Exchange of seizure data"@en .

<http://example.org/analysis/assessment/1/4/measure> a cav:Statement ;
    cav:interpretation iac:InterpretationPositive ;
    cav:judgement """Annex I establishes a detailed minimum dataset which includes definitions of the terms.
The Digital Justice 2030 initiative announced the creation of a toolbox of IT tools for use in justice systems."""@en ;
    cav:type iac:StatementTypeStandardsMeasure ;
    dcterms:description "Assess the use of commonly agreed open technical specifications and standardsPlease list such measures"@en ;
    dcterms:title "Exchange of seizure data"@en .

<http://example.org/analysis/description/1/action> a lomo:Action ;
    lomo:hasAgentRole <http://example.org/analysis/description/1/action/role/addressee-member-states> .

<http://example.org/analysis/description/1/action/role/addressee-member-states> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/member-states> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/analysis/description/2> a iopa:BindingRequirement,
        lomo:LegalRule ;
    rdfs:label "Article 17(1)"@en ;
    iopa:affects <http://example.org/analysis/interop/2> ;
    cav:valueDescription "Article 17 establishes that Member States shall register seized firearms according to a minimum dataset. This minimum dataset is described in the annex of the proposal."@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/102/cod/doc/com/COM_2026_102/FINAL/eng/art_17/par_1> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data> ;
    lomo:involvesProcess <http://example.org/process/management-of-registries> ;
    lomo:produces <http://example.org/analysis/description/2/action> ;
    lomo:references <http://example.org/dataset/registration-of-seized-firearms> ;
    dcterms:description "Article 17 establishes that Member States shall register seized firearms according to a minimum dataset. This minimum dataset is described in the annex of the proposal."@en ;
    dcterms:relation <http://example.org/ie-solution/the-gathering-of-seizure-data-will-require-coordination-within-a-member-state-but-not-cross-border-member-states-do-need-to-ensure-that-the-data-can-be-extracted-from-their-system-and-send-to-europol-every-month> .

<http://example.org/analysis/description/2/action> a lomo:Action ;
    lomo:hasAgentRole <http://example.org/analysis/description/2/action/role/addressee-member-states> .

<http://example.org/analysis/description/2/action/role/addressee-member-states> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/member-states> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/analysis/description/3> a iopa:BindingRequirement,
        lomo:LegalRule ;
    rdfs:label "Article 18"@en ;
    iopa:affects <http://example.org/analysis/interop/1> ;
    cav:valueDescription "Article 18 requires Member States to gather, in a digital manner, statistical data on the offences referred to in Articles 3 and 4. The data that Member States have to gather is established by Article 18(2). Member States shall ensure that a digital system is in place for the collection, development, production and dissemination of anonymised statistical data on the criminal offences."@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/102/cod/doc/com/COM_2026_102/FINAL/eng/art_18> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data>,
        <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> ;
    lomo:involvesProcess <http://example.org/process/management-of-registries> ;
    lomo:produces <http://example.org/analysis/action/3>,
        <http://example.org/analysis/description/3/action> ;
    lomo:references <http://example.org/dataset/statistical-data> ;
    dcterms:description "Article 18 requires Member States to gather, in a digital manner, statistical data on the offences referred to in Articles 3 and 4. The data that Member States have to gather is established by Article 18(2). Member States shall ensure that a digital system is in place for the collection, development, production and dissemination of anonymised statistical data on the criminal offences."@en ;
    dcterms:relation <http://example.org/ie-solution/in-order-to-gather-the-required-data-there-is-no-clear-need-for-interactions-between-member-states-or-across-eu-entities-however-there-will-be-a-need-to-establish-interactions-within-a-member-state-in-order-to-gather-all-necessary-data> .

<http://example.org/analysis/description/3/action> a lomo:Action ;
    lomo:hasAgentRole <http://example.org/analysis/description/3/action/role/addressee-member-states> .

<http://example.org/analysis/description/3/action/role/addressee-member-states> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/member-states> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/analysis/description/4/action> a lomo:Action ;
    lomo:hasAgentRole <http://example.org/analysis/description/4/action/role/addressee-member-states-and-european-commission> .

<http://example.org/analysis/description/4/action/role/addressee-member-states-and-european-commission> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/member-states-and-european-commission> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/analysis/interop/1> a cpsv:PublicService ;
    rdfs:label "Member States - law courts"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/102/cod/doc/com/COM_2026_102/FINAL/eng/art_18> ;
    dcterms:description "gathering statistics on all offences included in the initiative"@en ;
