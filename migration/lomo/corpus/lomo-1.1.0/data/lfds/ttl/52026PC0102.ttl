    dcterms:title "Member States - law courts"@en .

<http://example.org/analysis/interop/2> a cpsv:PublicService ;
    rdfs:label "Member States - police services"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/102/cod/doc/com/COM_2026_102/FINAL/eng/art_17> ;
    dcterms:description "registering all seized firearms according to the minimum dataset"@en ;
    dcterms:identifier "interop/2" ;
