    dcterms:title "Member States - police services"@en .

<http://example.org/dataset/commission-report> a dcat:Dataset ;
    lomo:manifests [ a lomo:ActionResult ;
            rdfs:label "Commission report"@en ] ;
    dcterms:title "Commission report"@en .

<http://example.org/dataset/commission-report-assessing-the-added-value-of-the-directive-with-regard-to-combating-firearms-trafficking-and-other-firearms-related-criminal-offences> a dcat:Dataset ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/102/cod/doc/com/COM_2026_102/FINAL/eng/art_21> ;
