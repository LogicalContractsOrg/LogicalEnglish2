<http://example.org/analysis/action/6> a lomo:Action ;
    rdfs:label "European statistics cover all key EU policy areas – Eurostat receives data in more than 2000 datasets and metadata sets and disseminates more than 7500 datasets."@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "According to legal requirements laid down in the EUacquison European statistics.The data transmissions from the Member States to Eurostat are almost exclusively based on legal requirements laid down in the EU acquis on European statistics, as well as some voluntary data transmissions"@en ] ;
    lomo:hasAgentRole <http://example.org/analysis/action/6/role/addressee-businesses-and-financial-markets>,
        <http://example.org/analysis/action/6/role/addressee-citizens>,
        <http://example.org/analysis/action/6/role/addressee-eurostat-which-validates-the-data-and-disseminates-them-as-european-statistics-to-its-users-ie-policymakers-eu-institutions-and-services>,
        <http://example.org/analysis/action/6/role/addressee-media>,
        <http://example.org/analysis/action/6/role/addressee-researchers-and-academia>,
        <http://example.org/analysis/action/6/role/addresser-authorised-third-parties-eg-international-organisations>,
        <http://example.org/analysis/action/6/role/addresser-businesses>,
        <http://example.org/analysis/action/6/role/addresser-consumerscitizens>,
        <http://example.org/analysis/action/6/role/addresser-efta-countries-enlargement-countries>,
        <http://example.org/analysis/action/6/role/addresser-eu-institutions-authorities-bodies>,
        <http://example.org/analysis/action/6/role/addresser-statistical-authorities-of-member-states>,
        <http://example.org/analysis/action/6/role/addresser-third-countries> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "European statistics cover all key EU policy areas – Eurostat receives data in more than 2000 datasets and metadata sets and disseminates more than 7500 datasets."@en ;
            lomo:isManifestedIn <http://example.org/dataset/european-statistics-cover-all-key-eu-policy-areas-eurostat-receives-data-in-more-than-2000-datasets-and-metadata-sets-and-disseminates-more-than-7500-datasets> ] .

