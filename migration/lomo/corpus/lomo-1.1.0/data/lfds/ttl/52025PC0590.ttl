<http://example.org/analysis/action/1> a lomo:Action ;
    rdfs:label "Business and bank data from registers, company information, beneficial ownership data from registers. Common data dictionaries on reporting and disclosure requirements. Financial data and indicators."@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "Legal obligations95"@en ] ;
    lomo:hasAgentRole <http://example.org/analysis/action/1/role/addressee-national-authorities-european-commission-and-other-european-bodies-and-authorities>,
        <http://example.org/analysis/action/1/role/addresser-national-authorities-businesses-consumers-citizens-investors-european-commission-and-other-european-bodies-and-authorities> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Business and bank data from registers, company information, beneficial ownership data from registers. Common data dictionaries on reporting and disclosure requirements. Financial data and indicators."@en ;
            lomo:isManifestedIn <http://example.org/dataset/business-and-bank-data-from-registers-company-information-beneficial-ownership-data-from-registers-common-data-dictionaries-on-reporting-and-disclosure-requirements-financial-data-and-indicators> ] .

