    lomo:produces <http://example.org/analysis/action/2>,
        <http://example.org/analysis/description/2/action> ;
    lomo:references <http://example.org/dataset/common-form-for-return-containing-the-main-elements-of-the-return-decision-european-return-order> ;
    dcterms:description "Obligation to make available in the Schengen Information System the European Return Order containing the main elements of the return decision."@en ;
    dcterms:relation <http://example.org/ie-solution/the-interoperability-of-the-digital-case-management-system-referred-to-in-the-present-initiative-will-be-detailed-in-a-separate-initiative-on-digitalisation-of-case-management-in-the-area-of-return-readmission-and-reintegration> .

<http://example.org/analysis/description/2/action> a lomo:Action ;
    lomo:hasAgentRole <http://example.org/analysis/description/2/action/role/addressee-member-states> .

