    lomo:forAgent <http://example.org/agent/member-states> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/analysis/description/2> a iopa:BindingRequirement,
        lomo:LegalRule ;
    rdfs:label "Article 7(7)"@en ;
    iopa:affects <http://example.org/analysis/interop/1> ;
    cav:valueDescription "Obligation to make available in the Schengen Information System the European Return Order containing the main elements of the return decision."@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/0/cod/doc/com/COM_2025_0/FINAL/eng/art_7/par_7> ;
