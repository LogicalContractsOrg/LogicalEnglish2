<http://example.org/analysis/description/3> a iopa:BindingRequirement,
        lomo:LegalRule ;
    rdfs:label "Article 21(5)"@en ;
    iopa:affects <http://example.org/analysis/interop/1> ;
    cav:valueDescription "Member States must either establish in national law the method of communication with the third-country nationals and the point in time at which the communication is considered received by and notified to the third-country national or make use of digital system developed and/or supported by the EU for the purpose of such communication."@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/0/cod/doc/com/COM_2025_0/FINAL/eng/art_21/par_5> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/notification> ;
    lomo:produces <http://example.org/analysis/action/3>,
        <http://example.org/analysis/description/3/action> ;
    lomo:references <http://example.org/dataset/data-communicated-between-competent-authorities-and-third-country-nationals> ;
    dcterms:description "Member States must either establish in national law the method of communication with the third-country nationals and the point in time at which the communication is considered received by and notified to the third-country national or make use of digital system developed and/or supported by the EU for the purpose of such communication."@en ;
    dcterms:relation <http://example.org/ie-solution/the-interoperability-of-the-digital-case-management-system-referred-to-in-the-present-initiative-will-be-detailed-in-a-separate-initiative-on-digitalisation-of-case-management-in-the-area-of-return-readmission-and-reintegration> .

<http://example.org/analysis/description/3/action> a lomo:Action ;
    lomo:hasAgentRole <http://example.org/analysis/description/3/action/role/addressee-member-states> .

<http://example.org/analysis/description/3/action/role/addressee-member-states> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/member-states> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/analysis/description/4> a iopa:BindingRequirement,
        lomo:LegalRule ;
    rdfs:label "Article 36(4)"@en ;
    iopa:affects <http://example.org/analysis/interop/1> ;
    cav:valueDescription "Information about the outcome of the request for confirmation of nationality and the travel document obtained must be uploaded in the Schengen Information System by the competent authority concerned. Such information and travel document must be made available to the competent authorities of other Member States upon request."@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/0/cod/doc/com/COM_2025_0/FINAL/eng/art_36/par_4> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/recording-of-data> ;
    lomo:produces <http://example.org/analysis/action/4>,
        <http://example.org/analysis/description/4/action> ;
    lomo:references <http://example.org/dataset/information-about-the-outcome-of-the-request-for-confirmation-of-nationality-and-the-travel-document> ;
    dcterms:description "Information about the outcome of the request for confirmation of nationality and the travel document obtained must be uploaded in the Schengen Information System by the competent authority concerned. Such information and travel document must be made available to the competent authorities of other Member States upon request."@en ;
    dcterms:relation <http://example.org/ie-solution/the-interoperability-of-the-digital-case-management-system-referred-to-in-the-present-initiative-will-be-detailed-in-a-separate-initiative-on-digitalisation-of-case-management-in-the-area-of-return-readmission-and-reintegration> .

