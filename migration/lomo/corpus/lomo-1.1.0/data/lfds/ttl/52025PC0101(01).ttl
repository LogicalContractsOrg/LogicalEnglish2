<http://example.org/analysis/assessment/1/1/barrier> a cav:Statement ;
    cav:interpretation iac:InterpretationPositive ;
    cav:judgement "No remaining barriers."@en ;
    cav:type iac:StatementTypeAlignmentBarrier ;
    dcterms:description "Alignment with existing digital and sectorial policies.The interoperability of the digital case management system referred to in the present initiative will be addressed in a separate initiative on digitalisation in the area of return, readmission and reintegration."@en ;
    dcterms:title "Digital systems for managing return, readmission and reintegration of third-country nationals."@en .

<http://example.org/analysis/assessment/1/2/barrier> a cav:Statement ;
    cav:interpretation iac:InterpretationPositive ;
    cav:judgement "No remaining barriers."@en ;
    cav:type iac:StatementTypeOrganisationBarrier ;
    dcterms:description "Organisational measures for a smooth cross-border digital public services delivery.The governance of the digital case management system referred to in the present initiative will be addressed in a separate initiative on digitalisation in the area of return, readmission and reintegration."@en ;
    dcterms:title "Digital systems for managing return, readmission and reintegration of third-country nationals."@en .

<http://example.org/analysis/assessment/1/3/barrier> a cav:Statement ;
    cav:interpretation iac:InterpretationPositive ;
    cav:judgement "No remaining barriers."@en ;
    cav:type iac:StatementTypeSharedBarrier ;
    dcterms:description "Measures taken to ensure a shared understanding of the data.The sharing and reuse of data processed in the digital case management system referred to in the present initiative will be addressed in a separate initiative on digitalisation in the area of return, readmission and reintegration."@en ;
    dcterms:title "Digital systems for managing return, readmission and reintegration of third-country nationals."@en .

<http://example.org/analysis/assessment/1/4/barrier> a cav:Statement ;
    cav:interpretation iac:InterpretationPositive ;
    cav:judgement "No remaining barriers."@en ;
    cav:type iac:StatementTypeStandardsBarrier ;
    dcterms:description "Use of commonly agreed open technical specifications and standards."@en ;
    dcterms:title "Digital systems for managing return, readmission and reintegration of third-country nationals."@en .

<http://example.org/analysis/description/1> a iopa:BindingRequirement,
        lomo:LegalRule ;
    rdfs:label "Article 42(1)(d)"@en ;
    iopa:affects <http://example.org/analysis/interop/1> ;
    cav:valueDescription "The common Union system for returns must include digital systems for managing return, readmission and reintegration of third-country nationals."@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/0/cod/doc/com/COM_2025_0/FINAL/eng/art_42/par_1> ;
    lomo:involvesProcess <http://example.org/process/establishment-of-digital-systems> ;
    lomo:produces <http://example.org/analysis/action/1>,
        <http://example.org/analysis/description/1/action> ;
    lomo:references <http://example.org/dataset/data-necessary-for-the-application-of-the-present-initiative-aiming-to-establish-a-common-eu-system-for-the-return-of-third-country-nationals-staying-illegally-in-the-eu> ;
    dcterms:description "The common Union system for returns must include digital systems for managing return, readmission and reintegration of third-country nationals."@en ;
    dcterms:relation <http://example.org/ie-solution/the-interoperability-of-the-digital-case-management-system-referred-to-in-the-present-initiative-will-be-detailed-in-a-separate-initiative-on-digitalisation-of-case-management-in-the-area-of-return-readmission-and-reintegration> .

