<http://example.org/analysis/action/2> a lomo:Action ;
    rdfs:label "Data flows between Commission and Council in relation to the designation of third countries posing cybersecurity concerns"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "Article 100Commission verification of the threat posed by a third country"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/11/cod/doc/com/COM_2026_11/FINAL/eng/art_100> ;
    lomo:hasAgentRole <http://example.org/analysis/action/2/role/addressee-council>,
        <http://example.org/analysis/action/2/role/addresser-commission> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Data flows between Commission and Council in relation to the designation of third countries posing cybersecurity concerns"@en ;
            lomo:isManifestedIn <http://example.org/dataset/data-flows-between-commission-and-council-in-relation-to-the-designation-of-third-countries-posing-cybersecurity-concerns> ] .

<http://example.org/analysis/action/3> a lomo:Action ;
    rdfs:label "Data flows between Commission and Member States in relation to mitigation measures in case of exceptional circumstances"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "Exceptional circumstances"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/11/cod/doc/com/COM_2026_11/FINAL/eng/art_103/par_6> ;
    lomo:hasAgentRole <http://example.org/analysis/action/3/role/addressee-member-states>,
        <http://example.org/analysis/action/3/role/addresser-commission> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Data flows between Commission and Member States in relation to mitigation measures in case of exceptional circumstances"@en ;
            lomo:isManifestedIn <http://example.org/dataset/data-flows-between-commission-and-member-states-in-relation-to-mitigation-measures-in-case-of-exceptional-circumstances> ] .

