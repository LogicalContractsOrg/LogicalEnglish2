<http://example.org/analysis/description/21> a iopa:BindingRequirement,
        lomo:LegalRule ;
    rdfs:label "Article 10(4)(e)"@en ;
    iopa:affects <http://example.org/analysis/interop/3>,
        <http://example.org/analysis/interop/4> ;
