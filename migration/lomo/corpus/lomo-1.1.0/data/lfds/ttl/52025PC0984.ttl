<http://example.org/analysis/description/5> a iopa:BindingRequirement,
        lomo:LegalRule ;
    rdfs:label "Article 10(4)"@en ;
    iopa:affects <http://example.org/analysis/interop/2> ;
    cav:valueDescription "Member States shall ensure that environmental assessment and screening procedures are fully digitalized and enable the re-use of data and documents held by public authorities at national level as well as the sharing of such data between Member States, developers and the public, in a seamless manner. Where appropriate, such procedures shall be interoperable with European Digital Identity Wallets and European Business Wallets.] (after twenty four months of the entry into force)."@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ;
            lomo:temporalLabel "As required"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/984/cod/doc/com/COM_2025_984/FINAL/eng/art_10/par_4> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data>,
        <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions>,
        <http://data.europa.eu/leg/digital-dimensions/DigitalPublicService> ;
    lomo:involvesProcess <http://example.org/process/process-digitalisation-cross-border-exchange-automation-governance> ;
    lomo:produces <http://example.org/analysis/action/4>,
        <http://example.org/analysis/description/5/action> ;
    lomo:references <http://example.org/dataset/data-enabling-cross-border-exchange-and-fully-digitalised-procedures-data-used-by-automated-systems-where-applicable> ;
    dcterms:description "Member States shall ensure that environmental assessment and screening procedures are fully digitalized and enable the re-use of data and documents held by public authorities at national level as well as the sharing of such data between Member States, developers and the public, in a seamless manner. Where appropriate, such procedures shall be interoperable with European Digital Identity Wallets and European Business Wallets.] (after twenty four months of the entry into force)."@en ;
    dcterms:relation <http://example.org/ie-solution/not-specified> .

<http://example.org/analysis/description/5/action> a lomo:Action ;
    lomo:hasAgentRole <http://example.org/analysis/description/5/action/role/addressee-member-states-competent-authorities> .

<http://example.org/analysis/description/5/action/role/addressee-member-states-competent-authorities> a lomo:AgentRole ;
