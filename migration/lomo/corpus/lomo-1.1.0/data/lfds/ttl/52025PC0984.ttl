<http://example.org/analysis/assessment/1> a cav:Assessment ;
    cav:assesses <http://example.org/analysis/description/1>,
        <http://example.org/analysis/description/5>,
        <http://example.org/analysis/description/7> ;
    cav:resultsIn <http://example.org/analysis/assessment/1/1/barrier>,
