<http://example.org/analysis/description/1> a iopa:BindingRequirement,
        lomo:LegalRule ;
    rdfs:label "Article 3(3)"@en ;
    iopa:affects <http://example.org/analysis/interop/1> ;
    cav:valueDescription "Member States shall provide tools to help developers identify the appropriate established or designated contact point on the online portal set up in accordance with Article 10 ."@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/984/cod/doc/com/COM_2025_984/FINAL/eng/art_3/par_3> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/DigitalPublicService>,
        <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> ;
    lomo:involvesProcess tc:1 ;
    lomo:produces <http://example.org/analysis/description/1/action> ;
    dcterms:description "Member States shall provide tools to help developers identify the appropriate established or designated contact point on the online portal set up in accordance with Article 10 ."@en ;
    dcterms:relation <http://example.org/ie-solution/not-specified> .

