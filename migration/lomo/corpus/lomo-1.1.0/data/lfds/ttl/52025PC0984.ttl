<http://example.org/analysis/action/1> a lomo:Action ;
    rdfs:label "Developer submissions (electronic)"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:deadline ;
            lomo:temporalLabel "Per case"@en ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "Filing of information for an assessment"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/984/cod/doc/com/COM_2025_984/FINAL/eng/art_10/par_1> ;
    lomo:hasAgentRole <http://example.org/analysis/action/1/role/addressee-competent-authorities-single-point-of-contact>,
        <http://example.org/analysis/action/1/role/addresser-developers> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Developer submissions (electronic)"@en ;
            lomo:isManifestedIn <http://example.org/dataset/developer-submissions-electronic> ] .

<http://example.org/analysis/action/1/role/addressee-competent-authorities-single-point-of-contact> a lomo:AgentRole ;
