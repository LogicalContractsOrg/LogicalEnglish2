<http://example.org/analysis/description/7> a iopa:BindingRequirement,
        lomo:LegalRule ;
    rdfs:label "Article 10(2)(b)(5)"@en ;
    iopa:affects <http://example.org/analysis/interop/1> ;
    cav:valueDescription "Member States shall provide developers and the public with access to the information on dispute settlement as regards plans, programmes or projects, online and in a centralised and easily accessible manner."@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ;
            lomo:temporalLabel "Ongoing"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/984/cod/doc/com/COM_2025_984/FINAL/eng/art_10/par_2> ;
    lomo:involvesProcess <http://example.org/process/access-to-information-redress-pathways> ;
    lomo:produces <http://example.org/analysis/action/2>,
        <http://example.org/analysis/description/7/action> ;
    lomo:references <http://example.org/dataset/information-on-single-points-of-contact-and-on-the-environmental-assessments-procedures-including-dispute-settlement-procedures> ;
    dcterms:description "Member States shall provide developers and the public with access to the information on dispute settlement as regards plans, programmes or projects, online and in a centralised and easily accessible manner."@en ;
