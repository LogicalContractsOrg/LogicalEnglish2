@prefix cav: <http://data.europa.eu/2sa/cav#> .
@prefix cpsv: <http://purl.org/vocab/cpsv#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dctype: <http://purl.org/dc/dcmitype/> .
@prefix dd: <http://data.europa.eu/leg/digital-dimensions/> .
@prefix iac: <http://data.europa.eu/leg/interop-assessment#> .
@prefix iopa: <http://data.europa.eu/2qy/iopa#> .
@prefix lomo: <http://data.europa.eu/leg/lomo#> .
@prefix m8g: <http://data.europa.eu/m8g/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<http://example.org/analysis/action/1> a lomo:Action ;
    rdfs:label "Data related to the communication of pure electric vehicles (PEV) and off-vehicle charging hybrid electric vehicles (OVC-HEV) with the recharging infrastructure, the electricity grid and the stationary power systems capable of supporting smart and bidirectional charging functionalities"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/993/cod/doc/com/COM_2025_993/FINAL/eng/art_2> ;
    lomo:hasAgentRole <http://example.org/analysis/action/1/role/addressee-vehicle-manufacturersgrid-operatorsother-economic-operators>,
        <http://example.org/analysis/action/1/role/addresser-vehicle-manufacturersgrid-operatorsother-economic-operators> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Data related to the communication of pure electric vehicles (PEV) and off-vehicle charging hybrid electric vehicles (OVC-HEV) with the recharging infrastructure, the electricity grid and the stationary power systems capable of supporting smart and bidirectional charging functionalities"@en ;
            lomo:isManifestedIn <http://example.org/dataset/data-related-to-the-communication-of-pure-electric-vehicles-pev-and-off-vehicle-charging-hybrid-electric-vehicles-ovc-hev-with-the-recharging-infrastructure-the-electricity-grid-and-the-stationary-power-systems-capable-of-supporting-smart-and-bidirectional-charging-functionalities> ] .

<http://example.org/analysis/action/2> a lomo:Action ;
    rdfs:label "OBM and OBFCM data"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/993/cod/doc/com/COM_2025_993/FINAL/eng/art_4> ;
    lomo:hasAgentRole <http://example.org/analysis/action/2/role/addressee-european-commissionmember-states>,
        <http://example.org/analysis/action/2/role/addresser-vehicle-manufacturers> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "OBM and OBFCM data"@en ;
            lomo:isManifestedIn <http://example.org/dataset/obm-and-obfcm-data> ] .

<http://example.org/analysis/assessment/1> a cav:Assessment ;
    cav:assesses <http://example.org/analysis/description/2>,
        <http://example.org/analysis/description/3> ;
    cav:resultsIn <http://example.org/analysis/assessment/1/1/barrier>,
        <http://example.org/analysis/assessment/1/2/measure>,
        <http://example.org/analysis/assessment/1/3/measure>,
        <http://example.org/analysis/assessment/1/4/measure> ;
    m8g:isProvidedBy <http://publications.europa.eu/resource/authority/corporate-body/COM> .

<http://example.org/analysis/description/1> a lomo:LegalRule ;
    rdfs:label "Article 2(1)"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/993/cod/doc/com/COM_2025_993/FINAL/eng/art_2/par_1> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/data-exchange> ;
    lomo:produces <http://example.org/analysis/description/1/action> ;
    dcterms:description "The Commission is empowered to adopt delegated acts in accordance with Article 82 amending and supplementing this Regulation to set out technical requirements for pure electric vehicles (PEV) and off-vehicle charging hybrid electric vehicles (OVC-HEV), as regards their communication and hardware interface of those vehicles with the recharging infrastructure, the electricity grid and the stationary power systems capable of supporting smart and bidirectional charging functionalities"@en .

<http://example.org/analysis/solution/1> a dctype:Software ;
    rdfs:label "Harmonised EU-level OBM/OBFCM data infrastructure"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/993/cod/doc/com/COM_2025_993/FINAL/eng/art_4> ;
    lomo:hasCapability "The Commission shall take measures establishing the functionalities." ;
    dcterms:publisher <http://example.org/agent/european-commission> ;
    dcterms:title "Harmonised EU-level OBM/OBFCM data infrastructure"@en .

<http://example.org/agent/european-commissionmember-states> rdfs:label "European CommissionMember States"@en .

<http://example.org/agent/vehicle-manufacturers> rdfs:label "Vehicle Manufacturers"@en .

<http://example.org/analysis/action/1/role/addressee-vehicle-manufacturersgrid-operatorsother-economic-operators> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/vehicle-manufacturersgrid-operatorsother-economic-operators> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/analysis/action/1/role/addresser-vehicle-manufacturersgrid-operatorsother-economic-operators> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/vehicle-manufacturersgrid-operatorsother-economic-operators> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSER> .

<http://example.org/analysis/action/2/role/addressee-european-commissionmember-states> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/european-commissionmember-states> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/analysis/action/2/role/addresser-vehicle-manufacturers> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/vehicle-manufacturers> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSER> .

<http://example.org/analysis/assessment/1/1/barrier> a cav:Statement ;
    cav:interpretation iac:InterpretationPositive ;
    cav:judgement "No remaining barriers."@en ;
    cav:type iac:StatementTypeAlignmentBarrier ;
    dcterms:description "Alignment with existing digital and sectorial policies"@en .

<http://example.org/analysis/assessment/1/2/measure> a cav:Statement ;
    cav:interpretation iac:InterpretationPositive ;
    cav:judgement "Shall be established in the measures."@en ;
    cav:type iac:StatementTypeOrganisationMeasure ;
    dcterms:description "Organisational measures for a smooth cross-border digital public services delivery"@en .

<http://example.org/analysis/assessment/1/3/measure> a cav:Statement ;
    cav:interpretation iac:InterpretationPositive ;
    cav:judgement "Shall be established in the measures."@en ;
    cav:type iac:StatementTypeSharedMeasure ;
    dcterms:description "Measures taken to ensure a shared understanding of the data"@en .

<http://example.org/analysis/assessment/1/4/measure> a cav:Statement ;
    cav:interpretation iac:InterpretationPositive ;
    cav:judgement "Shall be established in the measures."@en ;
    cav:type iac:StatementTypeStandardsMeasure ;
    dcterms:description "Use of commonly agreed open technical specifications and standards"@en .

<http://example.org/analysis/description/1/action> a lomo:Action ;
    lomo:hasAgentRole <http://example.org/analysis/description/1/action/role/addressee-economic-operators>,
        <http://example.org/analysis/description/1/action/role/addressee-european-commission>,
        <http://example.org/analysis/description/1/action/role/addressee-national-authorities> .

<http://example.org/analysis/description/1/action/role/addressee-economic-operators> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/economic-operators> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/analysis/description/1/action/role/addressee-european-commission> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/european-commission> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/analysis/description/1/action/role/addressee-national-authorities> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/national-authorities> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/analysis/description/2> a iopa:BindingRequirement,
        lomo:LegalRule ;
    rdfs:label "Article 4(1)"@en ;
    iopa:affects <http://example.org/analysis/interop/1> ;
    cav:valueDescription "The Commission shall take measures, in cooperation with Member States when necessary, to ensure that OBM and OBFCM data are received, processed and stored effectively in a harmonised manner."@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/993/cod/doc/com/COM_2025_993/FINAL/eng/art_4/par_1> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/data-exchange> ;
    lomo:produces <http://example.org/analysis/description/2/action> ;
    dcterms:description "The Commission shall take measures, in cooperation with Member States when necessary, to ensure that OBM and OBFCM data are received, processed and stored effectively in a harmonised manner."@en .

<http://example.org/analysis/description/2/action> a lomo:Action ;
    lomo:hasAgentRole <http://example.org/analysis/description/2/action/role/addressee-economic-operators>,
        <http://example.org/analysis/description/2/action/role/addressee-european-commission>,
        <http://example.org/analysis/description/2/action/role/addressee-national-authorities> .

<http://example.org/analysis/description/2/action/role/addressee-economic-operators> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/economic-operators> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/analysis/description/2/action/role/addressee-european-commission> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/european-commission> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/analysis/description/2/action/role/addressee-national-authorities> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/national-authorities> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/analysis/description/3> a iopa:BindingRequirement,
        lomo:LegalRule ;
    rdfs:label "Article 4(2)"@en ;
    iopa:affects <http://example.org/analysis/interop/1> ;
    cav:valueDescription "the methods, measures, requirements and tests, including compliance thresholds, to ensure performance of OBFCM devices, OBD and OBM systems and the sensors of such devices and systems, as well as off-board communication of data recorded by such devices and systems"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/993/cod/doc/com/COM_2025_993/FINAL/eng/art_4/par_2> ;
    lomo:hasCategory dd:Data ;
    lomo:produces <http://example.org/analysis/description/3/action> ;
    dcterms:description "the methods, measures, requirements and tests, including compliance thresholds, to ensure performance of OBFCM devices, OBD and OBM systems and the sensors of such devices and systems, as well as off-board communication of data recorded by such devices and systems"@en .

<http://example.org/analysis/description/3/action> a lomo:Action ;
    lomo:hasAgentRole <http://example.org/analysis/description/3/action/role/addressee-economic-operators>,
        <http://example.org/analysis/description/3/action/role/addressee-european-commission>,
        <http://example.org/analysis/description/3/action/role/addressee-national-authorities> .

<http://example.org/analysis/description/3/action/role/addressee-economic-operators> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/economic-operators> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/analysis/description/3/action/role/addressee-european-commission> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/european-commission> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/analysis/description/3/action/role/addressee-national-authorities> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/national-authorities> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/dataset/data-related-to-the-communication-of-pure-electric-vehicles-pev-and-off-vehicle-charging-hybrid-electric-vehicles-ovc-hev-with-the-recharging-infrastructure-the-electricity-grid-and-the-stationary-power-systems-capable-of-supporting-smart-and-bidirectional-charging-functionalities> a dcat:Dataset ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/993/cod/doc/com/COM_2025_993/FINAL/eng/art_2> ;
    lomo:manifests [ a lomo:ActionResult ;
            rdfs:label "Data related to the communication of pure electric vehicles (PEV) and off-vehicle charging hybrid electric vehicles (OVC-HEV) with the recharging infrastructure, the electricity grid and the stationary power systems capable of supporting smart and bidirectional charging functionalities"@en ] ;
    dcterms:conformsTo <http://example.org/standard/the-commission-shall-take-measures-establishing-the-technical-specifications> ;
    dcterms:title "Data related to the communication of pure electric vehicles (PEV) and off-vehicle charging hybrid electric vehicles (OVC-HEV) with the recharging infrastructure, the electricity grid and the stationary power systems capable of supporting smart and bidirectional charging functionalities"@en .

<http://example.org/dataset/obm-and-obfcm-data> a dcat:Dataset ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/993/cod/doc/com/COM_2025_993/FINAL/eng/art_4> ;
    lomo:manifests [ a lomo:ActionResult ;
            rdfs:label "OBM and OBFCM data"@en ] ;
    dcterms:conformsTo <http://example.org/standard/the-commission-shall-take-measures-establishing-the-technical-specifications> ;
    dcterms:title "OBM and OBFCM data"@en .

