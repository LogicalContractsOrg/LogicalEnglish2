<http://example.org/analysis/interop/1> a cpsv:PublicService ;
    rdfs:label "Streamlined monitoring of real-world vehicle performance under Euro 7"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/993/cod/doc/com/COM_2025_993/FINAL/eng/art_4> ;
    dcterms:description "Streamlined monitoring of real-world vehicle performance under Euro 7"@en ;
    dcterms:identifier "interop/1" ;
    dcterms:title "Streamlined monitoring of real-world vehicle performance under Euro 7"@en .

<http://example.org/process/data-exchange> skos:prefLabel "Data exchange"@en .

