<http://example.org/analysis/description/22> a iopa:BindingRequirement,
        lomo:LegalRule ;
    rdfs:label "Article 6"@en ;
    iopa:affects <http://example.org/analysis/interop/2> ;
    cav:valueDescription "Amendment of Directive (EU) 2022/2555 (NIS2): ·(1): Inserting Article 23a on the development and maintenance of a single-entry point for incident reporting; ·(3): Amending Article 23(4) to mandate the use of the single-entry point for notifications of severe incidents; ·(4): Inserting Article 23(12), which ensures that severe incidents are reported only once (either under NIS2, or under the Cyber Resilience Act); ·(5): Amending Article 30(1) ensuring that the single-entry point can be used, on a voluntary basis, for notifications by different entities."@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ;
            lomo:temporalLabel "Ad hoc"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_6> ;
    lomo:hasCategory dd:Data,
        dd:DigitalSolutions ;
    lomo:involvesProcess <http://example.org/process/notification> ;
    lomo:produces <http://example.org/analysis/action/38>,
        <http://example.org/analysis/description/22/action> ;
    lomo:references <http://example.org/dataset/reports-on-significant-incidents-pursuant-to-the-nis2-directive> ;
    dcterms:description "Amendment of Directive (EU) 2022/2555 (NIS2): ·(1): Inserting Article 23a on the development and maintenance of a single-entry point for incident reporting; ·(3): Amending Article 23(4) to mandate the use of the single-entry point for notifications of severe incidents; ·(4): Inserting Article 23(12), which ensures that severe incidents are reported only once (either under NIS2, or under the Cyber Resilience Act); ·(5): Amending Article 30(1) ensuring that the single-entry point can be used, on a voluntary basis, for notifications by different entities."@en ;
    dcterms:relation <http://example.org/ie-solution/european-business-wallets> .

