<http://example.org/analysis/assessment/1> a cav:Assessment ;
    cav:assesses <http://example.org/analysis/description/18>,
        <http://example.org/analysis/description/22> ;
    cav:resultsIn <http://example.org/analysis/assessment/1/1/measure>,
        <http://example.org/analysis/assessment/1/2/measure>,
        <http://example.org/analysis/assessment/1/3/measure>,
        <http://example.org/analysis/assessment/1/4/measure>,
        <http://example.org/analysis/assessment/1/5/measure>,
        <http://example.org/analysis/assessment/1/6/measure>,
        <http://example.org/analysis/assessment/1/7/measure>,
        <http://example.org/analysis/assessment/1/8/measure> ;
    m8g:isProvidedBy <http://publications.europa.eu/resource/authority/corporate-body/COM> .

<http://example.org/analysis/description/1> a lomo:LegalRule ;
    rdfs:label "Article 1"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_1> ;
    lomo:involvesProcess <http://example.org/process/extension-of-the-scope-of-application-of-the-data-act> ;
    lomo:produces <http://example.org/analysis/description/1/action> ;
    dcterms:description "Amendment to Article 1(1) of the Data Act, widening its scope of application to the establishment of the following: ·a framework for registration of data intermediation services; ·a framework for voluntary registration of entities which collect, and process data made available for altruistic purposes; ·a framework for the establishment of a European Data Innovation Board."@en .

<http://example.org/analysis/description/10> a lomo:LegalRule ;
    rdfs:label "Article 1"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_1> ;
    lomo:hasCategory dd:Data ;
    lomo:produces <http://example.org/analysis/description/10/action> ;
    dcterms:description "Insertion of Article 32k into the Data Act. Rules regarding exclusive arrangements for data reuse. Includes obligation to make the final terms of arrangements publicly available."@en .

<http://example.org/analysis/description/11> a lomo:LegalRule ;
    rdfs:label "Article 1"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_1> ;
    lomo:hasCategory dd:Data,
        dd:ProcessAutomation ;
    lomo:involvesProcess <http://example.org/process/data-re-use-rules> ;
    lomo:produces <http://example.org/analysis/description/11/action> ;
    dcterms:description "Amendments to the Data Act: ·(41): Inserting Article 32n on general principle for the re-use of open government data. ·(42): Inserting Article 32o on the processing of requests for data re-use ·(43): Inserting Article 32p on formats for data reuse ·(46): Inserting Article 32s on practical arrangements facilitating the search for data or documents available for re-use"@en .

<http://example.org/analysis/description/12> a lomo:LegalRule ;
    rdfs:label "Article 1"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_1> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/data-re-use-rules> ;
    lomo:produces <http://example.org/analysis/description/12/action> ;
    dcterms:description "Insertion of Article 32t into the Data Act; requirement to support the availability of research data."@en .

<http://example.org/analysis/description/13> a lomo:LegalRule ;
    rdfs:label "Article 1"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_1> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/data-re-use-rules> ;
    lomo:produces <http://example.org/analysis/description/13/action> ;
    dcterms:description "Insertion of Article 32u into the Data Act. Laying down arrangements for the publication and re-use of specific high-value datasets."@en .

<http://example.org/analysis/description/14> a lomo:LegalRule ;
    rdfs:label "Article 1"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_1> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/data-re-use-rules> ;
    lomo:produces <http://example.org/analysis/description/14/action> ;
    dcterms:description "Insertion of Article 32w into the Data Act. Laying down conditions for the re-use of certain categories of data. The procedures for requesting and the conditions for allowing such re-use shall be made publicly available via the single information point."@en .

<http://example.org/analysis/description/15> a lomo:LegalRule ;
    rdfs:label "Article 1"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_1> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/transfer-of-data-to-third-countries> ;
    lomo:produces <http://example.org/analysis/description/15/action> ;
    dcterms:description "Insertion of Article 32x into the Data Act; requirements for the transfers of non-personal data to third countries by re-users."@en .

<http://example.org/analysis/description/16> a lomo:LegalRule ;
    rdfs:label "Article 1"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_1> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/complaints>,
        <http://example.org/process/establishment-of-competent-bodies>,
        <http://example.org/process/request-procedures> ;
    lomo:produces <http://example.org/analysis/description/16/action> ;
    dcterms:description "Amendments to the Data Act: ·(55): Inserting Article 32z; organisational measures pertaining to competent bodies. ·(57): Inserting Article 32ab on procedures for requests for re-use of data. ·(58): Replacing Article 38(1-2) on the right to lodge a complaint."@en .

<http://example.org/analysis/description/17> a lomo:LegalRule ;
    rdfs:label "Article 1"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_1> ;
    lomo:hasCategory dd:Data,
        dd:DigitalSolutions,
        dd:ProcessAutomation ;
    lomo:involvesProcess <http://example.org/process/establishment-of-a-single-access-point> ;
    lomo:produces <http://example.org/analysis/description/17/action> ;
    dcterms:description "Inserting Article 32aa into the Data Act. Mandating the use of a Single Information Point to facilitate data reuse."@en .

<http://example.org/analysis/description/19> a lomo:LegalRule ;
    rdfs:label "Article 3"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_3> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/notification> ;
    lomo:produces <http://example.org/analysis/description/19/action> ;
    dcterms:description "Amendment of Article 33, Regulation (EU) 2016/679 (GDPR), as pertains to personal data breach notifications. Inter alia, mandates the use of the single-entry point established pursuant to Article 23a of Directive (EU) 2022/2555, and foresees the use of notification templates."@en .

<http://example.org/analysis/description/2> a lomo:LegalRule ;
    rdfs:label "Article 1"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_1> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/notification> ;
    lomo:produces <http://example.org/analysis/description/2/action> ;
    dcterms:description "Amendment to Articles 4(8) and 5(11) of the Data Act. Data holders refusing to share data pursuant to the trade secrets exception shall provide adequate notification of such decision."@en .

<http://example.org/analysis/description/20> a lomo:LegalRule ;
    rdfs:label "Article 3"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_3> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/board-proposals-transmitted-to-commission> ;
    lomo:produces <http://example.org/analysis/description/20/action> ;
    dcterms:description "Amendment of Article 35 and 70(1), Regulation (EU) 2016/679 (GDPR). Requirement for the European Data Protection Board to transmit to the Commission proposals to further operationalise certain aspects of the data protection impact assessment. These include a common template for such assessments."@en .

<http://example.org/analysis/description/21> a lomo:LegalRule ;
    rdfs:label "Article 3"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ;
            lomo:temporalLabel "Ad hoc"@en ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ;
            lomo:temporalLabel "Ad hoc"@en ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ;
            lomo:temporalLabel "Ad hoc"@en ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ;
            lomo:temporalLabel "Within [months] of the entry into application of this RegulationEvery three years"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_3> ;
    lomo:hasCategory dd:DigitalSolutions,
        dd:ProcessAutomation ;
    lomo:involvesProcess <http://example.org/process/automated-and-machine-readable-indications-of-data-subjects-choices> ;
    lomo:produces <http://example.org/analysis/action/35>,
        <http://example.org/analysis/action/36>,
        <http://example.org/analysis/action/37>,
        <http://example.org/analysis/action/39>,
        <http://example.org/analysis/description/21/action> ;
    lomo:references <http://example.org/dataset/edpb-proposal-for-a-common-data-breach-notification-template>,
        <http://example.org/dataset/edpb-proposals-regarding-the-data-protection-impact-assessment>,
        <http://example.org/dataset/notifications-of-personal-data-breaches> ;
    dcterms:description "Insertion of Article 88b into Regulation (EU) 2016/679 (GDPR); data subjects shall be able to provide consent / exercise the right to object through automated and machine-readable means. Standards are foreseen to be drafted by one or more European standardisation organisations."@en .

<http://example.org/analysis/description/23> a lomo:LegalRule ;
    rdfs:label "Article 7"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_7> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/notification> ;
    lomo:produces <http://example.org/analysis/description/23/action> ;
    dcterms:description "Amendment of Regulation (EU) 910/2014 (EUDIW) requiring the use of the single-entry point, pursuant to Article 23a of Directive (EU) 2022/2555, for: ·Article 19a(1a): Notifications referred to in paragraph (1), point (b). ·Article 24(2a): Notifications referred to in paragraph (2), point (fb). Article 45a(3a): Notifications referred to in paragraph (3)."@en .

<http://example.org/analysis/description/24> a lomo:LegalRule ;
    rdfs:label "Article 8"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ;
            lomo:temporalLabel "Ad hoc"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_8> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/notification> ;
    lomo:produces <http://example.org/analysis/action/40>,
        <http://example.org/analysis/description/24/action> ;
    lomo:references <http://example.org/dataset/notifications-of-major-ict-related-incidents-pursuant-to-dora-voluntary-notifications-of-significant-cyber-threats-pursuant-to-dora> ;
    dcterms:description "Amendment of Regulation (EU) 2022/2554 (DORA) requiring the use of the single-entry point, pursuant to Article 23a of Directive (EU) 2022/2555, for: ·Article 19(1): Major ICT-related incidents ·Article 19(2): voluntary notifications of significant cyber threats."@en .

<http://example.org/analysis/description/25> a lomo:LegalRule ;
    rdfs:label "Article 9"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ;
            lomo:temporalLabel "Ad hoc"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_9> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/notification> ;
    lomo:produces <http://example.org/analysis/action/41>,
        <http://example.org/analysis/description/25/action> ;
    lomo:references <http://example.org/dataset/notifications-of-incidents-that-significantly-disrupt-or-have-the-potential-to-significantly-disrupt-the-provision-of-essential-services-pursuant-to-the-cer-directive> ;
    dcterms:description "Amendment of Directive (EU) 2022/2557 (CER) requiring the use of the single-entry point, pursuant to Article 23a of Directive (EU) 2022/2555, for: ·Article 15(1): Incidents that significantly disrupt or have the potential to significantly disrupt the provision of essential services."@en .

<http://example.org/analysis/description/3> a lomo:LegalRule ;
    rdfs:label "Article 1"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_1> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/making-data-available> ;
    lomo:produces <http://example.org/analysis/description/3/action> ;
    dcterms:description "Insertion of Article 15a into the Data Act. Obligation to make data available on the basis of a public emergency."@en .

<http://example.org/analysis/description/4> a lomo:LegalRule ;
    rdfs:label "Article 1"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_1> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/complaints>,
        <http://example.org/process/data-sharing> ;
    lomo:produces <http://example.org/analysis/description/4/action> ;
    dcterms:description "Amendment to Article 21(5) of the Data Act. Requirements regarding the sharing of data obtained in the context of a public emergency with research organisations or statistical bodies. Insertion of Article 22a into the Data Act, allowing for complaints as relates to Chapter V (‘Making data available to public sector bodies, the Commission, the European Central Bank and Union Bodies on the basis of an exceptional need’)."@en .

<http://example.org/analysis/description/5> a lomo:LegalRule ;
    rdfs:label "Article 1"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_1> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/international-governmental-data-access-and-transfer> ;
    lomo:produces <http://example.org/analysis/description/5/action> ;
    dcterms:description "Amendments to Article 32(1-5) of the Data Act on third-country access to non-personal data."@en .

<http://example.org/analysis/description/6> a lomo:LegalRule ;
    rdfs:label "Article 1"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_1> ;
    lomo:involvesProcess <http://example.org/process/adoption-of-common-specifications> ;
    lomo:produces <http://example.org/analysis/description/6/action> ;
    dcterms:description "Amendment to Article 35(5) of the Data Act, allowing the Commission to adopt common specifications as relates to the interoperability of data processing services."@en .

<http://example.org/analysis/description/7> a lomo:LegalRule ;
    rdfs:label "Article 1"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_1> ;
    lomo:hasCategory dd:Data,
        dd:ProcessAutomation ;
    lomo:involvesProcess <http://example.org/process/establishment-of-the-european-label-for-data-intermediation-services>,
        <http://example.org/process/establishment-of-the-free-movement-of-data-within-the-european-union> ;
    lomo:produces <http://example.org/analysis/description/7/action> ;
    dcterms:description "Amendments to Article 32a-32e of the Data Act to introduce Chapter VIIa on the regulatory framework for a European label for data intermediation services including notification, creation of a public register, conditions for service provision, designation of competent authorities, and monitoring of compliance Amendments to Article 32h of the Data Act to introduce Chapter VIIb on the free flows of data within the Union including prohibition of data localisation requirements, notification obligations to the Commission, and publication of a consolidated list."@en .

<http://example.org/analysis/description/8> a lomo:LegalRule ;
    rdfs:label "Article 1"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_1> ;
    lomo:hasCategory dd:Data,
        dd:ProcessAutomation ;
    lomo:involvesProcess <http://example.org/process/establishment-of-the-free-movement-of-data-within-the-european-union> ;
    lomo:produces <http://example.org/analysis/description/8/action> ;
    dcterms:description "Amendments to Article 32h of the Data Act to introduce Chapter VIIb on the free flows of data within the Union including prohibition of data localisation requirements, notification obligations to the Commission, and publication of a consolidated list."@en .

<http://example.org/analysis/description/9> a lomo:LegalRule ;
    rdfs:label "Article 1"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_1> ;
    lomo:involvesProcess <http://example.org/process/defining-subject-matter-and-scope>,
        <http://example.org/process/non-discrimination> ;
    lomo:produces <http://example.org/analysis/description/9/action> ;
    dcterms:description "Insertion of Article 32i into the Data Act, defining the scope of Chapter VIIc. This establishes a set of minimum rules governing the re-use and the practical arrangements for facilitating the re-use of data. Insertion of Article 32j into the Data Act; provision on non-discrimination as regards the re-use of data and documents."@en .

<http://example.org/analysis/solution/1> a dctype:Software ;
    rdfs:label "Public Union register of data intermediation services and data altruism organisations"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_32> ;
    lomo:hasCapability "Storage and publication of mandatory information" ;
    dcterms:publisher <http://example.org/agent/european-commission> ;
    dcterms:title "Public Union register of data intermediation services and data altruism organisations"@en .

<http://example.org/analysis/solution/2> a dctype:Software ;
    rdfs:label "Single Information Point (under the Data Act)"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_1>,
        <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_32> ;
    lomo:hasCapability "Information to be made available and accessibleCompetent to receive enquiries or requests for the re-use of the categories of protected dataTransmit requests, where possible and appropriate by automated means, to the competent public sector bodiesMake available by electronic means a searchable asset list containing an overview of all available document resources" ;
    dcterms:publisher <http://example.org/agent/european-commission> ;
    dcterms:title "Single Information Point (under the Data Act)"@en .

<http://example.org/analysis/solution/3> a dctype:Software ;
    rdfs:label "Single-entry point for incident notifications"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_23>,
        <https://data.europa.eu/eli/dl/proc/2025/837/cod/doc/com/COM_2025_837/FINAL/eng/art_6> ;
    lomo:hasCapability "Enable reporting of incidents pursuant to relevant Union level actsEnsure interoperability and compatibility with European Business Wallets" ;
    dcterms:publisher <http://example.org/agent/european-commission-enisa> ;
    dcterms:title "Single-entry point for incident notifications"@en .

<http://example.org/agent/access-request-originators> rdfs:label "Access request originators"@en .

<http://example.org/agent/available-to-users-of-the-single-information-point> rdfs:label "Available to users of the single information point"@en .

<http://example.org/agent/bodies-with-specific-expertise> rdfs:label "Bodies with specific expertise"@en .

<http://example.org/agent/competent-authorities-for-data-intermediation-services> rdfs:label "Competent authorities for data intermediation services"@en .

<http://example.org/agent/competent-authorities-for-enforcement-of-chapters-ii-iii-and-v> rdfs:label "Competent authorities for enforcement of Chapters II, III and V"@en .

<http://example.org/agent/competent-authorities-for-re-use-of-public-sector-information-open-data-directive> rdfs:label "Competent authorities for re-use of public sector information (Open Data Directive)"@en .

<http://example.org/agent/competent-authorities-for-registration-of-data-altruism-organisations> rdfs:label "Competent authorities for registration of data altruism organisations"@en .

