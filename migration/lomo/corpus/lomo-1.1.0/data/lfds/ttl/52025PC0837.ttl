<http://example.org/agent/competent-authority-in-the-member-state-of-main-establishment> rdfs:label "Competent authority in the Member State of main establishment"@en .

<http://example.org/agent/competent-authority-of-the-member-state-where-the-data-holder-is-established> rdfs:label "Competent authority of the Member State where the data holder is established"@en .

<http://example.org/agent/competent-bodies> rdfs:label "Competent bodies"@en .

<http://example.org/agent/council> rdfs:label "Council"@en .

<http://example.org/agent/critical-entities> rdfs:label "Critical entities"@en .

<http://example.org/agent/customer> rdfs:label "Customer"@en .

<http://example.org/agent/data-altruism-organisations> rdfs:label "Data altruism organisations"@en .

<http://example.org/agent/data-collection-and-processing-entities> rdfs:label "Data collection and processing entities"@en .

<http://example.org/agent/data-controller> rdfs:label "Data controller"@en .

<http://example.org/agent/data-holder-from-whom-the-data-was-received> rdfs:label "Data holder from whom the data was received"@en .

<http://example.org/agent/data-holders-trade-secret-holders> rdfs:label "Data holders (trade secret holders)"@en .

<http://example.org/agent/data-intermediation-services> rdfs:label "Data intermediation services"@en .

<http://example.org/agent/data-intermediation-services-provider> rdfs:label "Data intermediation services provider"@en .

<http://example.org/agent/data-processing-services-providers-data-intermediation-services-providers-data-altruism-organisations> rdfs:label "Data processing services providers, Data intermediation services providers, Data altruism organisations"@en .

<http://example.org/agent/data-subjects-data-holders-data-users> rdfs:label "Data subjects, Data holders, Data users"@en .

