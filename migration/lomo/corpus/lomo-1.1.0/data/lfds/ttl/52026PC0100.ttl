<http://example.org/analysis/solution/1> a dctype:Software ;
    rdfs:label "Digital Permitting System"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/100/cod/doc/com/COM_2026_100/FINAL/eng/art_4> ;
    lomo:hasCapability "Permit-granting procedures for industrial manufacturing are carried out through fully digital means.The system shall provide a single user interface enabling interaction with the relevant public services.The digital permitting system shall enable the paperless submission, tracking, and decision-making of permit applications." ;
    dcterms:publisher <http://example.org/agent/member-statesnational-competent-authorities> ;
    dcterms:title "Digital Permitting System"@en .

y6k:c_422e961c skos:prefLabel "Reporting"@en .

