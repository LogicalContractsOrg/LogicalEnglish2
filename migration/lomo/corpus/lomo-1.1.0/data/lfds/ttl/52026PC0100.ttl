<http://example.org/analysis/description/10> a lomo:LegalRule ;
    rdfs:label "Article 37"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/100/cod/doc/com/COM_2026_100/FINAL/eng/art_37> ;
    lomo:hasCategory dd:Data,
        dd:ProcessAutomation ;
    lomo:involvesProcess <http://example.org/process/information-sharing> ;
    lomo:produces <http://example.org/analysis/description/10/action> ;
    dcterms:description "List of areas of information relevant for citizens and business exercising their internal market rights established by Regulation (EU) 2018/1724 is extended by information on permit-granting procedures, effectively utilising solutions under the Single Digital Gateway."@en .

<http://example.org/analysis/description/2> a lomo:LegalRule ;
    rdfs:label "Article 5"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/100/cod/doc/com/COM_2026_100/FINAL/eng/art_5> ;
    lomo:hasCategory dd:Data,
        dd:ProcessAutomation ;
    lomo:involvesProcess <http://example.org/process/permit-granting> ;
    lomo:produces <http://example.org/analysis/description/2/action> ;
    lomo:references <http://example.org/dataset/permit-granting-applications-for-industrial-manufacturing-projects> ;
    dcterms:description "Orchestration of national permit-granting procedures to enable a one-stop-shop for permitting of industrial manufacturing projects."@en .

<http://example.org/analysis/description/3> a lomo:LegalRule ;
    rdfs:label "Article 6"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/100/cod/doc/com/COM_2026_100/FINAL/eng/art_6> ;
