@prefix cav: <http://data.europa.eu/2sa/cav#> .
@prefix cpsv: <http://purl.org/vocab/cpsv#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dctype: <http://purl.org/dc/dcmitype/> .
@prefix iopa: <http://data.europa.eu/2qy/iopa#> .
@prefix lomo: <http://data.europa.eu/leg/lomo#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tf: <http://data.europa.eu/leg/temporal-function/> .

<http://example.org/analysis/description/1> a iopa:BindingRequirement,
        lomo:LegalRule ;
    rdfs:label "Article 11"@en ;
    iopa:affects <http://example.org/analysis/interop/1> ;
    cav:valueDescription "Exchanges of information between home and host competent authorities should be made faster, allowing closer coordination including, where appropriate, through the involvement of the European Insurance and Occupational Pensions Authority (‘EIOPA’). Member States shall ensure that all procedures and formalities relating to cross-border activities and procedures can be easily completed through electronic means"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/842/cod/doc/com/COM_2025_842/FINAL/eng/art_11> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data>,
        <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions>,
        <http://data.europa.eu/leg/digital-dimensions/ProcessAutomation> ;
    lomo:involvesProcess <http://example.org/process/exchange-of-information> ;
    lomo:produces <http://example.org/analysis/action/2>,
        <http://example.org/analysis/description/1/action> ;
    lomo:references <http://example.org/dataset/information-related-to-cross-border-activities-and-procedures-collaborative-platforms> ;
    dcterms:description "Exchanges of information between home and host competent authorities should be made faster, allowing closer coordination including, where appropriate, through the involvement of the European Insurance and Occupational Pensions Authority (‘EIOPA’). Member States shall ensure that all procedures and formalities relating to cross-border activities and procedures can be easily completed through electronic means"@en .

<http://example.org/analysis/description/2> a iopa:BindingRequirement,
        lomo:LegalRule ;
    rdfs:label "Article 22a"@en ;
    iopa:affects <http://example.org/analysis/interop/2> ;
    cav:valueDescription "Where pension tracking systems are in place, Member States shall ensure that insurance undertakings and insurance intermediaries transmit to pension tracking systems, where such system have been established, all information necessary to provide customers with a comprehensive, reliable and up-to-date overview of their personal and occupational entitlements"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/842/cod/doc/com/COM_2025_842/FINAL/eng/art_22> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data>,
        <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> ;
    lomo:involvesProcess <http://example.org/process/transmission-of-information> ;
    lomo:produces <http://example.org/analysis/action/1>,
        <http://example.org/analysis/description/2/action> ;
    lomo:references <http://example.org/dataset/information-necessary-to-provide-members-and-beneficiaries-with-a-comprehensive-reliable-and-up-to-date-overview-of-their-occupational-and-personal-pension-entitlements> ;
    dcterms:description "Where pension tracking systems are in place, Member States shall ensure that insurance undertakings and insurance intermediaries transmit to pension tracking systems, where such system have been established, all information necessary to provide customers with a comprehensive, reliable and up-to-date overview of their personal and occupational entitlements"@en .

<http://example.org/analysis/description/3> a iopa:BindingRequirement,
        lomo:LegalRule ;
    rdfs:label "Article 37a"@en ;
    iopa:affects <http://example.org/analysis/interop/2> ;
    cav:valueDescription "Member States shall ensure that IORPs transmit to pension tracking systems, where such system have been established, all information necessary to provide members and beneficiaries with a comprehensive, reliable and up-to-date overview of their occupational and personal pension entitlements. IORPs remain fully responsible for the completeness and accuracy of the data transmitted and for the fulfilment of all communication obligations. The format and structure of the information to be transmitted to pension tracking systems shall, to the maximum extent possible, ensure alignment with Commission Delegated Regulation (EU) 2021/473"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/842/cod/doc/com/COM_2025_842/FINAL/eng/art_37> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data>,
        <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> ;
    lomo:involvesProcess <http://example.org/process/transmission-of-information> ;
    lomo:produces <http://example.org/analysis/action/1>,
        <http://example.org/analysis/description/3/action> ;
    lomo:references <http://example.org/dataset/information-necessary-to-provide-members-and-beneficiaries-with-a-comprehensive-reliable-and-up-to-date-overview-of-their-occupational-and-personal-pension-entitlements> ;
    dcterms:description "Member States shall ensure that IORPs transmit to pension tracking systems, where such system have been established, all information necessary to provide members and beneficiaries with a comprehensive, reliable and up-to-date overview of their occupational and personal pension entitlements. IORPs remain fully responsible for the completeness and accuracy of the data transmitted and for the fulfilment of all communication obligations. The format and structure of the information to be transmitted to pension tracking systems shall, to the maximum extent possible, ensure alignment with Commission Delegated Regulation (EU) 2021/473"@en .

<http://example.org/analysis/description/4> a iopa:BindingRequirement,
        lomo:LegalRule ;
    rdfs:label "Article 55a"@en ;
    iopa:affects <http://example.org/analysis/interop/1> ;
    cav:valueDescription "EIOPA may, on its own initiative or at the request of one or more of the relevant competent authorities, set up and coordinate a collaboration platform to strengthen the exchange of information and to enhance collaboration between the relevant competent authorities where an IORP carries out, or intends to carry out, cross-border activities. The relevant competent authorities shall provide all necessary information in a timely manner"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/842/cod/doc/com/COM_2025_842/FINAL/eng/art_55> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data>,
        <http://data.europa.eu/leg/digital-dimensions/DigitalPublicService> ;
    lomo:involvesProcess <http://example.org/process/publish-monitor-manage-registry> ;
    lomo:produces <http://example.org/analysis/action/2>,
        <http://example.org/analysis/description/4/action> ;
    lomo:references <http://example.org/dataset/information-related-to-cross-border-activities-and-procedures-collaborative-platforms> ;
    dcterms:description "EIOPA may, on its own initiative or at the request of one or more of the relevant competent authorities, set up and coordinate a collaboration platform to strengthen the exchange of information and to enhance collaboration between the relevant competent authorities where an IORP carries out, or intends to carry out, cross-border activities. The relevant competent authorities shall provide all necessary information in a timely manner"@en .

<http://example.org/analysis/solution/1> a dctype:Software ;
    rdfs:label "Updating of existing pension tracking systems"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/842/cod/doc/com/COM_2025_842/FINAL/eng/art_22>,
        <https://data.europa.eu/eli/dl/proc/2025/842/cod/doc/com/COM_2025_842/FINAL/eng/art_37> ;
    lomo:hasCapability "IORPs, insurance undertakings and insurance intermediaries and distributors could transmit to pension tracking systems, where these exist, all information necessary to provide customers with a comprehensive, reliable and up-to-date overview of their personal and occupational entitlements" ;
    dcterms:publisher <http://example.org/agent/pension-tracking-system-provider-ncas> ;
    dcterms:title "Updating of existing pension tracking systems"@en .

<http://example.org/analysis/solution/2> a dctype:Software ;
    rdfs:label "Collaborative platforms"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/842/cod/doc/com/COM_2025_842/FINAL/eng/art_11>,
        <https://data.europa.eu/eli/dl/proc/2025/842/cod/doc/com/COM_2025_842/FINAL/eng/art_55> ;
    lomo:hasCapability "Provide information related to cross-border activities and procedures" ;
    dcterms:publisher <http://example.org/agent/ncas> ;
    dcterms:title "Collaborative platforms"@en .

