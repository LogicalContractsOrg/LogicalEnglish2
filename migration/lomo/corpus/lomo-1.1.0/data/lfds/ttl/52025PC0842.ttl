    lomo:hasAgentRole <http://example.org/analysis/action/1/role/addressee-pension-tracking-system-provider>,
        <http://example.org/analysis/action/1/role/addresser-iorps-insurance-undertakings-and-insurance-intermediaries> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Information necessary to provide members and beneficiaries with a comprehensive, reliable and up-to-date overview of their occupational and personal pension entitlements"@en ;
