<http://example.org/analysis/description/2> a lomo:LegalRule ;
    rdfs:label "Article 6"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/231/cod/doc/com/COM_2026_231/FINAL/eng/art_6> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data> ;
    lomo:produces <http://example.org/analysis/description/2/action> ;
    dcterms:description "Commercial agreements between B2B MDMS providers and business suers shall not intentionally or otherwise: (a) prevent a business user from subscribing to or using any other similar system, (b) require the acceptance of additional conditions to be accepted which are not necessary for the subscription to the B2B MDMS, (c) impose an obligation to accept specific technical equipment or software, and (d) impose any other unfair or unjustified conditions."@en .

<http://example.org/analysis/description/3> a lomo:LegalRule ;
    rdfs:label "Article 7"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/231/cod/doc/com/COM_2026_231/FINAL/eng/art_7> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/data-processing-and-publication> ;
    lomo:produces <http://example.org/analysis/action/2>,
        <http://example.org/analysis/description/3/action> ;
    lomo:references <http://example.org/dataset/operators-data> ;
    dcterms:description "B2C and B2B MDMS providers shall load and process data of operators with equal care and shall display transport products of operators in a neutral and comprehensive manner. Article 7 sets out the criteria for the default ranking of transport products and other functionalities of the MDMS."@en .

<http://example.org/analysis/description/4> a lomo:LegalRule ;
    rdfs:label "Article 8"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/231/cod/doc/com/COM_2026_231/FINAL/eng/art_8> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/data-processing-and-publication> ;
    lomo:produces <http://example.org/analysis/action/3>,
        <http://example.org/analysis/description/4/action> ;
    lomo:references <http://example.org/dataset/marketing-booking-and-sales-data> ;
    dcterms:description "Article 8 sets out requirements for the marketing, booking and sales data provided by B2C MDMS and B2B MDMS providers to participating transport operators."@en .

<http://example.org/analysis/description/5> a lomo:LegalRule ;
    rdfs:label "Article 9"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/231/cod/doc/com/COM_2026_231/FINAL/eng/art_9> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/disclosure-of-information> ;
    lomo:produces <http://example.org/analysis/action/4>,
        <http://example.org/analysis/description/5/action> ;
    lomo:references <http://example.org/dataset/data-on-greenhouse-gas-emissions-or-carbon-dioxide-equivalent-emissions-of-the-transport-products> ;
    dcterms:description "Article 9 sets out the requirements related to the information on greenhouse gas emissions and carbon dioxide equivalent emissions."@en .

<http://example.org/analysis/description/6> a lomo:LegalRule ;
    rdfs:label "Article 10"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/231/cod/doc/com/COM_2026_231/FINAL/eng/art_10> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/statistics-reporting-obligations> ;
    lomo:produces <http://example.org/analysis/action/5>,
        <http://example.org/analysis/description/6/action> ;
    lomo:references <http://example.org/dataset/data-which-may-be-used-to-improve-the-effectiveness-of-public-transport-policies-and-sustainable-mobility> ;
    dcterms:description "Article 10 sets out the requirements for the B2C MDMS sharing of data with public transport authorities."@en .

<http://example.org/analysis/description/7> a lomo:LegalRule ;
    rdfs:label "Article 12"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/231/cod/doc/com/COM_2026_231/FINAL/eng/art_12> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess y6k:c_a6392b44028d ;
    lomo:produces <http://example.org/analysis/description/7/action> ;
    dcterms:description "Where the national enforcement body requests to receive relevant information, it shall be presented without undue delay and, in any event, within one month from the receipt of the request."@en .

<http://example.org/analysis/description/8> a lomo:LegalRule ;
    rdfs:label "Article 12"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/231/cod/doc/com/COM_2026_231/FINAL/eng/art_12> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess y6k:c_a6392b44028d ;
    lomo:produces <http://example.org/analysis/description/8/action> ;
    dcterms:description "Cooperation between national enforcement bodies of Member States to ensure a coherent enforcement of this Regulation, mutual assistance in market monitoring tasks and complaint handling, including through the exchange of relevant information by electronic means while duly respecting the confidentiality of commercially sensitive data."@en .

<http://example.org/analysis/description/9> a lomo:LegalRule ;
    rdfs:label "Article 12"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/231/cod/doc/com/COM_2026_231/FINAL/eng/art_12> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess y6k:c_a6392b44028d ;
    lomo:produces <http://example.org/analysis/action/6>,
        <http://example.org/analysis/description/9/action> ;
    lomo:references <http://example.org/dataset/monitoring-and-enforcement-data-in-particular-as-regards-disputes-between-parties-between-authorities>,
        <http://example.org/dataset/monitoring-and-enforcement-data-information-about-the-thresholds> ;
    dcterms:description "The national enforcement bodies shall participate in a network that convenes regularly, and at least once a year, to exchange information in particular on their (i) monitoring, enforcement and implementation work, (ii) decision-making principles; and (iii) administrative practices."@en .

<http://example.org/analysis/solution/1> a dctype:Software ;
    rdfs:label "MDMS"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2026/231/cod/doc/com/COM_2026_231/FINAL/eng/art_7>,
        <https://data.europa.eu/eli/dl/proc/2026/231/cod/doc/com/COM_2026_231/FINAL/eng/art_9> ;
    lomo:hasCapability "B2C and B2B MDMS providers shall load and process data of operators with equal care and shall display transport products of operators in a neutral and comprehensive manner.Clear, transparent and accessible information on the greenhouse gas emissions or carbon dioxide equivalent emissions of the transport products displayed shall be provided by the B2C MDMS providers to end users and by B2B MDMS providers to business users, whenever such information is shared by transport operators." ;
    dcterms:publisher <http://example.org/agent/b2c-mdms-providersb2b-mdms-providers> ;
    dcterms:title "MDMS"@en .

