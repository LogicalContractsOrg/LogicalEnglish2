<http://example.org/analysis/description/10> a iopa:BindingRequirement,
        lomo:LegalRule ;
    rdfs:label "Article 3(7)"@en ;
    iopa:affects <http://example.org/analysis/interop/1>,
        <http://example.org/analysis/interop/2> ;
    cav:valueDescription "Where other Union legislation applicable to EU fertilising products requires the economic operator to include the information that the product complies with the requirements set out in that legislation in a digital product passport or to upload the EU declaration of conformity in a digital product passport, the information set out in Annex V to be included in the EU declaration of conformity and any digital labelling information in accordance with Article 11b, if applicable, shall be provided only in that digital product passport."@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/531/cod/doc/com/COM_2025_531/FINAL/eng/art_3/par_7> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/market-surveillance-verification-and-monitoring> ;
    lomo:produces <http://example.org/analysis/action/7>,
        <http://example.org/analysis/action/8>,
        <http://example.org/analysis/description/10/action> ;
    lomo:references <http://example.org/dataset/digital-label>,
        <http://example.org/dataset/digital-product-passport> ;
    dcterms:description "Where other Union legislation applicable to EU fertilising products requires the economic operator to include the information that the product complies with the requirements set out in that legislation in a digital product passport or to upload the EU declaration of conformity in a digital product passport, the information set out in Annex V to be included in the EU declaration of conformity and any digital labelling information in accordance with Article 11b, if applicable, shall be provided only in that digital product passport."@en ;
    dcterms:relation <http://example.org/ie-solution/icscms>,
        <http://example.org/ie-solution/nando> .

