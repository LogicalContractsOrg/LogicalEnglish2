<http://example.org/analysis/description/11> a iopa:BindingRequirement,
        lomo:LegalRule ;
    rdfs:label "Annex I, point (8)"@en ;
    iopa:affects <http://example.org/analysis/interop/1> ;
    cav:valueDescription "Label elements that may be provided on a digital label only (a) Supplemental information referred to in Article 25(3); (b) Where more than one supplier is indicated on the label in accordance with Article 17(1), point (a), the name, address and digital contact of the suppliers may be provided on a digital label only, as long as the supplier referred to in in Article 4(11) is indicated on the physical label.’;"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/531/cod/doc/com/COM_2025_531/FINAL/eng/anx_1> ;
