<http://example.org/analysis/description/1> a iopa:BindingRequirement,
        lomo:LegalRule ;
    rdfs:label "Article 1(3)"@en ;
    iopa:affects <http://example.org/analysis/interop/1> ;
    cav:valueDescription "The label shall also include the product identifier referred to in Article 18 and the name, address and digital contact of the supplier of the mixture."@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/531/cod/doc/com/COM_2025_531/FINAL/eng/art_1/par_3> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/market-surveillance-verification> ;
    lomo:produces <http://example.org/analysis/description/1/action> ;
    dcterms:description "The label shall also include the product identifier referred to in Article 18 and the name, address and digital contact of the supplier of the mixture."@en ;
    dcterms:relation <http://example.org/ie-solution/icscms> .

