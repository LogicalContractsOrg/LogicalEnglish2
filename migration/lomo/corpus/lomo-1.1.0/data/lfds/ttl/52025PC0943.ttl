<http://example.org/analysis/description/65> a lomo:LegalRule ;
    rdfs:label "Article 38fd"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/943/cod/doc/com/COM_2025_943/FINAL/eng/art_38> ;
