<http://example.org/analysis/description/7> a lomo:LegalRule ;
    rdfs:label "Article [11] 7"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/0/cod/doc/com/COM_2025_0/FINAL/eng/art_11> ;
