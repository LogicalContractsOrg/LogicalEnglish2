<http://example.org/analysis/description/38> a lomo:LegalRule ;
    rdfs:label "Article [55] Coordination on Biosecurity and Biosafety"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/0/cod/doc/com/COM_2025_0/FINAL/eng/art_55> ;
