<http://example.org/analysis/assessment/1/1/measure> a cav:Statement ;
    cav:interpretation iac:InterpretationPositive ;
    cav:judgement "The Biotechnology Data Quality Accelerator will operate in accordance with applicable Union legislation on data governance, ethics and fundamental rights, including Regulation (EU) 2025/327 [European Health Data Space], Regulation (EU) 2016/679 [General Data Protection Regulation]."@en ;
    cav:type iac:StatementTypeAlignmentMeasure ;
    m8g:hasRelatedService <http://example.org/analysis/interop/1> ;
    dcterms:description "Alignment with existing digital and sectorial policiesPlease list the applicable digital and sectorial policies identified"@en .

<http://example.org/analysis/assessment/1/2/measure> a cav:Statement ;
    cav:interpretation iac:InterpretationPositive ;
    cav:judgement "It will support, where appropriate, the integration of these datasets into Union infrastructures,including the European Health Data Space, European Research Area data spaces, or other, including the infrastructures operated by high impact healthbiotechnology strategic projects."@en ;
    cav:type iac:StatementTypeOrganisationMeasure ;
    m8g:hasRelatedService <http://example.org/analysis/interop/1> ;
    dcterms:description "Organisational measures for a smooth cross-border digital public services deliveryPlease list the governance measures foreseen"@en .

<http://example.org/analysis/assessment/1/3/measure> a cav:Statement ;
    cav:interpretation iac:InterpretationPositive ;
    cav:judgement "Datasets, or the metadata and reference annotations thereof, will be available under fair, reasonable and non-discriminatory conditions, ensuring equitable access for users including research organisations, SMEs and public institutions."@en ;
    cav:type iac:StatementTypeSharedMeasure ;
    m8g:hasRelatedService <http://example.org/analysis/interop/1> ;
    dcterms:description "Measures taken to ensure a shared understanding of the dataPlease list such measures"@en .

<http://example.org/analysis/assessment/1/4/measure> a cav:Statement ;
    cav:interpretation iac:InterpretationPositive ;
    cav:judgement "It will contribute to the development of Union standards and quality frameworks for data representativeness, provenance, interoperability and annotation in biotechnology"@en ;
    cav:type iac:StatementTypeStandardsMeasure ;
    m8g:hasRelatedService <http://example.org/analysis/interop/1> ;
    dcterms:description "Use of commonly agreed open technical specifications and standardsPlease list such measures"@en .

