    lomo:produces <http://example.org/analysis/description/47/action> ;
    dcterms:description "Sponsors shall evaluate AI models or AI systems proposed to be used in the context of the lifecycle of the specific clinical trial"@en .

<http://example.org/analysis/description/48> a lomo:LegalRule ;
    rdfs:label "Article [58]Amendments to Regulation (EU) No 536/2014 (‘Clinical Trials Regulation’) Articles 41 –46, 55, 56-58, 79a regarding reporting requirements"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ] ;
