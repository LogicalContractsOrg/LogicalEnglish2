<http://example.org/analysis/description/53> a lomo:LegalRule ;
    rdfs:label "Article [61] Amendments to Regulation (EC) No 2024/1938 Article [39a] 3"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/0/cod/doc/com/COM_2025_0/FINAL/eng/art_61> ;
