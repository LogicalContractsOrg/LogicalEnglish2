<http://example.org/analysis/action/1> a lomo:Action ;
    rdfs:label "Applications of a conformity assessment bodies for notification"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "Application being made for single assessment"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/836/cod/doc/com/COM_2025_836/FINAL/eng/art_1/par_11> ;
    lomo:hasAgentRole <http://example.org/analysis/action/1/role/addressee-notifying-authority-designated-in-accordance-with-union-harmonisation-legislation-listed-in-section-a-of-annex-i>,
        <http://example.org/analysis/action/1/role/addresser-notified-bodies-which-are-designated-under-union-harmonisation-legislation-listed-in-section-a-of-annex-i> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Applications of a conformity assessment bodies for notification"@en ;
            lomo:isManifestedIn <http://example.org/dataset/applications-of-a-conformity-assessment-bodies-for-notification> ] .

<http://example.org/analysis/action/1/role/addressee-notifying-authority-designated-in-accordance-with-union-harmonisation-legislation-listed-in-section-a-of-annex-i> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/notifying-authority-designated-in-accordance-with-union-harmonisation-legislation-listed-in-section-a-of-annex-i> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/analysis/action/1/role/addresser-notified-bodies-which-are-designated-under-union-harmonisation-legislation-listed-in-section-a-of-annex-i> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/notified-bodies-which-are-designated-under-union-harmonisation-legislation-listed-in-section-a-of-annex-i> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSER> .

<http://example.org/analysis/action/2> a lomo:Action ;
    rdfs:label "Commission assessment of the adequacy of the codes of practice"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:deadline ;
            lomo:temporalLabel "Regularly"@en ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "Performance of an assessment as regards the codes of practice"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/836/cod/doc/com/COM_2025_836/FINAL/eng/art_1/par_16> ;
    lomo:hasAgentRole <http://example.org/analysis/action/2/role/addressee-general-public>,
        <http://example.org/analysis/action/2/role/addresser-european-commission> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Commission assessment of the adequacy of the codes of practice"@en ;
            lomo:isManifestedIn <http://example.org/dataset/commission-assessment-of-the-adequacy-of-the-codes-of-practice> ] .

<http://example.org/analysis/action/2/role/addressee-general-public> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/general-public> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/analysis/action/2/role/addresser-european-commission> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/european-commission> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSER> .

<http://example.org/analysis/action/3> a lomo:Action ;
