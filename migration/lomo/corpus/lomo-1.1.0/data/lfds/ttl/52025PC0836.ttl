@prefix cpsv: <http://purl.org/vocab/cpsv#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dctype: <http://purl.org/dc/dcmitype/> .
@prefix dd: <http://data.europa.eu/leg/digital-dimensions/> .
@prefix lomo: <http://data.europa.eu/leg/lomo#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tf: <http://data.europa.eu/leg/temporal-function/> .

<http://example.org/analysis/description/1> a lomo:LegalRule ;
    rdfs:label "Article 1(5)"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/836/cod/doc/com/COM_2025_836/FINAL/eng/art_1/par_5> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/data-processing> ;
    lomo:produces <http://example.org/analysis/description/1/action> ;
    lomo:references <http://example.org/dataset/special-categories-of-personal-data-where-the-processing-is-needed-for-bias-detectioncorrection> ;
    dcterms:description "Inserting Article 4a: Allowing providers and deployers of AI systems and AI models to exceptionally process special categories of personal data to the extent necessary for the purpose of ensuring bias detection and correction, subject to certain conditions."@en .

<http://example.org/analysis/description/2> a lomo:LegalRule ;
    rdfs:label "Article 1(8)"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/836/cod/doc/com/COM_2025_836/FINAL/eng/art_1/par_8> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/technical-documentation> ;
    lomo:produces <http://example.org/analysis/description/2/action> ;
    lomo:references <http://example.org/dataset/technical-documentation-for-high-risk-ai-systems> ;
    dcterms:description "Amending Article 11(1), second subparagraph: Relating to the technical documentation of high-risk AI systems that needs to be drawn up before that system is placed on the market or put into service. SMEs and SMCs are given certain regulatory privileges as concerns this provision of information."@en .

<http://example.org/analysis/description/3> a lomo:LegalRule ;
    rdfs:label "Article 1(10)"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/836/cod/doc/com/COM_2025_836/FINAL/eng/art_1/par_10> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/application-submission> ;
    lomo:produces <http://example.org/analysis/description/3/action> ;
    lomo:references <http://example.org/dataset/applications-of-conformity-assessment-bodies-for-designation> ;
    dcterms:description "Amending Article 28, inserting paragraph (1a): Conformity assessment bodies that apply for a designation may be offered the possibility to submit a single application and undergo a single assessment procedure."@en .

<http://example.org/analysis/description/4> a lomo:LegalRule ;
    rdfs:label "Article 1(11)"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/836/cod/doc/com/COM_2025_836/FINAL/eng/art_1/par_11> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/application-submission> ;
    lomo:produces <http://example.org/analysis/action/1>,
        <http://example.org/analysis/description/4/action> ;
    lomo:references <http://example.org/dataset/applications-of-a-conformity-assessment-bodies-for-notification> ;
    dcterms:description "Amending Article 29(4): Notified bodies which apply for a single assessment shall submit the single application to the notifying authority. The notified body shall update the documentation if relevant changes occur."@en .

<http://example.org/analysis/description/5> a lomo:LegalRule ;
    rdfs:label "Article 1(16)"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ;
            lomo:temporalLabel "Regularly"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/836/cod/doc/com/COM_2025_836/FINAL/eng/art_1/par_16> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/assessment-publication> ;
    lomo:produces <http://example.org/analysis/action/2>,
        <http://example.org/analysis/description/5/action> ;
    lomo:references <http://example.org/dataset/commission-assessment-of-the-adequacy-of-the-codes-of-practice> ;
    dcterms:description "Amending Article 56(6): The Commission shall publish its assessments on the adequacy of the codes of practice."@en .

<http://example.org/analysis/description/6> a lomo:LegalRule ;
    rdfs:label "Article 1(26)"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:validity ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/836/cod/doc/com/COM_2025_836/FINAL/eng/art_1/par_26> ;
    lomo:hasCategory dd:Data ;
    lomo:involvesProcess <http://example.org/process/information-exchange> ;
    lomo:produces <http://example.org/analysis/action/3>,
        <http://example.org/analysis/action/4>,
        <http://example.org/analysis/action/5>,
        <http://example.org/analysis/action/6>,
        <http://example.org/analysis/description/6/action> ;
    lomo:references <http://example.org/dataset/information-or-documentation-requested-by-national-public-authoritiesbodies-which-superviseenforce-obligations-relating-to-fundamental-rights>,
        <http://example.org/dataset/request-for-access-to-information-on-ai-systems> ;
    dcterms:description "Amending Article 77: ·Paragraph 1: National public authorities/bodies which supervise/enforce EU law obligations protecting fundamental rights may make a reasoned request and access any information/documentation from the relevant market surveillance authority ·Paragraph 1a: market surveillance authority shall grant access and, where needed, request the information from the provider/deployer ·Paragraph 1b: where necessary, the aforementioned market surveillance authorities and public authorities/bodies shall exchange information."@en .

<http://example.org/analysis/interop/1> a cpsv:PublicService ;
    rdfs:label "N.A. (the proposed amendments to the AI Act do not affect digital public services)"@en ;
    dcterms:description "N.A. (the proposed amendments to the AI Act do not affect digital public services)"@en ;
    dcterms:identifier "interop/1" ;
    dcterms:title "N.A. (the proposed amendments to the AI Act do not affect digital public services)"@en .

<http://example.org/analysis/solution/1> a dctype:Software ;
    rdfs:label "N.A. (the proposed amendments to the AI Act do not foresee the adoption of new digital solutions)"@en ;
    dcterms:title "N.A. (the proposed amendments to the AI Act do not foresee the adoption of new digital solutions)"@en .

