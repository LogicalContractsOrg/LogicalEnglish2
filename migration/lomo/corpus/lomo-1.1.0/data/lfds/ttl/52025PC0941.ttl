    lomo:forAgent <http://example.org/agent/esma-system-operator-other-relevant-authorities-eba-escb> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/analysis/action/5/role/addresser-competent-authority-member-state> a lomo:AgentRole ;
