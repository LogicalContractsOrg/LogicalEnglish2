    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSER> .

<http://example.org/analysis/action/4/role/addressee-esma-relevant-authorities-member-state-level-eba-escb> a lomo:AgentRole ;
    lomo:forAgent <http://example.org/agent/esma-relevant-authorities-member-state-level-eba-escb> ;
    lomo:withRole <http://publications.europa.eu/resource/authority/role/ADDRESSEE> .

<http://example.org/analysis/action/4/role/addresser-third-country-system-operators> a lomo:AgentRole ;
