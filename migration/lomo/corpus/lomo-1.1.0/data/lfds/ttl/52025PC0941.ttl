@prefix cav: <http://data.europa.eu/2sa/cav#> .
@prefix cpsv: <http://purl.org/vocab/cpsv#> .
@prefix dcat: <http://www.w3.org/ns/dcat#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix dctype: <http://purl.org/dc/dcmitype/> .
@prefix iac: <http://data.europa.eu/leg/interop-assessment#> .
@prefix iopa: <http://data.europa.eu/2qy/iopa#> .
@prefix lomo: <http://data.europa.eu/leg/lomo#> .
@prefix m8g: <http://data.europa.eu/m8g/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix tf: <http://data.europa.eu/leg/temporal-function/> .

<http://example.org/analysis/action/1> a lomo:Action ;
    rdfs:label "Data relevant for application for designation as a EU system"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:deadline ;
            lomo:temporalLabel "For designation and on an ad-hoc basis if changes to the designation data occur"@en ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "Application for designation"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/941/cod/doc/com/COM_2025_941/FINAL/eng/art_5/par_1> ;
    lomo:hasAgentRole <http://example.org/analysis/action/1/role/addressee-competent-authority-member-state>,
        <http://example.org/analysis/action/1/role/addresser-system-operators> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Data relevant for application for designation as a EU system"@en ;
            lomo:isManifestedIn <http://example.org/dataset/data-relevant-for-application-for-designation-as-a-eu-system> ] .

<http://example.org/analysis/action/2> a lomo:Action ;
    rdfs:label "Data relevant for notification of systems to ESMA"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:deadline ;
            lomo:temporalLabel "Ad-hoc"@en ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "Notification"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/941/cod/doc/com/COM_2025_941/FINAL/eng/art_6/par_2>,
        <https://data.europa.eu/eli/dl/proc/2025/941/cod/doc/com/COM_2025_941/FINAL/eng/art_6/par_3> ;
    lomo:hasAgentRole <http://example.org/analysis/action/2/role/addressee-esma>,
        <http://example.org/analysis/action/2/role/addresser-competent-authority-member-state> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Data relevant for notification of systems to ESMA"@en ;
            lomo:isManifestedIn <http://example.org/dataset/data-relevant-for-notification-of-systems-to-esma> ] .

<http://example.org/analysis/action/3> a lomo:Action ;
    rdfs:label "Data relevant for withdrawal of designation"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:deadline ;
            lomo:temporalLabel "Ad-hoc"@en ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "Non-compliance with designation criteria"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/941/cod/doc/com/COM_2025_941/FINAL/eng/art_9/par_2>,
        <https://data.europa.eu/eli/dl/proc/2025/941/cod/doc/com/COM_2025_941/FINAL/eng/art_9/par_4> ;
    lomo:hasAgentRole <http://example.org/analysis/action/3/role/addressee-esma-system-operator-other-relevant-authorities-eba-escb>,
        <http://example.org/analysis/action/3/role/addresser-competent-authority-member-state> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Data relevant for withdrawal of designation"@en ;
            lomo:isManifestedIn <http://example.org/dataset/data-relevant-for-withdrawal-of-designation> ] .

<http://example.org/analysis/action/4> a lomo:Action ;
    rdfs:label "Data relevant for registration of third-country systems"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:deadline ;
            lomo:temporalLabel "For registration and on an ad hoc basis if changes to the designation data occur"@en ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "Application for registration"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/941/cod/doc/com/COM_2025_941/FINAL/eng/art_14/par_1> ;
    lomo:hasAgentRole <http://example.org/analysis/action/4/role/addressee-esma-relevant-authorities-member-state-level-eba-escb>,
        <http://example.org/analysis/action/4/role/addresser-third-country-system-operators> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Data relevant for registration of third-country systems"@en ;
            lomo:isManifestedIn <http://example.org/dataset/data-relevant-for-registration-of-third-country-systems> ] .

<http://example.org/analysis/action/5> a lomo:Action ;
    rdfs:label "Data relevant for withdrawal of registration"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:deadline ;
            lomo:temporalLabel "Ad-hoc"@en ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "Non-compliance with registration criteria"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/941/cod/doc/com/COM_2025_941/FINAL/eng/art_16/par_2> ;
    lomo:hasAgentRole <http://example.org/analysis/action/5/role/addressee-esma-system-operator-other-relevant-authorities-eba-escb>,
        <http://example.org/analysis/action/5/role/addresser-competent-authority-member-state> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Data relevant for withdrawal of registration"@en ;
            lomo:isManifestedIn <http://example.org/dataset/data-relevant-for-withdrawal-of-registration> ] .

<http://example.org/analysis/action/6> a lomo:Action ;
    rdfs:label "Data related to designated and registered systems"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:deadline ;
            lomo:temporalLabel "Ad-hoc"@en ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "Update of data/availability of new data related to the designation and registration of systems"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/941/cod/doc/com/COM_2025_941/FINAL/eng/art_10/par_3>,
        <https://data.europa.eu/eli/dl/proc/2025/941/cod/doc/com/COM_2025_941/FINAL/eng/art_15/par_2>,
        <https://data.europa.eu/eli/dl/proc/2025/941/cod/doc/com/COM_2025_941/FINAL/eng/art_16/par_4>,
        <https://data.europa.eu/eli/dl/proc/2025/941/cod/doc/com/COM_2025_941/FINAL/eng/art_6/par_4> ;
    lomo:hasAgentRole <http://example.org/analysis/action/6/role/addressee-general-public>,
        <http://example.org/analysis/action/6/role/addresser-esma> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Data related to designated and registered systems"@en ;
            lomo:isManifestedIn <http://example.org/dataset/data-related-to-designated-and-registered-systems> ] .

<http://example.org/analysis/action/7> a lomo:Action ;
    rdfs:label "Data regarding insolvency proceedings"@en ;
    lomo:atTime [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:trigger ;
            lomo:temporalLabel "Opening of insolvency proceedings"@en ],
        [ a lomo:TemporalSpecification ;
            lomo:hasFunction tf:deadline ;
            lomo:temporalLabel "Ad-hoc"@en ] ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/941/cod/doc/com/COM_2025_941/FINAL/eng/art_12/par_2> ;
    lomo:hasAgentRole <http://example.org/analysis/action/7/role/addressee-ecbescb-eba-the-european-systemic-risk-board-and-other-member-states>,
        <http://example.org/analysis/action/7/role/addressee-esma>,
        <http://example.org/analysis/action/7/role/addresser-competent-authority-member-state> ;
    lomo:hasResult [ a lomo:ActionResult ;
            rdfs:label "Data regarding insolvency proceedings"@en ;
            lomo:isManifestedIn <http://example.org/dataset/data-regarding-insolvency-proceedings> ] .

<http://example.org/analysis/assessment/1> a cav:Assessment ;
    cav:assesses <http://example.org/analysis/description/2>,
        <http://example.org/analysis/description/8> ;
    cav:resultsIn <http://example.org/analysis/assessment/1/1/barrier>,
        <http://example.org/analysis/assessment/1/2/measure>,
        <http://example.org/analysis/assessment/1/3/measure>,
        <http://example.org/analysis/assessment/1/4/measure> ;
    m8g:isProvidedBy <http://publications.europa.eu/resource/authority/corporate-body/COM> .

<http://example.org/analysis/description/1> a lomo:LegalRule ;
    rdfs:label "Article 26 – Central database"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/941/cod/doc/com/COM_2025_941/FINAL/eng/art_26> ;
    lomo:involvesProcess <http://example.org/process/establish-a-central-database> ;
    lomo:produces <http://example.org/analysis/description/1/action> ;
    dcterms:description "ESMA shall establish and maintain a central database providing access to the authorities involved in or concerned by the designation process of EU systems and the registration process of third-country systems, as well as the system operators."@en .

<http://example.org/analysis/description/10> a lomo:LegalRule ;
    rdfs:label "Article 16 – Withdrawal of registration"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/941/cod/doc/com/COM_2025_941/FINAL/eng/art_16> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data>,
        <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> ;
    lomo:involvesProcess <http://example.org/process/notify> ;
    lomo:produces <http://example.org/analysis/description/10/action> ;
    lomo:references <http://example.org/dataset/data-relevant-for-withdrawal-of-registration> ;
    dcterms:description "Where the registering authority withdraws the registration, it shall notify the system operator as well as ESMA, EBA, the ESCB and other registering authorities, as applicable, of the decision."@en .

<http://example.org/analysis/description/11> a lomo:LegalRule ;
    rdfs:label "Article 22 – Insolvency proceedings"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/941/cod/doc/com/COM_2025_941/FINAL/eng/art_22> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data>,
        <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> ;
    lomo:involvesProcess <http://example.org/process/notify> ;
    lomo:produces <http://example.org/analysis/description/11/action> ;
    lomo:references <http://example.org/dataset/data-regarding-insolvency-proceedings> ;
    dcterms:description "The competent authority shall immediately notify via the central database about insolvency proceedings ESMA, the ECB/ESCB, EBA, the European Systemic Risk Board and other Member States in writing."@en .

<http://example.org/analysis/description/3> a lomo:LegalRule ;
    rdfs:label "Article 6 – Notifications of systems"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/941/cod/doc/com/COM_2025_941/FINAL/eng/art_6> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data>,
        <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> ;
    lomo:involvesProcess <http://example.org/process/notify> ;
    lomo:produces <http://example.org/analysis/description/3/action> ;
    dcterms:description "A competent authority shall notify ESMA where it has designated a system through the central database. The competent authority shall notify ESMA and any other concerned authorities through the central database of changes in relation to the designation of the system."@en .

<http://example.org/analysis/description/4> a lomo:LegalRule ;
    rdfs:label "Article 8 – Duties of a system operator of a designated system"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/941/cod/doc/com/COM_2025_941/FINAL/eng/art_8> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data>,
        <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> ;
    lomo:involvesProcess <http://example.org/process/notify> ;
    lomo:produces <http://example.org/analysis/description/4/action> ;
    dcterms:description "The system operator shall notify the competent authority, via the central database of relevant changes to the information provided in the application."@en .

<http://example.org/analysis/description/5> a lomo:LegalRule ;
    rdfs:label "Article 9 – withdrawal of designation"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/941/cod/doc/com/COM_2025_941/FINAL/eng/art_9> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data>,
        <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> ;
    lomo:involvesProcess <http://example.org/process/notify> ;
    lomo:produces <http://example.org/analysis/description/5/action> ;
    lomo:references <http://example.org/dataset/data-relevant-for-withdrawal-of-designation> ;
    dcterms:description "Where a competent authority takes a decision to withdraw the designation of a system, the decision shall take effect throughout the Union and the competent authority shall inform the system operator, the national competent authority, ESMA, EBA and the ESCB via the central database."@en .

<http://example.org/analysis/description/6> a lomo:LegalRule ;
    rdfs:label "Article 10 – competent authority"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/941/cod/doc/com/COM_2025_941/FINAL/eng/art_10> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data>,
        <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> ;
    lomo:involvesProcess <http://example.org/process/notify> ;
    lomo:produces <http://example.org/analysis/description/6/action> ;
    dcterms:description "Member States shall notify, via the central database, the competent authorities and the registration authorities to ESMA."@en .

<http://example.org/analysis/description/7> a lomo:LegalRule ;
    rdfs:label "Article 11 – Exchange of information"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/941/cod/doc/com/COM_2025_941/FINAL/eng/art_11> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data>,
        <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions>,
        <http://data.europa.eu/leg/digital-dimensions/ProcessAutomation> ;
    lomo:involvesProcess <http://example.org/process/notify> ;
    lomo:produces <http://example.org/analysis/description/7/action> ;
    dcterms:description "Designating authorities, registering authorities, national competent authorities, competent authorities referred to in Article 22(2), ESMA, EBA or the ESCB, shall share whatever information that is requested for carrying out their respective duties under this Regulation without undue delay"@en .

<http://example.org/analysis/description/9> a lomo:LegalRule ;
    rdfs:label "Article 15 – Notification of registered systems"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/941/cod/doc/com/COM_2025_941/FINAL/eng/art_15> ;
    lomo:hasCategory <http://data.europa.eu/leg/digital-dimensions/Data>,
        <http://data.europa.eu/leg/digital-dimensions/DigitalSolutions> ;
    lomo:involvesProcess <http://example.org/process/notify> ;
    lomo:produces <http://example.org/analysis/description/9/action> ;
    dcterms:description "After taking a decision on registration of a system, each registering authority shall notify the applicant third-country system operator, ESMA, EBA, the ESCB and the other registering authorities, as applicable of its decision."@en .

<http://example.org/analysis/solution/1> a dctype:Software ;
    rdfs:label "Central database"@en ;
    lomo:establishedIn <https://data.europa.eu/eli/dl/proc/2025/941/cod/doc/com/COM_2025_941/FINAL/eng/art_26> ;
    lomo:hasCapability "Simultaneous information sharing amongst authorities involved in the designation and registration process" ;
    dcterms:publisher <http://example.org/agent/esma> ;
    dcterms:title "Central database"@en .

<http://example.org/agent/competent-authority-member-state-esma-ecbescb-eba-european-systemic-risk-board-other-member-states> rdfs:label "Competent authority (Member State), ESMA, ECB/ESCB, EBA, European Systemic Risk board, other Member States"@en .

<http://example.org/agent/competent-authority-member-state-system-operator-esma-national-competent-authority-eba-escb> rdfs:label "Competent authority (Member State), system operator, ESMA, national competent authority, EBA, ESCB"@en .

<http://example.org/agent/designating-authorities-registering-authorities-national-competent-authorities-competent-authorities-referred-to-in-article-222-esma-eba-or-the-escb> rdfs:label "Designating authorities, registering authorities, national competent authorities, competent authorities referred to in Article 22(2), ESMA, EBA or the ESCB"@en .

<http://example.org/agent/ecbescb-eba-the-european-systemic-risk-board-and-other-member-states> rdfs:label "ECB/ESCB, EBA, the European Systemic Risk Board and other Member States"@en .

<http://example.org/agent/esma-relevant-authorities-member-state-level-eba-escb> rdfs:label "ESMA, relevant authorities (Member State level), EBA, ESCB"@en .

<http://example.org/agent/general-public> rdfs:label "General public"@en .

<http://example.org/agent/system-operators> rdfs:label "System operators"@en .

<http://example.org/agent/third-country-system-operator-esma-eba-competent-authority-member-state> rdfs:label "Third-country system operator, ESMA, EBA, competent authority (Member State)"@en .

<http://example.org/agent/third-country-system-operators> rdfs:label "Third-country system operators"@en .

