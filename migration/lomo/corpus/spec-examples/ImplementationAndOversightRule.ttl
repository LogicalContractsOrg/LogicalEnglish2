ex:Rule_Dir2013_34_Art32_PublicOversight a lomo:ImplementationAndOversightRule ;
    rdfs:label "Directive 2013/34/EU Article 32: Public oversight of statutory auditors"@en ;
    lomo:hasDeonticModality <http://data.europa.eu/leg/deontic-modality/Obligation> ;
    lomo:legalText "Member States shall provide for effective systems of public oversight for statutory auditors and audit entities."@en ;
    lomo:produces ex:Action_EstablishPublicOversightSystem ;
    lomo:establishedIn <http://data.europa.eu/eli/dir/2013/34/oj/art_32> .