<?xml version="1.0" encoding="utf-8"?><root product-version="12.2.7.797"><entities><entity ref="global"><attribute name="b1" type="boolean"><text lang="en-US"><base>the claim is covered</base><parse>s(ver('12.2.7.797'),v(cover,t(simple,present,normal)),ob('the claim',singular),o(''))</parse></text></attribute><attribute name="b2" type="boolean"><text lang="en-US"><base>the claim was lodged in time</base><parse>s(ver('12.2.7.797'),v(lodge,t(simple,past,normal)),ob('the claim',singular),o('in time'))</parse></text></attribute><attribute name="b3" type="boolean"><text lang="en-US"><base>the product is faulty</base><parse>s(ver('12.2.7.797'),v(be,t(simple,present,normal)),sb('the product',singular),o('faulty'))</parse></text></attribute><attribute name="b4" type="boolean"><text lang="en-US"><base>the customer misused the product</base><parse>s(ver('12.2.7.797'),v(misuse,t(simple,past,normal)),sb('the customer',singular),o('the product'))</parse></text></attribute><attribute name="c1" type="currency"><text lang="en-US"><base>the price</base></text></attribute><attribute name="c2" type="currency"><text lang="en-US"><base>the fee</base></text></attribute></entity></entities><relationships /><rules><rule id="0" name="The claim is covered" folder="0" source-offset="1"><rule-xml><conclude attr-id="b1" entity-id="global" scope-id="global0" source-offset="1"><value><true-value source-offset="1" /></value><condition><or><attribute attr-id="b2" source-offset="2" /><and><attribute attr-id="b3" source-offset="3" /><not><attribute attr-id="b4" source-offset="4" /></not></and></or></condition><otherwise><false-value source-offset="1" /></otherwise></conclude></rule-xml></rule><rule id="1" name="The fee" folder="0" source-offset="6"><rule-xml><conclude attr-id="c2" entity-id="global" scope-id="global0" source-offset="6"><value><multiply><attribute attr-id="c1" /><number-value>0.07</number-value></multiply></value><condition><attribute attr-id="b1" source-offset="7" /></condition><otherwise><number-value>0</number-value></otherwise></conclude></rule-xml></rule></rules><source kind="MSWord"><p para="1" s="OPM - conclusion" t="The claim is covered if" /><p para="2" s="OPM - level 1" t="the claim was lodged in time or" /><p para="3" s="OPM - level 1" t="both" /><p para="4" s="OPM - level 2" t="the product is faulty and" /><p para="5" s="OPM - level 2" t="the customer did not misuse the product" /><p para="6" s="OPM - conclusion" t="the fee = the price * 0.07 if" /><p para="7" s="OPM - level 1" t="the claim is covered" /></source></root>
